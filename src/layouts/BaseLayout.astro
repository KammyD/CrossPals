---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, PHONE, EMAIL, COMPANY } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 单语言站点，值恒为 'en'；保留该 prop 是为了不动各页面的调用点 */
  lang?: 'en';
  /** 文章页传入后输出 Article 结构化数据 */
  article?: { published: string; section?: string };
}
const DEFAULT_DESC = 'CrossPals — Trusted China sourcing for global entrepreneurs. Product finding, quality inspection, purchasing, and shipping.';
const {
  title,
  description = DEFAULT_DESC,
  lang = 'en',
  article,
} = Astro.props;
const SITE = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, SITE);
const ogImage   = new URL('/og-image.png', SITE);

const ORG = {
  '@type': 'Organization',
  name: 'CrossPals',
  legalName: COMPANY.nameEn,
  url: SITE.href.replace(/\/$/, '/'),
  logo: new URL('/img/logo-stacked.png', SITE).href,
  email: EMAIL.en,
  telephone: PHONE.tel,
  address: {
    '@type': 'PostalAddress',
    addressLocality: COMPANY.addressParts.locality,
    addressRegion: COMPANY.addressParts.region,
    addressCountry: COMPANY.addressParts.country,
  },
  description: 'China sourcing partner for global entrepreneurs: product finding, supplier verification, quality inspection, purchasing, and door-to-door shipping.',
  areaServed: ['Africa', 'Latin America', 'Southeast Asia', 'Middle East'],
};
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      datePublished: article.published,
      dateModified: article.published,
      articleSection: article.section,
      inLanguage: 'en',
      image: [ogImage.href],
      mainEntityOfPage: canonical.href,
      publisher: ORG,
    }
  : Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [ORG, { '@type': 'WebSite', name: 'CrossPals', url: SITE.href, inLanguage: 'en' }],
      }
    : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CrossPals</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title"       content={`${title} | CrossPals`} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content={article ? 'article' : 'website'} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:site_name"   content="CrossPals" />
    <meta property="og:locale"      content="en_US" />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card"        content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d2418" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#main" class="skiplink">Skip to content</a>
    <Header />
    <main id="main">{/* @ts-ignore */}<slot /></main>
    <Footer />

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
