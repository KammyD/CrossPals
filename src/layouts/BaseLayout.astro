---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, PHONE, EMAIL, COMPANY } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  /** 文章页传入后输出 Article 结构化数据 */
  article?: { published: string; section?: string };
}
const DEFAULT_DESC = {
  en: 'CrossPals — Trusted China sourcing for global entrepreneurs. Product finding, quality inspection, purchasing, and shipping.',
  es: 'CrossPals — abastecimiento en China de confianza para emprendedores. Búsqueda de productos, inspección de calidad, compra y envío.',
};
const {
  title,
  description = DEFAULT_DESC[lang],
  lang = 'en',
  article,
} = Astro.props;
const isEs = lang === 'es';
const SITE = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, SITE);
const ogImage   = new URL('/og-image.png', SITE);

// 双语页面集合：只有这些路径有对应的另一种语言版本，才输出 hreflang
const bilingual = ['/', '/services/', '/about/', '/contact/', '/blog/', '/privacy/', '/terms/', '/case-studies/'];
const pathNoLang = lang === 'es' ? (Astro.url.pathname.replace(/^\/es/, '') || '/') : Astro.url.pathname;
// 详情页是动态路由（/case-studies/<slug>/ 与 /es/case-studies/<slug>/、/blog/<slug>/ 与 /es/blog/<slug>/ 成对存在），单独判定
const isCaseDetail = /^\/case-studies\/[^/]+\/$/.test(pathNoLang);
const isBlogDetail = /^\/blog\/[^/]+\/$/.test(pathNoLang);
const hasTwin = bilingual.includes(pathNoLang) || isCaseDetail || isBlogDetail;
const enUrl = hasTwin ? new URL(pathNoLang, SITE) : null;
const esUrl = hasTwin ? new URL('/es' + (pathNoLang === '/' ? '/' : pathNoLang), SITE) : null;

const ORG = {
  '@type': 'Organization',
  name: 'CrossPals',
  legalName: COMPANY.nameEn,
  url: SITE.href.replace(/\/$/, '/'),
  logo: new URL('/img/logo-stacked.png', SITE).href,
  email: EMAIL.en,
  telephone: PHONE.tel,
  address: {
    '@type': 'PostalAddress',
    addressLocality: COMPANY.addressParts.locality,
    addressRegion: COMPANY.addressParts.region,
    addressCountry: COMPANY.addressParts.country,
  },
  description: isEs
    ? 'Socio de abastecimiento en China para emprendedores: búsqueda de productos, verificación de proveedores, inspección de calidad, compra y envío puerta a puerta.'
    : 'China sourcing partner for global entrepreneurs: product finding, supplier verification, quality inspection, purchasing, and door-to-door shipping.',
  areaServed: isEs
    ? ['África', 'América Latina', 'Sudeste Asiático', 'Oriente Medio']
    : ['Africa', 'Latin America', 'Southeast Asia', 'Middle East'],
};
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      datePublished: article.published,
      dateModified: article.published,
      articleSection: article.section,
      inLanguage: lang,
      image: [ogImage.href],
      mainEntityOfPage: canonical.href,
      publisher: ORG,
    }
  : Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [ORG, { '@type': 'WebSite', name: 'CrossPals', url: SITE.href, inLanguage: ['en', 'es'] }],
      }
    : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CrossPals</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta property="og:title"       content={`${title} | CrossPals`} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content={article ? 'article' : 'website'} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:site_name"   content="CrossPals" />
    <meta property="og:locale"      content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card"        content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d2418" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#main" class="skiplink">{isEs ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header />
    <main id="main">{/* @ts-ignore */}<slot /></main>
    <Footer />

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
