---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';

/* ── 真实指标（小而真，比大而假有说服力） ── */
const stats = [
  { n: '40+',   label: 'Orders completed' },
  { n: '12',    label: 'Countries served' },
  { n: '3 yrs', label: 'Sourcing experience' },
  { n: '100%',  label: 'Inspected before shipping' },
];

const values: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'trust',        n: '01', title: 'Trust First',          body: 'We only recommend suppliers we have personally vetted. Your money is safe because we treat every order as our own.' },
  { icon: 'transparent',  n: '02', title: 'Radical Transparency', body: 'Supplier price, freight cost, our fee — you see every number before committing. No hidden markups, ever.' },
  { icon: 'endtoend',     n: '03', title: 'End-to-End Ownership', body: 'From first inquiry to delivery confirmation, one dedicated agent handles your entire order. We do not hand you off.' },
  { icon: 'inspection',   n: '04', title: 'Inspect, Always',      body: 'Every order is physically inspected and photographed before it ships — because "trust the factory" is not a quality-control plan.' },
];

const galImg: Record<number,string> = {401:'g-market',402:'g-production',403:'g-packing',404:'g-unboxing'};

const gallery = [
  { seed: 401, hint: '保定/河北产业带市场现场' },
  { seed: 402, hint: '工厂生产线/质检现场' },
  { seed: 403, hint: '装箱打包/货物出发' },
  { seed: 404, hint: '客户收货开箱/产品使用场景' },
];

const founderPortrait = '/img/team-xizeng.webp';
---
<BaseLayout title="About Us" description="CrossPals is run by Xizeng, a university teacher in Baoding, Hebei — sourcing, inspecting, and prepping products for Amazon FBA sellers in 12 countries.">

  <PageHero overline="Our Story" title="A Teacher, a Factory Town,<br /><em style='font-style:italic;color:var(--avo-300)'>and 40 Orders</em>" subtitle="One person accountable for your order — not a call centre." />

  <!-- ═══ Founder story — 全页核心 ═══ -->
  <section class="section">
    <div class="container founder">
      <div class="founder__media reveal">
        <ImgPlaceholder src={founderPortrait} seed={301} width={520} height={640} ratio="4/5" alt="Xizeng, founder of CrossPals, in Baoding, Hebei" />
        <p class="founder__cap">Xizeng · Founder · Baoding, Hebei</p>
      </div>

      <div class="founder__text reveal reveal-delay-1">
        <p class="overline">Who you're dealing with</p>
        <h2>I'm Xizeng. This started<br/><em>in a classroom.</em></h2>
        <div class="divider" style="margin:var(--s4) 0;"></div>

        <p>I run CrossPals from <strong>Baoding, Hebei</strong> — a city built around manufacturing. I'm a university teacher, and this business began as a lesson plan.</p>
        <p>Baoding sits in the middle of some of China's densest industrial belts: hardware, textiles, kitchenware, packaging. I started taking students into the factories as part of their practical training — how a product is actually made, priced, and packed for export. The question I kept hearing from overseas buyers was simpler than any textbook: <em>"Is this supplier real, and will the goods actually show up?"</em></p>
        <p>So I started answering it — first for a handful of sellers, now for importers across a dozen countries. Over three years we've completed more than 40 orders: sourcing, inspecting, and prepping goods for Amazon FBA.</p>
        <p>I still teach. CrossPals is what the teaching turned into — the same care I'd want if I were the one wiring money to a factory I'd never seen.</p>

        <p class="founder__sig">You deal with me — not a ticket queue.</p>

        <div class="mission-card">
          <div class="mission-card__icon"><Icon name="compass" size={24} color="var(--seal)" /></div>
          <div>
            <strong>Our mission</strong>
            <p>Make buying from China safe, inspected, and honest for every seller — whether it's their first order or their fiftieth.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 真实指标 ═══ -->
  <section class="section--tight bg-parchment">
    <div class="container">
      <p class="overline reveal" style="margin-bottom:var(--s5);">By the numbers — small, and true</p>
      <div class="statsrow reveal">
        {stats.map(s => (
          <div class="statsrow__item">
            <strong>{s.n}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Trustpilot ═══ -->
  <!-- NOTE: 注册 Trustpilot 后，把下面的 href 换成真实档案链接（例如
       https://www.trustpilot.com/review/crosspals.com），并把 rating 换成真实分数。 -->
  <section class="section tp-sec">
    <div class="container tp">
      <div class="tp__badge reveal">
        <span class="tp__name">Trustpilot</span>
        <span class="tp__stars" aria-hidden="true">★★★★★</span>
        <span class="tp__sub">Reviews from real customers</span>
      </div>
      <div class="tp__body reveal reveal-delay-1">
        <h3>Reviews we can't fake</h3>
        <p>We're building our Trustpilot profile in the open. If we've completed an order for you, a short review helps the next seller decide whom to trust. Every review is public — good or bad.</p>
        <div class="tp__actions">
          <a href="https://www.trustpilot.com/review/crosspals.com" target="_blank" rel="noopener" class="btn btn-primary">
            Read our reviews on Trustpilot
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href="/contact" class="btn btn-outline">Work with us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Values ═══ -->
  <section class="section bg-parchment">
    <div class="container">
      <div class="section-hd reveal" style="max-width:560px;margin:0 auto var(--head-gap);text-align:center;">
        <p class="overline">What We Stand For</p>
        <h2>Four Values,<br/><em>One Standard</em></h2>
      </div>
      <ol class="vals">
        {values.map((v, i) => (
          <li class:list={['val-row reveal', `reveal-delay-${i}`]}>
            <span class="indexnum val-row__n">{v.n}</span>
            <div class="val-row__body">
              <h4>{v.title}</h4>
              <p>{v.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ Gallery ═══ -->
  <section class="section">
    <div class="container">
      <div class="section-hd reveal" style="margin-bottom:var(--s6);">
        <p class="overline">On the Ground</p>
        <h2 style="font-size:clamp(24px,3vw,36px);">From the Factory Floor<br/><em>to Your Door</em></h2>
      </div>
      <div class="gallery-strip">
        {gallery.map((g, i) => (
          <div class:list={['gallery-item reveal', `reveal-delay-${i}`]}>
            <ImgPlaceholder src={'/img/'+galImg[g.seed]+'.webp'} seed={g.seed} width={400} height={533} ratio="3/4" alt="CrossPals in action" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <p class="overline overline--light reveal">Work With Us</p>
      <h2 style="color:#fff;margin-bottom:var(--s4);" class="reveal reveal-delay-1">
        Let's Get Your<br/><em style="color:var(--avo-300)">First Order Right</em>
      </h2>
      <p style="color:rgba(255,255,255,.6);max-width:460px;margin:0 auto var(--s6);" class="reveal reveal-delay-2">
        Send your first inquiry — no commitment. I'll show you exactly what sourcing from China looks like for your product.
      </p>
      <a href="/contact" class="btn btn-primary reveal reveal-delay-3">
        Get a free quote
        <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  h2 em{font-style:italic;color:var(--avo-600);}

  /* ── Founder ── */
  .founder{display:grid;grid-template-columns:0.72fr 1.28fr;gap:var(--s7);align-items:start;}
  .founder__media{position:sticky;top:100px;}
  .founder__media :global(.img-ph){border:1px solid var(--border-light);}
  .founder__cap{margin-top:var(--s3);font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);}
  .founder__text h2{margin-bottom:var(--s4);}
  .founder__text p{font-size:16px;line-height:1.75;margin-bottom:var(--s4);}
  .founder__sig{font-family:var(--font-serif);font-style:italic;font-size:19px;color:var(--avo-700);border-left:2px solid var(--seal);padding-left:var(--s4);}
  .mission-card{display:flex;gap:var(--s4);background:var(--avo-50);border:1px solid var(--avo-200);border-left:2px solid var(--seal);padding:var(--s4) var(--s5);margin-top:var(--s6);}
  .mission-card__icon{flex-shrink:0;}
  .mission-card strong{display:block;font-family:var(--font-serif);font-size:16px;color:var(--avo-800);margin-bottom:6px;}
  .mission-card p{font-size:14px;margin:0;}

  /* ── Stats ── */
  .statsrow{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--s5);border-top:2px solid var(--seal);padding-top:var(--s5);}
  .statsrow__item strong{display:block;font-family:var(--font-serif);font-size:clamp(30px,3.6vw,44px);font-weight:600;color:var(--avo-600);line-height:1;margin-bottom:8px;}
  .statsrow__item span{font-family:var(--font-mono);font-size:12px;letter-spacing:.03em;color:var(--text-muted);}

  /* ── Trustpilot ── */
  .tp-sec{background:var(--bg-page);}
  .tp{display:grid;grid-template-columns:0.6fr 1.4fr;gap:var(--s7);align-items:center;border:1px solid var(--border-light);background:var(--bg-surface);padding:var(--s6);}
  .tp__badge{display:flex;flex-direction:column;gap:6px;border-right:1px solid var(--border-light);padding-right:var(--s6);}
  .tp__name{font-family:var(--font-serif);font-size:26px;font-weight:600;color:var(--avo-900);}
  .tp__stars{color:#00b67a;font-size:22px;letter-spacing:3px;}
  .tp__sub{font-family:var(--font-mono);font-size:11px;letter-spacing:.04em;color:var(--text-faint);}
  .tp__body h3{font-size:clamp(19px,2.2vw,24px);margin-bottom:var(--s3);}
  .tp__body p{font-size:15px;line-height:1.7;color:var(--text-body);max-width:560px;margin-bottom:var(--s5);}
  .tp__actions{display:flex;gap:var(--s3);flex-wrap:wrap;}

  .section-hd h2 em{font-style:italic;color:var(--avo-600);}
  .vals{list-style:none;display:flex;flex-direction:column;max-width:820px;margin:0 auto;text-align:left;}
  .val-row{display:grid;grid-template-columns:72px 1fr;gap:var(--s5);padding:var(--s5) 0;border-top:1px solid var(--border-light);align-items:start;}
  .val-row:last-child{border-bottom:1px solid var(--border-light);}
  .val-row__n{font-size:40px;}
  .val-row__body h4{font-size:clamp(19px,2.2vw,25px);margin-bottom:var(--s2);}
  .val-row__body p{font-size:15px;max-width:640px;}

  .gallery-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--s4);}
  .gallery-item{overflow:hidden;}
  .gallery-item :global(img){transition:transform .5s var(--ease-out);}
  .gallery-item:hover :global(img){transform:scale(1.06);}

  @media(max-width:960px){
    .founder{grid-template-columns:1fr;gap:var(--s6);}
    .founder__media{position:static;max-width:380px;}
    .statsrow{grid-template-columns:repeat(2,1fr);gap:var(--s5);}
    .tp{grid-template-columns:1fr;gap:var(--s5);padding:var(--s5);}
    .tp__badge{border-right:none;border-bottom:1px solid var(--border-light);padding-right:0;padding-bottom:var(--s5);}
    .gallery-strip{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:540px){
    .val-row{grid-template-columns:52px 1fr;gap:var(--s4);}
    .statsrow{grid-template-columns:1fr 1fr;}
    .gallery-strip{grid-template-columns:1fr;}
    /* Trustpilot 块在窄屏收边距 + 按钮换行，避免长按钮把容器撑出视口 */
    .tp{padding:var(--s4);}
    .tp__badge{padding-bottom:var(--s4);}
    .tp__actions{flex-direction:column;align-items:stretch;}
    .tp__actions .btn{width:100%;justify-content:center;white-space:normal;box-sizing:border-box;}
  }
</style>
