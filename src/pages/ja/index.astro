---
/**
 * 日本語トップページ（/ja/）。
 * 语言清单来自 site.config.json → site.locales；本页对应「非默认语言」的落点。
 * 体系：共享组件/数据(data-driven) + 各静态页 /ja/ 镜像 + 博客译文。
 * 内部链接统一走 localePath(PAGE_LANG, ...) → /ja/...，绝不指向会 404 的英文页。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { PHONE } from '../../config/site';
import { getCollection } from 'astro:content';
import { localePath, languageList, defaultLang } from '../../i18n/utils';

const PAGE_LANG = 'ja';

/* ── 服务（每项带一条独立定价说明） ── */
const services: Array<{ icon: IconName; n: string; title: string; body: string; price: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',    n: '01', title: '製品探索（ソーシング）',     body: '中国の数千のサプライヤー——1688、Alibaba、そして工場直結のネットワーク——から、ご予算と品質基準にぴったり合う製品を探し出します。', price: '<b>$1,000</b> のご注文 → 調達手数料 <b>$80</b>（8%）。単価を引き下げ、隠れたマージンは一切加算しません。', seed: 10, hint: '义乌商品城/供应商展会场景', delay: 0 },
  { icon: 'inspection',  n: '02', title: '品質検品',   body: '出荷前に工場で実地検品を実施。詳細な写真レポート、不良品数、明確な合否判定で、不安な出荷はさせません。', price: '<b>$1,000</b> のご注文 → 商品検査費用定額 <b>$150</b>（半日）。写真レポート一式を含みます。', seed: 20, hint: '质检员工作照/工厂内部', delay: 1, featured: true },
  { icon: 'payment',     n: '03', title: '購入・代金支払い', body: '中国語で交渉し、確認済みサプライヤーへのすべての支払いを代行。各段階で資金を保護し、見知らぬ相手への送金は一切ありません。', price: '<b>$1,000</b> のご注文 → 前金30%／検査後70%。手数料 <b>5–8%</b>、追加費用一切なし。', seed: 30, hint: '签约/握手/合同场景', delay: 2 },
  { icon: 'shipping',    n: '04', title: '国際配送・物流', body: '世界中へドア・ツー・ドア。航空・海上・エクスプレスを比較し、通関書類を代行し、リアルタイムの追跡情報をお届けします。', price: '<b>$1,000</b> のご注文 → 運賃は運送会社の実際の見積もり通り。追加費用 <b>$0</b>。', seed: 40, hint: '集装箱港口/货运飞机', delay: 3 },
];

/* ── 三个真实 FBA 卖家场景（Facebook 群组每天都在发的帖） ── */
const scenarios: Array<{ quote: string; tag: string; title: string; body: string; cta: string }> = [
  { quote: '500個注文して、30%が不良品だった。', tag: '出荷前に検品', title: '品質検品',
    body: '工場でロット全体を検査——計測・テスト・カメラでの不良カウント。合格率が基準に満たない場合、1箱も中国を出る前にサプライヤーが手直しまたは交換します。',
    cta: '検品の仕組みを見る' },
  { quote: '代金を払ったらサプライヤーが消えた。', tag: '支払い前に確認', title: 'サプライヤー確認',
    body: '確認していないサプライヤーには送金しません。営業許可証、工場住所、輸出実績、そしてライブ動画の現地案内——前金を払う前に、すべてを確認します。',
    cta: 'サプライヤー審査の方法を見る' },
  { quote: '自分の商品がFBAの要件を満たしているか不安な場合。', tag: '出荷前のFBA対応', title: 'FBA向け事前処理',
    body: 'Amazonの規格に準拠したラベリング、ポリ袋包装、セット梱包、重量・寸法測定——初回検査合格に向けた送り状ラベルと梱包明細書を提供します。',
    cta: 'FBA事前処理の詳細を見る' },
];

/* ── 独立质检模块：5 项质检标准 ── */
const inspectionStandards: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: '外観',      body: '承認見本と照らし合わせ、表面・色・印刷・仕上げを確認します。' },
  { n: '02', title: '寸法',      body: 'ノギスとはかりで長さ・幅・重量・許容差を測定します。' },
  { n: '03', title: '機能テスト',   body: '抽出したすべての単位を、お客様が使う通りに電源投入・組立・使用します。' },
  { n: '04', title: '梱包',      body: '小売箱、中敷き、ポリ袋の完全性——さらに輸送落下への耐性を確認します。' },
  { n: '05', title: 'FBAラベル確認', body: 'FNSKU、外装箱ラベル、窒息警告表示、Amazonバーコードの読み取り可否を検査します。' },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Day 1',    title: '製品をご提出',      body: '簡単なフォームから、製品・数量・品質基準・ご予算をお知らせください。' },
  { day: 'Day 2',    title: '審査済みサプライヤー案',  body: '価格とプロフィール付きの確認済みサプライヤーを3〜5社、48時間以内にご送付します。' },
  { day: 'Day 7–20', title: '当社で購入・検品',         body: '当社がサプライヤーへの支払いと生産管理を担当し、出荷前の完全な品質検査写真レポートをご提供します。' },
  { day: 'Day 21+',  title: 'FBA対応・配送完了',     body: 'Amazon規格に沿ったラベル貼り・梱包済み商品が通関手続きを経て、追跡可能な状態で配送されます。' },
];

/* ── 证言：FBA 卖家格式（品类 / 订单 / 问题 / 结果） ── */
const testiFeatured = {
  quote: '米国Amazonでキッチン用品を販売中。CrossPalsが主力商品の調達を担当し、出荷前に不良品15点を発見。全ての商品を18日間でFBA対応に仕上げました。以降2回のリピート注文実績あり。',
  name: 'マーカス T.', meta: 'Amazon出品者 · アメリカ · キッチン・ダイニング',
  result: '出荷前に不良品15個を発見 · 18日でFBA対応完了', avatar: '/img/avatar-nigeria.webp',
};
const testiSmall = [
  { quote: '初めてのプライベートブランド注文（ペット用品800点）。工場チェック実施、包装問題を発見し、一度もリジェクトされずFBA納品を達成。',
    name: 'アナ R.', meta: 'Amazon FBA · スペイン · ペット用品', result: 'FBAリジェクトゼロ件', avatar: '/img/avatar-mexico.webp' },
  { quote: '前サプライヤーは前金支払い後消息不明に。CrossPalsが新サプライヤーを審査し自社QCを実施したため、見知らぬ業者への送金リスクが解消。',
    name: 'デイビッド O.', meta: 'Amazon & Shopify · イギリス · ホーム&ガーデン', result: 'リピート注文 2回', avatar: '/img/avatar-uk.webp' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: '言語の壁なし',  body: '中国語で直接交渉するため、観光客価格ではなく工場価格をご提供します。' },
  { icon: 'trust',        n: '02', title: '明確な責任所在',   body: '専任エージェントがご注文を管理。対応はチケット待ちではなく、一人の担当者が責任を持ちます。' },
  { icon: 'handshake',    n: '03', title: 'FBA出品者向け設計', body: '当社の全プロセスはAmazon対応梱包に集約。調達・検品・ラベリング・梱包まで一貫対応。' },
  { icon: 'transparent',  n: '04', title: '透明な費用',     body: 'サプライヤー価格＋運賃＋当社手数料。ご契約前にすべての数字が見えます。' },
];

/* 首页只给承诺（结果），不说过程；过程全部放到 Services 页的展开模块 */
const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: '確認済みサプライヤーのみ', body: '1セント払う前に、すべてのサプライヤーを審査します。' },
  { icon: 'inspection', title: '出荷前検品',      body: '資金が動く前に、写真レポートと合否判定をお渡しします。' },
  { icon: 'payment',    title: '支払い保護',      body: '節目の確認ができるまで資金を保留。見知らぬ相手への送金はありません。' },
  { icon: 'shipping',   title: 'DDPドア配送',       body: '書類ではなく、追跡情報と商品をお届けします。' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'エージェント手数料',     value: '注文額の5〜8%', note: '注文額$10,000 ＝ 手数料$600' },
  { label: '検品',    value: '1日$150',          note: '多くの注文は半日で完了' },
  { label: 'FBA事前処理',      value: '単位あたり',            note: '見積もりに項目ごと明記' },
  { label: '運賃',       value: 'キャリア見積もり通り',          note: 'キャリア価格への上乗せなし' },
];

/* Resources：自动取最新 3 篇日语文章（带 lang: ja 的译文） */
const jaPostsRaw = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.data.lang === PAGE_LANG)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const jaPosts = jaPostsRaw.map(p => {
  const slug = p.data.translationKey || p.slug.replace(new RegExp(`-${PAGE_LANG}$`), '');
  return { slug, cat: p.data.category, title: p.data.title, time: p.data.readTime, cover: p.data.cover };
});

const svcImg: Record<number,string> = {10:'sourcing-1688',20:'inspection',30:'payment',40:'shipping'};
const guarImg: Record<string,string> = {trust:'factory',inspection:'inspection',payment:'payment',shipping:'shipping'};
const tickerItems = ['FBA前処理', '出荷前QC', '1688ソーシング', 'サプライヤー確認', 'DDP配送', 'プライベートラベル', '製品撮影', 'Amazon FBA', '河北・保定 → 世界', 'QC写真レポート', '隠れた手数料なし'];
const categories = ['キッチン・ダイニング', 'ホーム・ガーデン', 'ペット用品', 'おもちゃ・ゲーム', 'スポーツ・アウトドア', 'ビューティー・パーソナルケア', '電子アクセサリー', 'オフィス用品'];
---
<BaseLayout
  lang={PAGE_LANG}
  title="Amazon出品者が信頼する調達パートナー"
  description="CrossPalsがFBA向けに製品の探索・検品・事前処理を実施——サプライヤー選定、出荷前品質検査、FBA事前処理を行い、販売に集中できる環境を提供。"
>

<!-- ═══ 顶部深色带：公告条 + 刊头信息行 ═══ -->
<div class="topband">
  <a href={localePath(PAGE_LANG, '/contact')} class="announce announce--dark">
    <span class="announce__dot" aria-hidden="true"></span>
    <span><strong>新着：</strong>初めての輸入者のための無料ソーシング相談——48時間でサプライヤー候補を提示</span>
    <span class="announce__arrow" aria-hidden="true">→</span>
  </a>

  <div class="masthead">
    <div class="container masthead__inner">
      <span>CrossPals · 中国調達マニュアル</span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span>第01号 — MMXXVI</span>
    </div>
  </div>
</div>

<!-- ═══ HERO — 面向 Amazon 卖家 ═══ -->
<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">FBA出品者のための中国調達</p>
        <h1 class="hero__title">Amazon出品者が信頼する調達パートナー——<em>品質検品付き。</em></h1>
        <p class="hero__lead">FBA向けの製品調達・検品・前処理を代行するため、サプライヤー管理ではなく販売活動に集中できます。</p>

        <p class="hero__sidenote">図00 — 多くのFBA出品者は言語の壁・偽物サプライヤー・不可視な出荷状況によって損失を被っています。当社はこの3課題を全て解決します。</p>

        <div class="hero__actions">
          <a href={localePath(PAGE_LANG, '/contact')} class="btn btn-primary">
            無料見積もりを取得
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href={localePath(PAGE_LANG, '/services')} class="btn btn-ghost">仕組みを見る</a>
        </div>

        <ul class="hero__index">
          <li><span>01</span> 探索</li>
          <li><span>02</span> 検品</li>
          <li><span>03</span>FBA前処理</li>
          <li><span>04</span> 配送</li>
        </ul>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__photo-fill">
        <ImgPlaceholder src="/img/hero-warehouse.webp" seed={42} width={900} height={1100} ratio="9/11" priority
          alt="中国工場倉庫 — CrossPals調達" />
      </div>
      <div class="hero__cap">
        <span class="hero__cap-label">Fig. 01</span>
        <span class="hero__cap-text">中国・河北 保定</span>
        <span class="seal seal--sm" aria-hidden="true"><span>確認済</span><span>エージェント</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TICKER ═══ -->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[...tickerItems, ...tickerItems].map(t => <span class="ticker__item">{t}</span>)}
  </div>
</div>

<!-- ═══ 信任带：服务场景标识 + 数字指标（替代原来的国家旗帜列表） ═══ -->
<section class="trustbar" aria-label="取り扱い分野と対象のお客様">
  <div class="container">
    <p class="overline" style="margin-bottom:var(--s4);">Amazon・Shopify出品者向け 調達・検品・前処理サービスのカテゴリー：</p>
    <div class="regionwall reveal">
      {categories.map(c => <span>{c}</span>)}
    </div>
    <ul class="trustmetrics reveal reveal-delay-1">
      <li><b>47</b><span>対応可能なAmazon出品者</span></li>
      <li><b>$2.3M<em>+</em></b><span>調達商品総額</span></li>
      <li><b>98<em>%</em></b><span>期日内配送</span></li>
    </ul>
  </div>
</section>

<!-- ═══ SERVICES — 每项带独立定价说明 ═══ -->
<section class="section svc ledger">
  <div class="container svc__wrap">
    <aside class="svc__aside">
      <p class="overline">私たちの仕事</p>
      <h2 class="svc__h">一貫した<br/><em>中国調達</em></h2>
      <p class="svc__intro">4つの専門領域、責任を持つ一人のエージェント。各段階は、資金が動く前に文書化・写真記録・価格提示されます。</p>
      <a href={localePath(PAGE_LANG, '/services')} class="svc__all">全サービス一覧 →</a>
    </aside>

    <ol class="svc__list">
      {services.map(s => (
        <li class:list={['svc-row reveal', `reveal-delay-${s.delay}`]}>
          <div class="svc-row__num"><span class="indexnum">{s.n}</span></div>
          <div class="svc-row__thumb">
            <ImgPlaceholder src={'/img/'+svcImg[s.seed]+'.webp'} seed={s.seed} width={360} height={240} ratio="3/2" alt={s.title} />
          </div>
          <div class="svc-row__body">
            <div class="svc-row__top">
              <h3>{s.title}</h3>
            </div>
            <div class="lede-row">
              <p>{s.body}</p>
              <a href={localePath(PAGE_LANG, '/services')} class="svc-row__link">詳しく見る
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
            <div class="price-note">
              <span class="price-note__label">料金</span>
              <span class="price-note__calc" set:html={s.price} />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═══ HOW IT WORKS ═══ -->
<section class="section hiw grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="hiw__head reveal">
      <p class="overline overline--light">プロセス</p>
      <h2 class="text-white">サプライヤーから<br/><em style="color:var(--avo-300)">4ステップで完了するFBA対応</em></h2>
    </div>

    <div class="manifest reveal reveal-delay-1">
      {steps.map((step, i) => (
        <div class:list={['manifest__col', { 'manifest__col--end': i === steps.length - 1 }]}>
          <span class="manifest__day">{step.day}</span>
          <span class="manifest__n">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="manifest__title">{step.title}</h4>
          <p class="manifest__body">{step.body}</p>
        </div>
      ))}
      <div class="manifest__stamp" aria-hidden="true">
        <span class="seal"><span>Cross</span><span>Pals ✓</span></span>
      </div>
    </div>

    <div class="hiw__cta reveal reveal-delay-2">
      <a href={localePath(PAGE_LANG, '/contact')} class="btn btn-primary">無料見積もりを取得</a>
      <a href={localePath(PAGE_LANG, '/case-studies')} class="btn btn-ghost">事例を見る</a>
    </div>
  </div>
</section>

<!-- ═══ 三个真实 FBA 卖家场景（解决痛点） ═══ -->
<section class="section scen">
  <div class="container">
    <div class="scen__head reveal">
      <p class="overline">解決する課題</p>
      <h2>あらゆる<br/><em>Amazon出品者が投稿する3つのよくある質問</em></h2>
      <p class="scen__lead">これらはAmazon出品者グループで日々投稿される代表的なスレッドです。各質問に対する当社の回答をご紹介します。</p>
    </div>

    <div class="scen__list">
      {scenarios.map((s, i) => (
        <article class:list={['scen-item reveal', `reveal-delay-${i}`]}>
          <div class="scen-item__quote">
            <span class="scen-item__mark" aria-hidden="true">“</span>
            <p>{s.quote}</p>
            <span class="scen-item__src">— FBA出品者フォーラム投稿より</span>
          </div>
          <div class="scen-item__sol">
            <span class="tag tag-seal">{s.tag}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <a href={localePath(PAGE_LANG, '/services')} class="scen-item__link">{s.cta}
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 独立质检模块（差异化武器） ═══ -->
<section class="section inspect grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="inspect__head reveal">
      <p class="overline overline--light">品質検品</p>
      <h2 class="text-white">すべての注文に<br/><em>完全な検品レポートが付きます。</em></h2>
      <p class="inspect__lead">箱の写真ではありません。5つの基準に沿った構造化された項目別レポート——すべての注文、すべてのロットサイズで、出荷前にお送りします。</p>
    </div>

    <div class="inspect__grid">
      <ol class="inspect__std reveal">
        {inspectionStandards.map((s, i) => (
          <li class:list={['inspect-std', `reveal-delay-${i}`]}>
            <span class="inspect-std__n">{s.n}</span>
            <div>
              <h4>{s.title}</h4>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <!-- 样例质检报告（客户/供应商信息打码） -->
      <div class="qcreport reveal reveal-delay-2">
        <div class="qcreport__head">
          <span class="qcreport__brand">CrossPals · 出荷前検品サービス</span>
          <span class="qcreport__no">レポート№ CP-2026-0418</span>
        </div>
        <dl class="qcreport__grid">
          <div><dt>製品</dt><dd>ステンレス製キッチンツール</dd></div>
