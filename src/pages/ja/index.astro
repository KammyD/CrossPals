.hero__photo-fill :global(.img-ph){height:100%;}
.hero__photo-fill :global(.img-ph__wrap){padding-top:0!important;height:100%;}
.hero__photo-fill :global(img){width:100%;height:100%;object-fit:cover;}
.hero__cap{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:var(--s4);padding:var(--s4) var(--s5);background:linear-gradient(0deg,rgba(28,33,20,.9),transparent);}
.hero__cap-label{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--avo-300);}
.hero__cap-text{font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:rgba(255,255,255,.7);text-transform:uppercase;flex:1;}
.hero__cap .seal{transform:rotate(-8deg);background:rgba(28,33,20,.4);border-color:var(--seal);color:#fff;backdrop-filter:blur(2px);}

/* TRUSTBAR */
.trustbar{padding:var(--section-y-sm) var(--s5);background:var(--bg-page);border-bottom:1px solid var(--border-light);}
.trustmetrics{list-style:none;display:flex;flex-wrap:wrap;gap:var(--s6);margin-top:var(--s5);padding-top:var(--s5);border-top:1px solid var(--border-light);}
.trustmetrics li{display:flex;align-items:baseline;gap:var(--s3);}
