---
/**
 * 日本語ブログ詳細（/ja/blog/{slug}/）。
 * slug 是各语言共用的基准名（文件名剥掉 -ja 后缀，或取 translationKey）——
 * 与英文详情 /blog/{slug}/ 一一对应，供 hreflang 互指。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../../components/ImgPlaceholder.astro';
import { getCollection } from 'astro:content';
import { localePath, languageList, defaultLang, baseSlug } from '../../../i18n/utils';

export async function getStaticPaths() {
  const PAGE_LANG = 'ja';
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft && p.data.lang === PAGE_LANG)
    .map(p => {
      // ★ slug 必须与 en/hi/ko/ar 一致：文件名剥 -<lang> 后缀（baseSlug）。
      //   不能用 translationKey 当 slug —— 它是内容键不是 URL 键，遇到
      //   「日期前缀」命名（20261017-01_xxx）会比其他语言少一段前缀，
      //   hreflang 互指随之全部错位。老文章两者恰好相等，所以以前没暴露。
      const slug = baseSlug(p.slug, PAGE_LANG);
      return { params: { slug }, props: { post: p } };
    });
}

const { post } = Astro.props;
const { Content } = await post.render();
const PAGE_LANG = 'ja';
const published = new Date(post.data.date + 'T00:00:00')
  .toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

/* hreflang 互指：找出这篇的各语言译文（translationKey 相同，或基准 slug 相同）
   ★ 必须遍历 languageList 全量互指 —— 只链 en/ja 会让 hi/ko/ar 变成单向，
     Google 会因「缺回指」把整组 hreflang 判为无效。 */
const selfSlug = baseSlug(post.slug, PAGE_LANG);
const alternates: Record<string, string> = { [PAGE_LANG]: localePath(PAGE_LANG, `/blog/${selfSlug}/`) };
{
  const siblings = await getCollection('blog');
  for (const l of languageList) {
    if (l.code === PAGE_LANG) continue;
    // 默认语言正文通常不写 lang（如 1688-vs-alibaba.md），要靠 `|| defaultLang` 兜住
    const alt = siblings.find(p => (p.data.lang || defaultLang) === l.code && !p.data.draft && (
      (p.data.translationKey && p.data.translationKey === post.data.translationKey) ||
      baseSlug(p.slug, l.code) === selfSlug
    ));
    if (alt) {
      // ★ URL 只认文件名派生的 slug：translationKey 是内容键，命名带日期前缀时会少一段
      //   （slug=20260925-01_xxx vs translationKey=xxx），用它拼链接必 404。
      const altSlug = baseSlug(alt.slug, l.code);
      alternates[l.code] = localePath(l.code, `/blog/${altSlug}/`);
    }
  }
}
---
<BaseLayout lang={PAGE_LANG} title={post.data.title} description={post.data.description} article={{ published: post.data.date, section: post.data.category }} alternates={alternates}>

  <div class="article-cover" style="padding-top:var(--hdr-h);">
    <ImgPlaceholder src={post.data.cover} width={1680} height={720} ratio="21/9" priority alt={post.data.title} />
  </div>

  <header class="article-hdr">
    <div class="container article-hdr__inner">
      <a href={localePath(PAGE_LANG, '/blog/')} class="back">← ブログ一覧</a>
      <span class="article-cat">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <time>{published}</time>
        <span>·</span><span>{post.data.readTime}</span>
        <span>·</span><span>CrossPalsチーム</span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container article-grid">
      <div class="prose reveal"><Content /></div>

      <aside class="article-aside reveal reveal-delay-2">
        <div class="aside-cta">
          <p class="overline">お問い合わせ</p>
          <h4>無料で見積もりを取る</h4>
          <p>製品情報をお知らせください。確認済みサプライヤーと価格内訳を48時間でご提案します。</p>
          <a href={localePath(defaultLang, '/contact')} class="btn btn-primary" style="margin-top:var(--s5);">無料で相談する <svg class="arrow-icon" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <nav class="aside-nav">
          <p class="overline">Explore</p>
          <a href={localePath(defaultLang, '/services')}>FBA調達・検品 →</a>
          <a href={localePath(defaultLang, '/case-studies')}>事例紹介 →</a>
          <a href={localePath(PAGE_LANG, '/blog/')}>ブログ一覧 →</a>
        </nav>
      </aside>
    </div>
  </section>

</BaseLayout>
