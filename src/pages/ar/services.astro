---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';

/* ── 核心服务包（主推产品）：一条龙 ── */
const coreIncludes: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'توفير الموردين',   body: '3-5 موردين موثوقين بأسعار حقيقية — تم التحقق من التراخيص وعنوان المصنع وسجل التصدير قبل تقديم عرض السعر.' },
  { n: '02', title: 'تأكيد العينة', body: 'نقوم بطلب العينة وتقييمها وفقًا للمواصفات الخاصة بك وتوقعات عملائك قبل الالتكم بالطلب بالجملة.' },
  { n: '03', title: 'فحص الدفعة الكاملة', body: 'فحص مراقبة الجودة قبل الشحن في المصنع: المظهر، الأبعاد، الوظيفة، التغليف، وفحص ملصق FBA.' },
  { n: '04', title: 'تحضير FBA',            body: 'وضع ملصقات FNSKU، التغليف بكيس بلاستيكي، التجميع، الوزن والقياس وفقًا للمواصفات الدقيقة لأمازون.' },
  { n: '05', title: 'تنسيق الشحن', body: 'مقارنة الشحن الجوي، البحري، أو السريع؛ معالجة أوراق الجمارك؛ خدمة من الباب إلى الباب DDP مع تتبع حيوي.' },
];

/* ── 附加服务：单独可选 ── */
const addOns: Array<{ icon: IconName; title: string; problem: string; process: string; pricing: string; seed: number }> = [
  { icon: 'package', title: 'تصميم العلامة الخاصة والتغليف', seed: 71,
    problem: 'يجب أن يبدو منتجك كعلامة تجارية، وليس كاستيراد عام — والتغليف الضعيف يقتل التحويل.',
    process: 'وضع الشعار، تصميم علبة / كيس / ملصق، بطاقات إدراج، ومفاوضات الحد الأدنى للطلب مع مصنع التغليف.',
    pricing: 'رسوم تصميم ثابتة بالإضافة إلى تكلفة المصنع للتغليف. الحد الأدنى للطلب عادة 300–1000 قطعة.' },
  { icon: 'transparent', title: 'تصوير المنتج', seed: 72,
    problem: 'أمازون تدفن — أو تمنع — القوائم التي لا تلتزم صورتها الرئيسية بمعيار الخلفية البيضاء.',
    process: 'صور بخلفية بيضاء وفق مواصفات الصورة الرئيسية لأمازون، بالإضافة إلى صور نمط الحياة والمخططات البيانية عند الطلب.',
    pricing: 'سعر لكل صورة، مع خصم للكميات. سعر ثابت لكل SKU متاح.' },
  { icon: 'sourcing', title: 'خدمة الشراء من 1688', seed: 73,
    problem: 'أقل الأسعار الحية على 1688 — ولكن الموقع باللغة الصينية فقط ولا يشحن خارج الصين.',
    process: 'أرسل رابط المنتج أو صورة. نقوم بالشراء من بائع 1688، ونتفحص، ونجمع الشحن، ثم نرسله إليك.',
    pricing: 'نسبة مئوية من قيمة الطلب مع حد أدنى صغير. لا حاجة للغة الصينية.' },
  { icon: 'shipping', title: 'التخزين وإعادة الشحن', seed: 74,
    problem: 'الشراء من عدة موردين يعني عدة فواتير شحن دولية - دون أي شخص يتفحص البضائع.',
    process: 'نستقبل الطلبات، نتفحصها، نعيد تغليفها، ونجمع شحنات متعددة في شحنة واحدة من مستودعنا.',
    pricing: 'التخزين لكل متر مكعب في اليوم، بالإضافة إلى رسوم تجميع لكل طلب.' },
];

const svcImg: Record<number,string> = {71:'blog-packaging',72:'blog-products',73:'sourcing-1688',74:'shipping'};
const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'اليوم الأول',    title: 'تقوم بتقديم منتجك',    body: 'تفاصيل المنتج، الكمية، معايير الجودة، والميزانية عبر نموذج الاستفسار الخاص بنا.' },
  { day: 'اليوم الثاني',    title: 'نرسل لك خيارات الموردين',   body: 'من 3 إلى 5 موردين موثوقين مع عروض الأسعار وملفات تعريفية، جاهزين لمراجعتك.' },
  { day: 'اليوم الثالث إلى الخامس',  title: 'العينة والمفاوضات',       body: 'نتأكد من العينة، نتفق على الشروط بالصينية، نُصدِر أمر الشراء، ونُفرِز العربون بطريقة آمنة.' },
  { day: 'اليوم السابع إلى العشرين', title: 'الإنتاج والتفتيش',    body: 'يتم تصنيع البضائع. نتفحص الدفعة كاملة ونرسل تقرير صور بمراقبة الجودة قبل الشحن.' },
  { day: 'اليوم الحادي والعشرين فما فوق',  title: 'جاهز لـ إف بي إيه، التسليم',       body: 'يتم شحن البضائع من الصين مُوسَّمة ومُعبأة وفقًا لمواصفات أمازون، مع إتمام التخليص الجمركي وتوفير تتبع حيوي.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'رسوم الوكيل',  value: '5–8٪ من قيمة الطلب', note: 'طلب بقيمة 10,000 دولار = 600 دولار رسوم وكيل' },
  { label: 'التفتيش', value: '150 دولار / يوم',          note: 'يتم إنهاء معظم الطلبات في نصف يوم' },
  { label: 'تحضير شحنات أمازون (FBA)',   value: 'لكل وحدة',            note: 'مفصلة سطرًا بسطر في عرض الأسعار الخاص بك' },
  { label: 'الشحن',    value: 'حسب عرض سعر الناقل',    note: 'لا يوجد أي رسوم إضافية فوق سعر الناقل' },
];

const faqs = [
  { q: 'ما الذي يتضمنه بيع حزمة التوريد والتفتيش لخدمة FBA؟', a: 'توفير الموردين، تأكيد العينات، تفتيش الدفعة بالكامل، تحضير شحنات أمازون (FBA) (وضع البطاقات، التغليف، الوزن، القياس)، وتنسيق الشحن - وكيل واحد مسؤول، عرض سعر واحد.' },
  { q: 'ما هي تكلفة الخدمة لديكم؟',                            a: 'رسوم الوكيل هي 5-8٪ من قيمة الطلب. التفتيش 150 دولار/يوم (معظم الطلبات تنتهي في نصف يوم). تحضير FBA يتم حسابه لكل وحدة. كل شيء مفصل في عرض الأسعار قبل الالتزام.' },
  { q: 'ما هو الحد الأدنى لحجم الطلب؟',                         a: 'لا يوجد حد أدنى صارم، لكننا نعمل بشكل أفضل مع طلبات بقيمة 300 دولار أمريكي أو أكثر. الطلبات الأصغر قد يكون لها خيارات محدودة من الموردين.' },
  { q: 'ماذا لو فشلت البضائع في التفتيش؟',                           a: 'نتعاون مع المورد لحل المشكلة — إما بإعادة العمل، الاستبدال، أو الاسترداد — قبل شحن أي شيء. نحن لا نحرر الدفعة النهائية بدون موافقتك.' },
  { q: 'هل تقومون بتحضير شحنات FBA ووضع الملصقات؟',                    a: 'نعم. ملصقات FNSKU، التغليف في أكياس بلاستيكية، التجميع، ملصقات الكرتون، الأوزان والأبعاد حسب مواصفات أمازون — بحيث يتم استلام شحنتك بنجاح من أول مرة.' },
  { q: 'هل يمكنني الحصول على تغليف مخصص مع شعار علامتي؟',                 a: 'نعم — هذه خدمة العلامة الخاصة والتغليف الإضافية لدينا. صناديق، أكياس، ملصقات، وبطاقات تعليق. الحد الأدنى للطلب يختلف حسب المورد، عادة 300–1000 قطعة.' },
];

/* ── Our Guarantees, in full ──
   首页只给「承诺」（结果）；这里把四个承诺各自展开：流程（几步/每步多久）+ 具体标准（清单）+ 失败兜底。
   图片刻意不用首页那四张（factory/inspection/payment/shipping），四张统一 1024×1280、统一 ratio="4/5"。 */
type GuaranteeModule = {
  icon: IconName; n: string; title: string; promise: string;
  img: string; alt: string;
  steps: Array<{ t: string; time: string; d: string }>;
  checksLabel: string;
  checks: Array<{ k: string; v: string }>;
  fail: string;
};
const guaranteeModules: GuaranteeModule[] = [
  {
    icon: 'trust', n: '01', title: 'مواردون موثوقون فقط',
    promise: 'نحن نتحقق من كل مورد قبل أن تدفع مليمًا واحدًا.',
    img: '/img/g-market.webp', alt: 'التجول في أرضية سوق الجملة للتحقق من الموردين شخصيًا',
    steps: [
      { t: 'القائمة المختصرة', time: 'اليوم 1–2', d: 'نختار 3–5 مرشحين من شبكة المصانع الخاصة بنا ومن 1688، مطابقين لمواصفات منتجك.' },
      { t: 'شيك ورقي', time: 'اليوم 2–3', d: 'رخصة العمل، العنوان المسجل، القدرة الإنتاجية، وسجل التصدير — يتم التحقق منها مقابل المصنع نفسه، وليس صفحة المبيعات.' },
      { t: 'جولة افتراضية حية', time: 'اليوم 3–5', d: 'مكالمة فيديو داخل الورشة: خط الإنتاج الحقيقي، المخزون الفعلي، العينة الحقيقية.' },
    ],
    checksLabel: 'ما نتحقق منه',
    checks: [
      { k: 'الترخيص والكيان القانوني', v: 'رخصة عمل مطابقة للاسم الذي سيظهر على فاتورتك.' },
      { k: 'العنوان مقابل الورشة', v: 'يتم التحقق من العنوان المسجل مقابل المكان الذي يتم فيه تصنيع البضائع فعليًا.' },
      { k: 'السعة ووقت التسليم', v: 'ما إذا كان بإمكانهم استيعاب كمية طلبك، والموعد النهائي لك، وإعادة الطلب.' },
      { k: 'سجل التصدير', v: 'الشحنات السابقة والعملاء الحاليون - من الذين يبيعون لهم بالفعل في الخارج.' },
      { k: 'خط الإنتاج الحي', v: 'يتم رؤيته على الفيديو قبل أن يغادر أي دولار حسابك.' },
    ],
    fail: 'إذا لم يتمكن المصنع من اجتياز فحص الأوراق أو يرفض جولة حية، فلن يصل إلى عرض السعر الخاص بك. نستمر في البحث.',
  },
  {
    icon: 'inspection', n: '02', title: 'مراقبة الجودة قبل الشحن',
    promise: 'تقرير صور + نجاح/فشل قبل تحرك أموالك.',
    img: '/img/g-production.webp', alt: 'مفتش يفحص البضائع في أرضية الإنتاج قبل الشحن',
    steps: [
      { t: 'حجز الفحص', time: 'اليوم قبل إغلاق الدفعة', d: 'مجدول مقابل تاريخ انتهاء الإنتاج - وليس تاريخ الشحن، لذلك لا يزال هناك وقت لإصلاح الأشياء.' },
      { t: 'فحص الدفعة الكاملة في الموقع', time: 'نصف يوم، عادة', d: 'نقف في المصنع، نحسب، نقيس، نختبر، ونصور الدفعة بأنفسنا.' },
      { t: 'التقرير والحكم', time: 'نفس اليوم', d: 'تتلقى تقرير الصورة مع نتيجة اجتياز/رسوب واضحة، وعدد العيوب، ومعيار أخذ العينات المستخدم.' },
      { t: 'إعادة العمل أو الاستبدال', time: 'من 3 إلى 7 أيام', d: 'يتم إعادة المنتج غير المطابق مباشرة إلى المورد لإعادة العمل أو الاستبدال - ثم نعيد التفتيش قبل التغليف.' },
    ],
    checksLabel: 'ما نفحصه',
    checks: [
      { k: 'المظهر', v: 'الأسطح، اللون، التشطيب، الخياطة، الطباعة، والأضرار المرئية - مقارنة مع العينة المعتمدة.' },
      { k: 'الأبعاد', v: 'الوزن والقياسات وفقاً للمواصفات، مع تحديد الوحدات غير المطابقة بشكل فردي.' },
      { k: 'الوظيفة', v: 'تشغيل كل وحدة تم أخذ عينات منها، أو تركيبها، أو استخدامها تمامًا كما سيستخدمها عميلك.' },
      { k: 'التغليف', v: 'الصندوق التجاري، كيس البولي، تحذير الاختناق، الإضافات الداخلية، ومتانة الكرتون.' },
      { k: 'ملصقات FBA', v: 'مسح رموز FNSKU الباركود، ملصقات الكرتون صحيحة، والأوزان والأبعاد حسب مواصفات أمازون.' },
    ],
    fail: 'إذا فشلت الدفعة، لا يتم شحنها. يعيد المورد العمل عليها أو يستبدلها، ويظل رصيدك معنا حتى اجتياز الفحص.',
  },
  {
    icon: 'payment', n: '03', title: 'حماية الدفع',
    promise: 'نحتفظ بالأموال حتى اكتمال المراحل. لا تحويلات إلى جهات غير معروفة.',
    img: '/img/payment-escrow.webp', alt: 'الأموال محتجزة مقابل صناديق مختومة حتى اكتمال كل مرحلة',
    steps: [
      { t: 'يتم كتابة طلب الشراء مع تحديد المراحل', time: 'اليوم الأول', d: 'يتم تحديد الإيداع والإنتاج والتفتيش والشحن كنقاط إصدار منفصلة قبل بدء أي شيء.' },
      { t: 'تم إصدار الإيداع', time: 'اليوم الأول–الثاني', d: 'يتم صرف فقط المبلغ المتفق عليه للإيداع، وفقط بعد موافقتك الخطية على أمر الشراء.' },
      { t: 'مرحلة التفتيش', time: 'في مرحلة مراقبة الجودة', d: 'لا يتم صرف رصيد الإنتاج حتى يرجع تقرير التفتيش بنتيجة مُرضية.' },
      { t: 'التسوية النهائية', time: 'عند توقيعك للاعتماد', d: 'يتم تسوية الرصيد بعد موافقتك، مع إيصال مكتوب على الفاتورة.' },
    ],
    checksLabel: 'كيف يتم الاحتفاظ بأموالك',
    checks: [
      { k: 'أنت توافق على كل عملية صرف', v: 'لا يتم تحويل أي دفعة بدون موافقتك الخطية في كل مرحلة.' },
      { k: 'المورد يُدفع له من قبلنا', v: 'نحن ندفع للمصنع مباشرة — أنت لا ترسل الأموال أبدًا إلى حساب غير معروف.' },
      { k: 'لا حسابات شخصية', v: 'لا تذهب الأموال أبدًا إلى حساب بنكي شخصي أو محفظة طرف ثالث.' },
      { k: 'لا دفعة مقدمة كاملة', v: 'لا يتلقى أي شخص 100% مقدمًا — لا المورد ولا نحن.' },
      { k: 'إيصال لكل عملية تحويل', v: 'يتم توثيق كل عملية إصدار ووضعها مقابل طلبك بشكل مفصل.' },
    ],
    fail: 'إذا لم يتم تحقيق مرحلة ما، نقوم بإيقاف الطلب ويبقى المال معك — لا يُدفع لأحد مقابل عمل لم يتم إنجازه.',
  },
  {
    icon: 'shipping', n: '04', title: 'توصيل الباب إلى الباب (DDP)',
    promise: 'تتبع السلع — وليس الأوراق.',
    img: '/img/g-packing.webp', alt: 'صناديق مغلقة، مٌعلّمة وجاهزة للتسليم إلى الباب',
    steps: [
      { t: 'حجز وتجميع', time: 'اليوم 1-2', d: 'نحن نختار الناقل، نحجز المساحة، ونجمع صناديقك في شحنة واحدة.' },
      { t: 'التصدير والمستندات', time: '2-3 أيام', d: 'إقرار التصدير، قائمة التعبئة، والفواتير التجارية — يتم إعدادها وتقديمها من جانبنا.' },
      { t: 'الشحن والاستيراد', time: 'جوي 5-8 أيام · بحري 25-35 يوم', d: 'شحن جوي أو بحري، مع إتمام الضرائب والجمارك تحت نظام DDP حتى لا يقع أي شيء على عاتقك.' },
      { t: 'توصيل إلى الباب', time: '1-3 أيام', d: 'آخر ميل إلى عنوانك أو مباشرة إلى أمازون، مع التتبع من البداية إلى النهاية.' },
    ],
    checksLabel: 'ما المدرج',
    checks: [
      { k: 'مِن الباب إلى الباب (DDP)', v: 'سعر واحد من المصنع إلى عتبة منزلك — دون مفاجأة فاتورة جمركية.' },
      { k: 'الرسوم والضرائب', v: 'مدرجة في الاقتباس، مفردة بشكل منفصل حتى تتمكن من رؤيتها.' },
      { k: 'تتبع حي', v: 'رقم تتبع يعمل من المغادرة حتى التسليم.' },
      { k: 'قائمة التعبئة والفاتورة', v: 'المستندات التي سيطلبها أمازون والشاحن الخاص بك.' },
      { k: 'FBA أو عنوانك', v: 'مسلّم إلى مستودع أمازون أو إليك — الاختيار لك عند الحجز.' },
    ],
    fail: 'إذا تأخرت الشحنة، أو تم احتجازها، أو فقدت، نتولى ملاحقة الناقل وتقديم المطالبة. المعاملات الورقية هي مسؤوليتنا للدفاع عنها، وليست مسؤوليتك.',
  },
];
---
<BaseLayout title="Services" description="توفير وتفتيش FBA — بحث عن موردين، تأكيد العينات، تفتيش الدفعة الكاملة، إعداد FBA، وتنسيق الشحن، بالإضافة إلى العلامة الخاصة، التصوير، الشراء من 1688 وخدمات التخزين الإضافية. تسعير شفاف." ogImage="/img/case-relabel.webp" lang="ar">

  <PageHero
    overline="ما نقدمه"
    title="توفير FBA<br/><em style='font-style:italic;color:var(--avo-300)'>وتفتيش</em>"
    subtitle="حزمة واحدة — من البحث عن المورد إلى صندوق جاهز لأمازون. أضف العلامة الخاصة، التصوير، الشراء من 1688، أو التخزين عند الحاجة."
  />

  <!-- ═══ 核心服务包 ═══ -->
  <section class="section">
    <div class="container">
      <div class="core reveal">
        <div class="core__aside">
          <span class="tag tag-seal">الحزمة الأساسية</span>
          <h2>تزويد FBA<br/><em>والتفتيش</em></h2>
          <p class="core__lead">الحزمة الوحيدة التي نوصي بها لكل بائع في FBA. كل ما يلزم للانتقال من "أريد بيع هذا" إلى صندوق مُجهز لأمازون، مع تسمية وتفتيش — تتم إدارته بواسطة وكيل واحد.</p>
          <div class="core__price">
            <span class="core__price-label">كيفية التسعير</span>
            <p>رسوم الوكيل 5–8% · التفتيش 150$/يوم · تجهيز وحدة FBA — كلها مفصلة في اقتباس واحد.</p>
          </div>
