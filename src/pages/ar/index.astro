---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { PHONE } from '../../config/site';
import { getCollection } from 'astro:content';
import { defaultLang, entriesForLang, baseSlug, contentLink } from '../../i18n/utils';

/* 本页语言 —— 脚手架复制出 /<prefix>/index.astro 时会改成 `const PAGE_LANG = '<语言码>';` */
const PAGE_LANG = 'ar';

/* ── 服务（每项带一条独立定价说明） ── */
const services: Array<{ icon: IconName; n: string; title: string; body: string; price: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',    n: '01', title: 'تحديد المصادر للمنتجات',     body: 'نبحث بين آلاف الموردين الصينيين — بما في ذلك 1688، Alibaba، وشبكات المصانع المباشرة — لإيجاد المنتج المطابق لميزانيتك ومعاييرك.', price: 'طلب بقيمة <b>1,000 دولار</b> → رسوم تحديد مصادر <b>80 دولار</b> (8%). نحن نخفض سعر الوحدة ولا نضيف أي هامش ربح.', seed: 10, hint: '义乌商品城/供应商展会场景', delay: 0 },
  { icon: 'inspection',  n: '02', title: 'فحص الجودة',   body: 'فحص مادي في المصنع قبل شحن بضائعك. تقرير مصور مفصل، عدد العيوب، وتقييم واضح (ناجح/راسب) لضمان عدم الشحن الأعمى.', price: 'طلب بقيمة <b>1,000 دولار</b> → <b>150 دولار</b> رسوم فحص ثابتة (نصف يوم). يشمل تقريرًا مصورًا كاملاً.', seed: 20, hint: '质检员工作照/工厂内部', delay: 1, featured: true },
  { icon: 'payment',     n: '03', title: 'الشراء والدفع', body: 'نتفاوض باللغة الصينية وننفذ جميع المدفوعات لموردين موثوقين. أموالك محمية في كل خطوة — لا تحويلات لأطراف مجهولة.', price: 'طلب بقيمة <b>1,000 دولار</b> → 30% دفعة مقدمة / 70% بعد فحص الجودة. <b>5–8%</b> رسوم معالجة، بدون هوامش خفية.', seed: 30, hint: '签约/握手/合同场景', delay: 2 },
  { icon: 'shipping',    n: '04', title: 'الشحن والخدمات اللوجستية', body: 'من الباب إلى الباب عالميًا. نقارن بين خيارات الجو والبحر وخدمات البريد السريع، ثم ننفذ أسناد الجمارك ونوفر لك التتبع الفعلي.', price: 'طلب بقيمة <b>1,000 دولار</b> → تكلفة الشحن حسب العرض المباشر للناقل. <b>0 دولار</b> رسوم إضافية.', seed: 40, hint: '集装箱港口/货运飞机', delay: 3 },
];

/* ── 三个真实 FBA 卖家场景（Facebook 群组每天都在发的帖） ── */
const scenarios: Array<{ quote: string; tag: string; title: string; body: string; cta: string }> = [
  { quote: 'طلبت 500 وحدة وواجهت 30% عيوبًا.', tag: 'فحص قبل الشحن', title: 'فحص الجودة',
    body: 'نفحص الدفعة كاملة في المصنع — القياس، الاختبار، وحساب العيوب أمام الكاميرا. إذا كانت نسبة النجاح غير كافية، يقوم المورد بإصلاح أو استبدال المنتجات قبل شحن أي صندوق من الصين.',
    cta: 'شاهد كيف يعمل الفحص' },
  { quote: 'اختفى المورد الخاص بي بعد الدفع.', tag: 'التحقق قبل الدفع', title: 'التحقق من المورد',
    body: 'نحن لا نقوم بتحويل أموال لأي مورد لم نتحقق منه. رخصة العمل، عنوان المصنع، سجل التصدير، وجولة فيديو حية — يتم التحقق منها قبل إطلاقك للوديعة، وليس بعد.',
    cta: 'شاهد كيف نتحقق من الموردين' },
  { quote: 'لا أعرف ما إذا كان منتجي يستوفي متطلبات FBA.', tag: 'جاهز لـ FBA قبل الشحن', title: 'تحضير لـ FBA',
    body: 'نقوم بتوسيم، تغليف، تجميع، وزن، وقياس وفقًا للمواصفات الدقيقة لأمازون — ثم نقدم لك ملصقات الكرتون وقائمة التعبئة التي تضمن استلامًا ناجحًا من المرة الأولى.',
    cta: 'شاهد تحضير FBA' },
];

/* ── 独立质检模块：5 项质检标准 ── */
const inspectionStandards: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'المظهر',      body: 'يتم فحص السطح، اللون، الطباعة والتشطيب مقابل العينة المعتمدة منك.' },
  { n: '02', title: 'الأبعاد',      body: 'يتم قياس الطول، العرض، الوزن والتفاوتات باستخدام الفرجار والميزان.' },
  { n: '03', title: 'اختبار الوظيفة',   body: 'يتم تشغيل كل عينة، تجميعها أو استخدامها بالطريقة التي سيفعلها عميلك.' },
  { n: '04', title: 'التغليف',       body: 'متانة صندوق التجزئة، الإضافات والتغليف — بالإضافة إلى جاهزية لاختبار السقوط أثناء النقل.' },
  { n: '05', title: 'فحص ملصق FBA', body: 'FNSKU، ملصقات الكرتون، تحذيرات الاختناق، وقابلية مسح الباركود الخاص بأمازون.' },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'اليوم الأول',    title: 'قدم منتجك',      body: 'أخبرنا عن المنتج، الكمية، معايير الجودة والميزانية من خلال النموذج البسيط لدينا.' },
  { day: 'اليوم الثاني',    title: 'خيارات موردين مدققة',  body: '3-5 موردين معتمدين مع الأسعار والملفات الشخصية، في بريدك الوارد خلال 48 ساعة.' },
  { day: 'اليوم 7-20', title: 'نحن نشتري ونتفقد',         body: 'نقوم بدفع المبلغ للمورد، ونشرف على الإنتاج، ونرسل تقرير فحص جودة كامل بالصور قبل أي شحنة.' },
  { day: 'اليوم 21+',  title: 'جاهز لـ FBA، مع التوصيل',     body: 'تُشحن البضائع من الصين مُوسَّمة ومغلفة وفق مواصفات أمازون، مع التخليص الجمركي ورقم التتبع.' },
];

/* ── 证言：FBA 卖家格式（品类 / 订单 / 问题 / 结果） ── */
const testiFeatured = {
  quote: 'أبيع أدوات المطبخ على أمازون الولايات المتحدة. وجدت كروس بالز منتجي الأساسي، واكتشفت 15 وحدة معيبة قبل الشحن، وقدمت كل شيء جاهزًا لـ FBA خلال 18 يومًا. قمت بإعادة الطلب مرتين منذ ذلك الحين.',
  name: 'ماركوس ت.', meta: 'بائع أمازون · الولايات المتحدة · المطبخ',
  result: '15 عيباً تم اكتشافها قبل الشحن · جاهز لـ FBA في 18 يوماً', avatar: '/img/avatar-nigeria.webp',
};
const testiSmall = [
  { quote: 'أول طلب خاص بعلامتي التجارية — 800 وحدة من مستلزمات الحيوانات الأليفة. قاموا بالتحقق من المصنع واكتشاف مشكلة في التغليف، ووصل المنتج إلى FBA دون أي رفض.',
    name: 'Ana R.', meta: 'أمازون FBA · إسبانيا · مستلزمات الحيوانات الأليفة', result: '0 FBA rejections', avatar: '/img/avatar-mexico.webp' },
  { quote: 'موردي السابق اختفى بعد استلام العربون. قام CrossPals بفحص مورد جديد، وأجروا مراقبة الجودة بأنفسهم، ولم أرسل الأموال إلى غريب مرة أخرى.',
    name: 'David O.', meta: 'أمازون وشوبيفاي · المملكة المتحدة · منتجات المنزل والحديقة', result: 'إعادة طلب مرتين', avatar: '/img/avatar-uk.webp' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: 'لا حواجز لغوية',  body: 'نحن نتفاوض مباشرة باللغة الصينية — تحصل على أسعار المصنع، وليس أسعار السياح.' },
  { icon: 'trust',        n: '02', title: 'مساءلة حقيقية',   body: 'وكيل مخصص يدير طلبك. تحصل على شخص واحد، وليس طابور تذاكر.' },
  { icon: 'handshake',    n: '03', title: 'مصمم لبائعي FBA', body: 'كل ما نفعله ينتهي بصندوق جاهز لأمازون: مُورَّد، مُفتَّش، مُوسَّم، مُعبَّأ.' },
  { icon: 'transparent',  n: '04', title: 'تكاليف شفافة',     body: 'سعر المورد + الشحن + رسومنا. ترى كل رقم قبل الالتزام.' },
];

/* 首页只给承诺（结果），不说过程；过程全部放到 Services 页的展开模块 */
const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: 'موردون موثوقون فقط', body: 'نتحقق من كل مورد قبل أن تدفع سنتًا.' },
  { icon: 'inspection', title: 'فحص الجودة قبل الشحن',      body: 'تقرير صور + نجاح/فشل قبل تحرك أموالك.' },
  { icon: 'payment',    title: 'حماية الدفع',      body: 'نحتفظ بالأموال حتى اكتمال المراحل. لا تحويلات إلى غرباء.' },
  { icon: 'shipping',   title: 'توصيل بالباب DDP',       body: 'تتبع وبضائع — وليس أوراق.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'رسوم الوكيل',     value: '5–8% من قيمة الطلب', note: 'طلب بقيمة 10,000 دولار = 600 دولار رسوم وكيل' },
  { label: 'التفتيش',    value: '١٥٠ دولارًا / يوم',          note: 'معظم الطلبات تنتهي في نصف يوم' },
  { label: 'تحضير FBA',      value: 'لكل وحدة',            note: 'مفصلة سطرًا بسطر في عرض الأسعار الخاص بك' },
  { label: 'الشحن',       value: 'حسب عرض الناقل',    note: 'لا يوجد رسوم إضافية فوق سعر الناقل' },
];

/* Resources：自动取最新 3 篇文章（来自 src/content/blog/*.md —— 加文章即自动出现在首页） */
const blogPosts = entriesForLang((await getCollection('blog')).filter(p => !p.data.draft), PAGE_LANG)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map(p => ({ slug: p.slug, cat: p.data.category, title: p.data.title, time: p.data.readTime, cover: p.data.cover }));

const svcImg: Record<number,string> = {10:'sourcing-1688',20:'inspection',30:'payment',40:'shipping'};
const guarImg: Record<string,string> = {trust:'factory',inspection:'inspection',payment:'payment',shipping:'shipping'};
const tickerItems = ['تحضير FBA', 'مراقبة الجودة قبل الشحن', 'التوريد من 1688', 'تحقق من المورد', 'شحن DDP', 'العلامة الخاصة', 'تصوير المنتج', 'أمازون FBA', 'خه بي · باو دينغ → العالم', 'تقارير صور مراقبة الجودة', 'لا توجد رسوم خفية'];
const categories = ['المطبخ وتناول الطعام', 'المنزل والحديقة', 'لوازم الحيوانات الأليفة', 'الألعاب والألعاب', 'الرياضة والهواء الطلق', 'الجمال والعناية الشخصية', 'ملحقات الإلكترونيات', 'المنتجات المكتبية'];
---
<BaseLayout
  title="شريك التوريد الذي يثق به بائعون أمازون"
  description="كراس بالز تتولى توريد وفحص وتحضير المنتجات لـ FBA — التحقق من الموردين، مراقبة الجودة قبل الشحن، وإعداد FBA، حتى تتمكن من التركيز على البيع وليس الموردين."
 lang="ar">

<!-- ═══ 顶部深色带：公告条 + 刊头信息行 ═══ -->
<div class="topband">
  <a href="/ar/contact" class="announce announce--dark">
    <span class="announce__dot" aria-hidden="true"></span>
    <span><strong>جديد:</strong>استشارة مجانية للمشتريات للمستوردين لأول مرة - قائمة مختصرة من الموردين خلال 48 ساعة</span>
    <span class="announce__arrow" aria-hidden="true">→</span>
  </a>

  <div class="masthead">
    <div class="container masthead__inner">
      <span>CrossPals · دليل المشتريات من الصين</span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span>العدد رقم 01 — MMXXVI</span>
    </div>
  </div>
</div>

<!-- ═══ HERO — 面向 Amazon 卖家 ═══ -->
<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">المشتريات من الصين لبائعي FBA</p>
        <h1 class="hero__title">شريك المشتريات الذي يثق به بائعي أمازون — <em>يشمل فحص الجودة.</em></h1>
        <p class="hero__lead">نحن نقوم بالشراء والفحص وإعداد منتجاتك لـ FBA - حتى تتمكن من التركيز على البيع، وليس الموردين.</p>

        <p class="hero__sidenote">الشكل 00 — معظم بائعي FBA يخسرون المال بسبب فجوات اللغة والموردين المزيفين وشحنات العمياء. نحن نغلق الثلاثة.</p>

        <div class="hero__actions">
          <a href="/ar/contact" class="btn btn-primary">احصل على عرض سعر مجاني<svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href="/ar/services" class="btn btn-ghost">شاهد كيف يعمل</a>
        </div>

        <ul class="hero__index">
          <li><span>01</span> Source</li>
          <li><span>02</span> Inspect</li>
          <li><span>03</span>إعداد لـ FBA</li>
          <li><span>04</span> Deliver</li>
        </ul>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__photo-fill">
        <ImgPlaceholder src="/img/hero-warehouse.webp" seed={42} width={900} height={1100} ratio="9/11" priority
          alt="مصنع الصين ومستودعه — توريدات كراس بالز" />
      </div>
      <div class="hero__cap">
        <span class="hero__cap-label">الشكل 01</span>
        <span class="hero__cap-text">خبي · باودينغ، الصين</span>
        <span class="seal seal--sm" aria-hidden="true"><span>Verified</span><span>Agent</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TICKER ═══ -->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[...tickerItems, ...tickerItems].map(t => <span class="ticker__item">{t}</span>)}
  </div>
</div>

<!-- ═══ 信任带：服务场景标识 + 数字指标（替代原来的国家旗帜列表） ═══ -->
<section class="trustbar" aria-label="ما نتعامل معه ومن نخدم">
  <div class="container">
    <p class="overline" style="margin-bottom:var(--s4);">توفير وتفتيش وتحضير المنتجات لبائعي أمازون وشوبيفاي</p>
    <div class="regionwall reveal">
      {categories.map(c => <span>{c}</span>)}
    </div>
    <ul class="trustmetrics reveal reveal-delay-1">
      <li><b>47</b><span>عدد بائعي أمازون الذين نخدمهم</span></li>
      <li><b>2.3 مليون دولار<em>+</em></b><span>البضائع الموردة</span></li>
      <li><b>98<em>%</em></b><span>التسليم في الموعد</span></li>
    </ul>
  </div>
</section>

<!-- ═══ SERVICES — 每项带独立定价说明 ═══ -->
<section class="section svc ledger">
  <div class="container svc__wrap">
    <aside class="svc__aside">
      <p class="overline">ما نقدمه</p>
      <h2 class="svc__h">من البداية إلى النهاية<br/><em>التوريد من الصين</em></h2>
      <p class="svc__intro">أربعة تخصصات، وكيل واحد مسؤول. كل خطوة موثقة، مصورة، ومُسعّرة قبل تحويل أموالك.</p>
      <a href="/ar/services" class="svc__all">مؤشر الخدمة الكاملة →</a>
    </aside>

    <ol class="svc__list">
      {services.map(s => (
        <li class:list={['svc-row reveal', `reveal-delay-${s.delay}`]}>
          <div class="svc-row__num"><span class="indexnum">{s.n}</span></div>
          <div class="svc-row__thumb">
            <ImgPlaceholder src={'/img/'+svcImg[s.seed]+'.webp'} seed={s.seed} width={360} height={240} ratio="3/2" alt={s.title} />
          </div>
          <div class="svc-row__body">
            <div class="svc-row__top">
              <h3>{s.title}</h3>
            </div>
            <div class="lede-row">
              <p>{s.body}</p>
              <a href="/ar/services" class="svc-row__link">معرفة المزيد<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
            <div class="price-note">
              <span class="price-note__label">Price</span>
              <span class="price-note__calc" set:html={s.price} />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═══ HOW IT WORKS ═══ -->
<section class="section hiw grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="hiw__head reveal">
      <p class="overline overline--light">Process</p>
      <h2 class="text-white">من المورد إلى<br/><em style="color:var(--avo-300)">جاهز لإيف بي إي في 4 خطوات</em></h2>
    </div>

    <div class="manifest reveal reveal-delay-1">
      {steps.map((step, i) => (
        <div class:list={['manifest__col', { 'manifest__col--end': i === steps.length - 1 }]}>
          <span class="manifest__day">{step.day}</span>
          <span class="manifest__n">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="manifest__title">{step.title}</h4>
          <p class="manifest__body">{step.body}</p>
        </div>
      ))}
      <div class="manifest__stamp" aria-hidden="true">
        <span class="seal"><span>Cross</span><span>بالز ✓</span></span>
      </div>
    </div>

    <div class="hiw__cta reveal reveal-delay-2">
      <a href="/ar/contact" class="btn btn-primary">احصل على عرض أسعار مجاني</a>
      <a href="/ar/case-studies" class="btn btn-ghost">اطّلع على دراسات الحالة</a>
    </div>
  </div>
</section>

<!-- ═══ 三个真实 FBA 卖家场景（解决痛点） ═══ -->
<section class="section scen">
  <div class="container">
    <div class="scen__head reveal">
      <p class="overline">المشاكل التي نحلها</p>
      <h2>ثلاثة منشورات كل<br/><em>بائع أمازون يكتب</em></h2>
      <p class="scen__lead">هذه هي المواضيع التي تظهر في مجموعات بائعي أمازون كل يوم. إليك بالضبط كيف نجيب على كل منها.</p>
    </div>

    <div class="scen__list">
      {scenarios.map((s, i) => (
        <article class:list={['scen-item reveal', `reveal-delay-${i}`]}>
          <div class="scen-item__quote">
            <span class="scen-item__mark" aria-hidden="true">“</span>
            <p>{s.quote}</p>
            <span class="scen-item__src">— منشور في منتدى بائع FBA</span>
          </div>
          <div class="scen-item__sol">
            <span class="tag tag-seal">{s.tag}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <a href="/ar/services" class="scen-item__link">{s.cta}
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </a>
          </div>
        </article>
      ))}
