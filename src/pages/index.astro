---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';

const services: Array<{ icon: IconName; n: string; title: string; body: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',    n: '01', title: 'Product Sourcing',     body: 'We search thousands of Chinese suppliers — 1688, Alibaba, and direct factory networks — to find the exact match for your budget and standards.', seed: 10, hint: '义乌商品城/供应商展会场景', delay: 0 },
  { icon: 'inspection',  n: '02', title: 'Quality Inspection',   body: 'Physical inspection at the factory before your goods ship. Detailed photo report, defect counts, and a clear pass/fail so you never ship blind.', seed: 20, hint: '质检员工作照/工厂内部', delay: 1, featured: true },
  { icon: 'payment',     n: '03', title: 'Purchasing & Payment', body: 'We negotiate in Chinese and handle all payments to verified suppliers. Your money is protected at every step — no wires to strangers.', seed: 30, hint: '签约/握手/合同场景', delay: 2 },
  { icon: 'shipping',    n: '04', title: 'Shipping & Logistics', body: 'Door-to-door worldwide. We compare air, sea, and express options, then handle customs docs and give you real-time tracking.', seed: 40, hint: '集装箱港口/货运飞机', delay: 3 },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Day 1',    title: 'Submit your request',      body: 'Tell us your product type, quantity, quality needs, and budget via our simple form.' },
  { day: 'Day 2',    title: 'Supplier options',          body: '3–5 vetted suppliers with pricing and profiles, delivered to your inbox within 48 hours.' },
  { day: 'Day 7–20', title: 'We purchase & inspect',     body: 'We pay the supplier, oversee production, and send you a full QC photo report before anything ships.' },
  { day: 'Day 21+',  title: 'Delivered to your door',    body: 'Goods leave China with tracking number, customs handled. You sit back and wait.' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: 'No Language Barrier',  body: 'We negotiate directly in Chinese — you get factory prices, not tourist prices.' },
  { icon: 'trust',        n: '02', title: 'Real Accountability',   body: 'A dedicated agent manages your order. You get one person, not a ticket queue.' },
  { icon: 'handshake',    n: '03', title: 'Built for Beginners',   body: 'Never sourced before? We guide you step by step from first inquiry to first sale.' },
  { icon: 'transparent',  n: '04', title: 'Transparent Costs',     body: 'Supplier price + shipping + our fee. You see everything before committing.' },
];

const blogPosts = [
  { cat: 'Sourcing Guide', title: 'How to Find Reliable Suppliers on 1688 Without Speaking Chinese', slug: 'find-suppliers-1688', time: '5 min', seed: 101, hint: '1688平台/中国电商/供应商市场' },
  { cat: 'Shipping',       title: 'Air vs Sea Freight: Which to Choose for Your First Order?',        slug: 'air-vs-sea-freight',  time: '4 min', seed: 102, hint: '货运飞机/集装箱码头' },
  { cat: 'Business Tips',  title: '5 Products That Are Cheaper in China and Sell Well Everywhere',    slug: 'cheap-china-products', time: '6 min', seed: 103, hint: '热销商品展示/产品陈列' },
];

const tickerItems = ['Lagos', 'São Paulo', 'Mexico City', 'Manila', 'Nairobi', 'Bogotá', 'Cairo', 'Yiwu → World', '1688 Sourcing', 'QC Inspected', 'DDP Shipping', 'Verified Suppliers'];
---
<BaseLayout
  title="Trusted China Sourcing for Global Entrepreneurs"
  description="CrossPals helps overseas entrepreneurs find, verify, and ship quality products from China."
>

<!-- ═══ MASTHEAD ISSUE LINE ═══ -->
<div class="masthead">
  <div class="container masthead__inner">
    <span>CrossPals · China Sourcing Manual</span>
    <span class="masthead__rule" aria-hidden="true"></span>
    <span>Issue Nº01 — MMXXVI</span>
  </div>
</div>

<!-- ═══ HERO — 非对称编辑式 ═══ -->
<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <!-- Left editorial column -->
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">Your China Sourcing Partner</p>
        <h1 class="hero__title">We take the <em>risk</em> out of buying from China.</h1>
        <p class="hero__lead">CrossPals is the dedicated agent between your idea and the factory floor — sourcing, inspecting, paying, and shipping end-to-end, so you never wire a stranger or guess at quality.</p>

        <p class="hero__sidenote">Fig. 00 — Most first-time importers lose money to language gaps, fake suppliers, and blind shipments. We close all three.</p>

        <div class="hero__actions">
          <a href="/contact" class="btn btn-primary">
            Get a Free Quote
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href="/services" class="btn btn-ghost">See How It Works</a>
        </div>

        <ul class="hero__index">
          <li><span>01</span> Sourcing</li>
          <li><span>02</span> Inspection</li>
          <li><span>03</span> Payment</li>
          <li><span>04</span> Shipping</li>
        </ul>
      </div>
    </div>

    <!-- Right full-bleed photo with caption strip -->
    <div class="hero__right">
      <div class="hero__photo-fill">
        <ImgPlaceholder seed={42} width={900} height={1100} ratio="9/11"
          alt="China factory warehouse — CrossPals sourcing"
          hint="建议：工厂车间 / 仓库货架 / 产品特写，竖向构图" />
      </div>
      <div class="hero__cap">
        <span class="hero__cap-label">Fig. 01</span>
        <span class="hero__cap-text">Yiwu International Trade Market, Zhejiang</span>
        <span class="seal seal--sm" aria-hidden="true"><span>Verified</span><span>Agent</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TICKER — 有意义的动效 ═══ -->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[...tickerItems, ...tickerItems].map(t => <span class="ticker__item">{t}</span>)}
  </div>
</div>

<!-- ═══ SERVICES — 杂志目录式编号索引 ═══ -->
<section class="section svc ledger">
  <div class="container svc__wrap">
    <aside class="svc__aside">
      <p class="overline">What We Do</p>
      <h2 class="svc__h">End-to-End<br/><em>China Sourcing</em></h2>
      <p class="svc__intro">Four disciplines, one accountable agent. Each step is documented, photographed, and signed off before your money moves.</p>
      <a href="/services" class="svc__all">Full service index →</a>
    </aside>

    <ol class="svc__list">
      {services.map(s => (
        <li class:list={['svc-row reveal', {'svc-row--featured': s.featured}, `reveal-delay-${s.delay}`]}>
          <div class="svc-row__num"><span class="indexnum">{s.n}</span></div>
          <div class="svc-row__thumb">
            <ImgPlaceholder seed={s.seed} width={360} height={240} ratio="3/2" alt={s.title} hint={s.hint} />
          </div>
          <div class="svc-row__body">
            <div class="svc-row__top">
              <h3>{s.title}</h3>
              {s.featured && <span class="tag tag-seal">Most requested</span>}
            </div>
            <p>{s.body}</p>
            <a href="/services" class="svc-row__link">Learn more
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═══ HOW IT WORKS — 货运 manifest 表格 ═══ -->
<section class="section hiw grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="hiw__head reveal">
      <p class="overline overline--light">Process</p>
      <h2 class="text-white">From Idea to Inventory<br/><em style="color:var(--avo-300)">in 4 Steps</em></h2>
    </div>

    <div class="manifest reveal reveal-delay-1">
      {steps.map((step, i) => (
        <div class:list={['manifest__col', { 'manifest__col--end': i === steps.length - 1 }]}>
          <span class="manifest__day">{step.day}</span>
          <span class="manifest__n">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="manifest__title">{step.title}</h4>
          <p class="manifest__body">{step.body}</p>
        </div>
      ))}
      <div class="manifest__stamp" aria-hidden="true">
        <span class="seal"><span>Cross</span><span>Pals ✓</span></span>
      </div>
    </div>

    <div class="hiw__cta reveal reveal-delay-2">
      <a href="/contact" class="btn btn-primary">Start Your First Order</a>
      <a href="/about" class="btn btn-ghost">Meet the Team</a>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIALS — 大号 pull-quote（非卡片） ═══ -->
<section class="section testi">
  <div class="container">
    <div class="testi__head reveal">
      <p class="overline">Success Stories</p>
      <h2>Real Businesses,<br/><em>Real Results</em></h2>
    </div>

    <blockquote class="pullquote reveal">
      <span class="pullquote__mark" aria-hidden="true">“</span>
      <p>CrossPals found a certified supplier, managed 3 shipments in 6 months, and now I run a real brand — all starting with $800.</p>
      <footer>
        <span class="pullquote__region">🇧🇷 Brazil · São Paulo</span>
        <span class="pullquote__result">3× ROI in first quarter</span>
      </footer>
    </blockquote>

    <div class="testi__row">
      <blockquote class="pq-sm reveal reveal-delay-1">
        <p>"Got my Yiwu supplier in 48 hours. QC photos, DHL shipping — I never left Lagos."</p>
        <footer><span>🇳🇬 Nigeria</span><span class="text-seal">40% lower cost</span></footer>
      </blockquote>
      <blockquote class="pq-sm reveal reveal-delay-2">
        <p>"Ongoing reorder support means I always stay competitive. 12 orders and counting."</p>
        <footer><span>🇲🇽 Mexico</span><span class="text-seal">12 reorders &amp; growing</span></footer>
      </blockquote>
      <div class="testi__stat reveal reveal-delay-1">
        <p class="overline overline--avo">Our track record</p>
        <div class="testi__bignum">500<span>+</span></div>
        <p>entrepreneurs served across 30+ countries in Africa, Latin America, and Southeast Asia.</p>
        <a href="/about" class="btn btn-outline" style="margin-top:var(--s5);border-color:rgba(186,209,133,.4);color:rgba(255,255,255,.85);">Our Story →</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ WHY — 刊边批注编号列表 ═══ -->
<section class="section why bg-parchment">
  <div class="container why__grid">
    <div class="why__left reveal">
      <p class="overline">Why CrossPals</p>
      <h2>We Solved the Hard Parts<br/><em>So You Don't Have To</em></h2>
      <div class="divider" style="margin:var(--s6) 0;"></div>
      <p style="font-size:16px;line-height:1.8;">Most entrepreneurs fail at China sourcing because of language barriers, payment risk, and quality uncertainty. CrossPals eliminates all three.</p>
      <ImgPlaceholder seed={15} width={560} height={420} ratio="4/3" alt="CrossPals team" hint="团队合影/中国市场实景/创始人工作照" />
      <a href="/contact" class="btn btn-primary" style="margin-top:var(--s6);">
        Start for Free
        <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
      </a>
    </div>

    <div class="why__right">
      {whyItems.map((w, i) => (
        <div class:list={['why-item reveal', `reveal-delay-${i}`]}>
          <span class="indexnum why-item__n">{w.n}</span>
          <div class="why-item__body">
            <h4>{w.title}</h4>
            <p>{w.body}</p>
            <p class="sidenote why-item__note">CrossPals standard — applies to every order, not just the big ones.</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ BLOG — 杂志目录式 ═══ -->
<section class="section blog-prev">
  <div class="container">
    <div class="blog-prev__head reveal">
      <div>
        <p class="overline">Resources</p>
        <h2>Sourcing<br/><em>Knowledge Base</em></h2>
      </div>
      <a href="/blog" class="btn btn-outline">All Articles →</a>
    </div>

    <div class="blog-prev__grid">
      <a href={`/blog/${blogPosts[0].slug}`} class="bcard bcard--feat reveal">
        <ImgPlaceholder seed={blogPosts[0].seed} width={720} height={460} ratio="16/10" alt={blogPosts[0].title} hint={blogPosts[0].hint} />
        <div class="bcard__body">
          <span class="bcard__cat">{blogPosts[0].cat}</span>
          <h3>{blogPosts[0].title}</h3>
          <div class="bcard__foot">
            <div class="bcard__time"><Icon name="clock" size={12} color="var(--warm-400)" /><span>{blogPosts[0].time} read</span></div>
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </div>
        </div>
      </a>

      <div class="blog-prev__side">
        {blogPosts.slice(1).map((post, i) => (
          <a href={`/blog/${post.slug}`} class:list={['bcard bcard--sm reveal', `reveal-delay-${i + 1}`]}>
            <ImgPlaceholder seed={post.seed} width={320} height={200} ratio="16/10" alt={post.title} hint={post.hint} />
            <div class="bcard__body">
              <span class="bcard__cat">{post.cat}</span>
              <h4>{post.title}</h4>
              <div class="bcard__foot">
                <div class="bcard__time"><Icon name="clock" size={12} color="var(--warm-400)" /><span>{post.time} read</span></div>
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ═══ FINAL CTA — 盖章 manifesto ═══ -->
<section class="cta-final grain" style="position:relative;overflow:hidden;">
  <div class="container cta-final__inner">
    <div class="cta-final__text reveal">
      <span class="seal cta-final__seal" aria-hidden="true"><span>Ready</span><span>48h</span></span>
      <p class="overline overline--light">Ready?</p>
      <h2 class="text-white" style="margin:var(--s3) 0 var(--s4);font-size:clamp(30px,4.4vw,56px);">
        Your First Supplier<br/><em style="color:var(--avo-300)">Is 48 Hours Away</em>
      </h2>
      <p class="text-light" style="max-width:400px;">No commitment. No experience needed. Just tell us what you want to source.</p>
    </div>
    <div class="cta-final__form reveal reveal-delay-2">
      <form class="quick-form" action="/contact" method="GET">
        <input type="text" name="product" placeholder="What do you want to source?" required />
        <button type="submit" class="btn btn-primary">
          Get Quotes
          <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
        </button>
      </form>
      <p class="cta-final__note">Or <a href="https://wa.me/yourwhatsapp">chat on WhatsApp</a> · Free, no commitment</p>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* MASTHEAD */
.masthead{background:var(--avo-950);border-bottom:1px solid rgba(255,255,255,.08);}
.masthead__inner{display:flex;align-items:center;gap:var(--s4);padding:10px var(--s5);font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);}
.masthead__rule{flex:1;height:1px;background:rgba(255,255,255,.1);}

/* HERO */
.hero{background:var(--avo-950);min-height:100vh;display:flex;flex-direction:column;}
.hero__grid{display:grid;grid-template-columns:1.05fr 0.95fr;flex:1;min-height:0;}
.hero__left{display:flex;align-items:center;padding:120px var(--s8) var(--s8) var(--s7);}
.hero__left-inner{max-width:560px;}
.hero__title{color:#fff;font-size:clamp(40px,5.4vw,72px);line-height:1.04;margin:var(--s3) 0 var(--s5);font-weight:560;}
.hero__title em{font-style:italic;color:var(--seal);font-weight:400;}
.hero__lead{color:rgba(255,255,255,.62);font-size:17px;line-height:1.75;max-width:460px;margin-bottom:var(--s5);}
.hero__sidenote{font-family:var(--font-mono);font-size:11px;line-height:1.6;color:rgba(255,255,255,.4);border-left:1px solid var(--seal);padding-left:var(--s3);max-width:420px;margin-bottom:var(--s7);}
.hero__actions{display:flex;gap:var(--s3);flex-wrap:wrap;margin-bottom:var(--s7);}
.hero__index{list-style:none;display:flex;flex-wrap:wrap;gap:var(--s5);padding-top:var(--s5);border-top:1px solid rgba(255,255,255,.1);}
.hero__index li{display:flex;align-items:baseline;gap:6px;font-family:var(--font-serif);font-size:15px;color:rgba(255,255,255,.7);}
.hero__index li span{font-family:var(--font-mono);font-size:10px;color:var(--seal);letter-spacing:.08em;}

.hero__right{position:relative;overflow:hidden;display:flex;}
.hero__photo-fill{position:absolute;inset:0;}
.hero__photo-fill :global(.img-ph){height:100%;}
.hero__photo-fill :global(.img-ph__wrap){padding-top:0!important;height:100%;}
.hero__photo-fill :global(img){width:100%;height:100%;object-fit:cover;}
.hero__cap{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:var(--s4);padding:var(--s4) var(--s5);background:linear-gradient(0deg,rgba(28,33,20,.9),transparent);}
.hero__cap-label{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--avo-300);}
.hero__cap-text{font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:rgba(255,255,255,.7);text-transform:uppercase;flex:1;}
.hero__cap .seal{transform:rotate(-8deg);background:rgba(28,33,20,.4);border-color:var(--seal);color:#fff;backdrop-filter:blur(2px);}

/* SERVICES — 目录式 */
.svc{background:var(--bg-page);}
.svc__wrap{display:grid;grid-template-columns:300px 1fr;gap:var(--s9);align-items:start;}
.svc__aside{position:sticky;top:100px;}
.svc__h em{font-style:italic;color:var(--avo-600);}
.svc__intro{font-size:15px;line-height:1.75;color:var(--text-body);margin:var(--s5) 0;}
.svc__all{font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;color:var(--seal);text-transform:uppercase;}
.svc__list{list-style:none;display:flex;flex-direction:column;}
.svc-row{display:grid;grid-template-columns:64px 200px 1fr;gap:var(--s5);align-items:center;padding:var(--s6) 0;border-top:1px solid var(--border-light);}
.svc-row:last-child{border-bottom:1px solid var(--border-light);}
.svc-row__num .indexnum{font-size:48px;}
.svc-row__thumb :global(.img-ph){border:1px solid var(--border-light);}
.svc-row__top{display:flex;align-items:center;gap:var(--s3);margin-bottom:var(--s2);flex-wrap:wrap;}
.svc-row__body h3{font-size:clamp(20px,2.4vw,28px);}
.svc-row__body p{font-size:14px;line-height:1.7;margin:var(--s2) 0 var(--s4);max-width:520px;}
.svc-row__link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--seal);transition:gap var(--t-fast);}
.svc-row__link:hover{gap:10px;}
.svc-row--featured{background:var(--avo-950);padding:var(--s6);margin:var(--s4) 0;border-top:none;border-bottom:none;}
.svc-row--featured + .svc-row{border-top:none;}
.svc-row--featured .svc-row__body h3{color:#fff;}
.svc-row--featured .svc-row__body p{color:rgba(255,255,255,.62);}
.svc-row--featured .svc-row__num .indexnum{color:var(--avo-300);}
.svc-row--featured .svc-row__thumb :global(.img-ph){border-color:rgba(255,255,255,.15);}

/* HOW IT WORKS — manifest */
.hiw{background:var(--avo-950);}
.hiw__head{margin-bottom:var(--s8);}
.hiw__head h2 em{font-style:italic;color:var(--avo-300);}
.manifest{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.15);position:relative;}
.manifest__col{padding:var(--s6) var(--s5) var(--s7) 0;border-right:1px solid rgba(255,255,255,.08);}
.manifest__day{display:block;font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--seal);margin-bottom:var(--s4);}
.manifest__n{display:block;font-family:var(--font-serif);font-size:64px;font-weight:600;color:rgba(255,255,255,.1);line-height:1;margin-bottom:var(--s3);}
.manifest__title{color:#fff;font-size:19px;margin-bottom:var(--s3);}
.manifest__body{font-size:14px;color:rgba(255,255,255,.5);}
.manifest__stamp{position:absolute;right:0;top:-10px;}
.hiw__cta{display:flex;gap:var(--s4);flex-wrap:wrap;margin-top:var(--s8);}

/* TESTIMONIALS — pull-quote */
.testi{background:var(--warm-100);}
.testi__head{margin-bottom:var(--s7);}
.testi__head h2 em{font-style:italic;color:var(--avo-600);}
.pullquote{position:relative;margin:0 0 var(--s7);padding:var(--s5) 0 var(--s5) var(--s7);border-left:2px solid var(--seal);}
.pullquote__mark{position:absolute;left:-6px;top:-26px;font-family:var(--font-serif);font-size:96px;line-height:1;color:var(--seal);opacity:.25;}
.pullquote p{font-family:var(--font-serif);font-style:italic;font-size:clamp(22px,3vw,34px);line-height:1.4;color:var(--text-primary);max-width:820px;}
.pullquote footer{display:flex;align-items:center;gap:var(--s5);margin-top:var(--s5);flex-wrap:wrap;}
.pullquote__region{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);}
.pullquote__result{font-family:var(--font-mono);font-size:12px;font-weight:500;letter-spacing:.04em;color:var(--seal);}
.testi__row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:var(--s5);}
.pq-sm{margin:0;padding:var(--s5) 0;border-top:1px solid var(--border-light);}
