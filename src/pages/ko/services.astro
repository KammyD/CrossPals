---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';

/* ── 核心服务包（主推产品）：一条龙 ── */
const coreIncludes: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: '공급업체 소싱',   body: '실제 가격을 제공하는 3~5개의 검증된 공급업체 — 견적 전 라이선스, 공장 주소, 수출 이력 확인 완료.' },
  { n: '02', title: '샘플 확인', body: '대량 주문 전 저희가 샘플을 주문하고 귀하의 스펙 및 고객 기대치에 부합하는지 평가합니다.' },
  { n: '03', title: '전수 검사', body: '출하 전 공장에서 진행하는 품질 관리: 외관, 치수, 기능, 포장 및 FBA 라벨 점검.' },
  { n: '04', title: 'FBA 준비',            body: 'FNSKU 라벨 부착, 폴리백 포장, 번들링, 중량 및 크기 측정을 Amazon의 정확한 규격에 맞춰 수행.' },
  { n: '05', title: '물류 조정', body: '항공, 해상 또는 급송 비교; 통관 서류 처리; 실시간 추적 가능한 DDP 도어투도어 서비스.' },
];

/* ── 附加服务：单独可选 ── */
const addOns: Array<{ icon: IconName; title: string; problem: string; process: string; pricing: string; seed: number }> = [
  { icon: 'package', title: '프라이빗 라벨 & 패키지 디자인', seed: 71,
    problem: '귀하의 제품은 일반 수입품이 아닌 브랜드처럼 보여야 하며, 약한 포장은 전환율을 떨어뜨립니다.',
    process: '로고 배치, 박스/백/라벨 아트워크, 삽입 카드 및 패키징 공장과의 MOQ 협상.',
    pricing: '일괄 디자인 비용에 공장 가격의 포장 비용 추가. 일반적 MOQ 300~1,000개.' },
  { icon: 'transparent', title: '제품 사진 촬영', seed: 72,
    problem: 'Amazon은 메인 이미지가 흰 배경 기준을 충족하지 않는 리스팅을 숨기거나 차단합니다.',
    process: 'Amazon 메인 이미지 규격에 맞춘 흰 배경 촬영, 필요 시 라이프스타일 및 인포그래픽 변형 제공.',
    pricing: '이미지당 요금, 대량 할인 가능. SKU당 일괄 요금 제공.' },
  { icon: 'sourcing', title: '1688 구매 대행 서비스', seed: 73,
    problem: '1688에 최저가 상시 존재 — 하지만 사이트는 중국어 전용이며 해외 배송 불가합니다.',
    process: '제품 링크나 사진을 보내주세요. 저희가 1688 판매자로부터 구매하고 검수, 통합 후 배송해 드립니다.',
    pricing: '소액 최저 주문비용이 포함된 주문 금액의 일정 비율. 중국어 불필요.' },
  { icon: 'shipping', title: '창고 보관 및 중계 배송', seed: 74,
    problem: '여러 공급업체에서 구매하면 여러 건의 국제 운송료가 발생하고 상품 검수는 누구도 하지 않습니다.',
    process: '저희 창고에서 여러 주문건을 수령, 검수, 재포장 후 단일 배송으로 통합합니다.',
    pricing: '1일 1m³당 보관료 및 주문당 통합 수수료.' },
];

const svcImg: Record<number,string> = {71:'blog-packaging',72:'blog-products',73:'sourcing-1688',74:'shipping'};
const steps: Array<{ day: string; title: string; body: string }> = [
  { day: '1일차',    title: '제품 등록',    body: '문의 양식을 통해 제품 상세 정보, 수량, 품질 기준 및 예산을 제출해 주세요.' },
  { day: '2일차',    title: '공급업체 옵션 제공',   body: '견적과 프로필이 포함된 검증된 3~5개 공급업체를 검토할 수 있도록 안내드립니다.' },
  { day: '3~5일차',  title: '샘플 검수 및 협상',       body: '샘플 확인 후 중국어로 조건 협의, PO 발행 및 안전하게 예금을 진행합니다.' },
  { day: '7~20일차', title: '생산 및 검수',    body: '상품 제작 완료 후 출고 전 전체 배치 검수 및 QC 사진 리포트 제공.' },
  { day: '21일차 이후',  title: 'FBA 준비 완료, 배송',       body: '상품은 중국에서 아마존 규격에 따라 라벨링 및 포장되어 통관 후 실시간 추적이 가능한 상태로 출발합니다.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: '에이전트 수수료',  value: '주문 금액의 5~8%', note: '10,000달러 주문 시 600달러 에이전트 수수료' },
  { label: '검수', value: '150달러 / 일',          note: '대부분 주문은 반나절 내 완료' },
  { label: 'FBA 준비',   value: '개당',            note: '견적서에 항목별로 상세히 기재' },
  { label: '화물 운송',    value: '운송사 견적 기준',    note: '운송사 가격 외 추가 비용 없음' },
];

const faqs = [
  { q: 'FBA 조달 및 검수 패키지에는 무엇이 포함되나요?', a: '공급업체 조달, 샘플 확인, 전량 검수, FBA 준비(라벨링, 백 포장, 무게 및 크기 측정), 화물 조정까지 — 한 명의 책임 에이전트, 한 번의 견적.' },
  { q: '서비스 수수료는 얼마인가요?',                            a: '에이전트 수수료는 주문 금액의 5~8%입니다. 검수는 150달러/일(대부분 반나절 소요). FBA 준비는 개당 청구됩니다. 모든 비용은 최종 확인 전 견적서에 상세히 명시됩니다.' },
  { q: '최소 주문 규정이 있나요?',                         a: '엄격한 최소 주문량은 없으나, 300달러 이상 주문 시 최적의 서비스를 제공합니다. 소량 주문은 공급업체 선택지가 제한될 수 있습니다.' },
  { q: '검수에 불합격하면 어떻게 되나요?',                           a: '공급업체와 협력하여 선적 전에 재가공, 교체 또는 환불 등의 해결 방안을 마련합니다. 귀하의 승인 없이는 최종 결제를 진행하지 않습니다.' },
  { q: 'FBA 준비 및 라벨링도 처리해 주시나요?',                    a: '예, Amazon 규격에 따른 FNSKU 라벨, 폴리백 포장, 번들링, 카톤 라벨, 중량 및 치수 측정을 수행하여 출하 물품이 처음부터 수검에 통과되도록 합니다.' },
  { q: '로고가 있는 맞춤형 패키징도 가능한가요?',                 a: '예, 저희의 프라이빗 라벨 & 패키징 추가 서비스를 이용하실 수 있습니다. 박스, 봉투, 라벨, 행택 등이 포함되며 최소 주문량(MOQ)은 공급업체에 따라 일반적으로 300~1,000개입니다.' },
];

/* ── Our Guarantees, in full ──
   首页只给「承诺」（结果）；这里把四个承诺各自展开：流程（几步/每步多久）+ 具体标准（清单）+ 失败兜底。
   图片刻意不用首页那四张（factory/inspection/payment/shipping），四张统一 1024×1280、统一 ratio="4/5"。 */
type GuaranteeModule = {
  icon: IconName; n: string; title: string; promise: string;
  img: string; alt: string;
  steps: Array<{ t: string; time: string; d: string }>;
  checksLabel: string;
  checks: Array<{ k: string; v: string }>;
  fail: string;
};
const guaranteeModules: GuaranteeModule[] = [
  {
    icon: 'trust', n: '01', title: '검증된 공급업체만',
    promise: '한 푼도 지불하기 전에 모든 공급업체를 심사합니다.',
    img: '/img/g-market.webp', alt: '도매 시장을 직접 방문하여 공급업체를 현장 심사',
    steps: [
      { t: '후보 선정', time: '1~2일차', d: '당사 네트워크 내 공장 및 1688에서 귀하의 제품 사양에 맞는 3~5개의 후보 업체를 선정합니다.' },
      { t: '서류 확인', time: '2~3일차', d: '사업자등록증, 등록 주소, 생산 능력, 수출 실적 등을 확인하며, 이는 판매 페이지가 아닌 공장 자체를 대상으로 진행됩니다.' },
      { t: '실시간 공장 투어', time: '3~5일차', d: '작업장을 통한 화상 통화: 실제 생산 라인, 재고 및 샘플을 확인합니다.' },
    ],
    checksLabel: '검증 항목',
    checks: [
      { k: '면허 및 법인 자격', v: '귀하의 송장에 표시될 이름과 일치하는 사업자등록증' },
      { k: '주소 vs. 작업장', v: '등록된 주소는 실제 제품이 생산되는 장소와 교차 확인됩니다.' },
      { k: '생산능력 및 리드타임', v: '귀사의 주문량, 기한, 재주문 요건을 수용할 수 있는지 여부.' },
      { k: '수출 이력', v: '과거 선적 내역 및 기존 해외 고객사 — 현재 누구에게 판매 중인지.' },
      { k: '실시간 생산 라인', v: '귀하의 계좌에서 돈이 나가기 전에 영상으로 확인 가능.' },
    ],
    fail: '공장이 서류 확인을 통과하지 못하거나 실시간 현장 검사를 거부할 경우 견적 단계에서 제외됩니다. 저희가 계속 찾아드립니다.',
  },
  {
    icon: 'inspection', n: '02', title: '출고 전 QC',
    promise: '자금 이동 전 제공되는 사진 보고서 + 합격/불합격 결과.',
    img: '/img/g-production.webp', alt: '출하 전 생산 현장에서 검사원이 제품 점검 중',
    steps: [
      { t: '검사 예약', time: '생산 마감 전날', d: '선적일이 아닌 생산 완료일 기준으로 계획 — 아직 수정할 시간이 남아있습니다.' },
      { t: '현장 전체 검사', time: '보통 반일 소요', d: '공장에 직접 서서 제품을 세고, 측정하고, 테스트하며, 직접 촬영합니다.' },
      { t: '보고서 & 검사 결과', time: '당일 제공', d: '사진 보고서와 함께 합격/불합격 결과, 결함 수, 사용된 샘플링 표준이 명확하게 제공됩니다.' },
      { t: '재작업 또는 교체', time: '3~7일', d: '불합격 시 즉시 공급업체로 반환되어 재작업 또는 교체가 이루어지며, 포장 전에 다시 검사합니다.' },
    ],
    checksLabel: '검사 항목',
    checks: [
      { k: '외관', v: '승인된 샘플 대비 표면, 색상, 마감, 스티치, 인쇄 및 가시적 손상 여부 확인' },
      { k: '치수', v: '규격 대비 무게 및 측정값 확인, 허용 오차를 벗어난 단위는 개별 표시됨' },
      { k: '기능', v: '고객이 사용하는 방식과 동일하게 샘플링된 모든 제품의 전원 켜기, 조립 및 사용 테스트' },
      { k: '포장', v: '소매용 박스, 폴리백, 질식 경고 표시, 삽입물 및 카톤 강도 확인' },
      { k: 'FBA 라벨', v: 'FNSKU 바코드 스캔 가능 여부, 카톤 라벨 정확성, 아마존 규격에 따른 무게 및 치수 확인' },
    ],
    fail: '배치가 불합격할 경우 출고되지 않습니다. 공급업체가 재작업하거나 교체한 후 합격할 때까지 귀사의 잔액은 당사에 보관됩니다.',
  },
  {
    icon: 'payment', n: '03', title: '결제 보호',
    promise: '각 마일스톤이 완료될 때까지 자금을 보유합니다. 낯선 업체로의 송금 없음.',
    img: '/img/payment-escrow.webp', alt: '밀봉된 카톤에 대해 각 마일스톤이 완료될 때까지 자금 보유',
    steps: [
      { t: '마일스톤이 명시된 발주서 작성', time: '1일차', d: '보증금, 생산, 검사 및 배송은 시작 전에 별도의 출금 포인트로 고정됩니다.' },
      { t: '보증금 출금', time: '1–2일차', d: '합의된 보증금만 출금되며, 서면으로 PO를 승인한 후에만 진행됩니다.' },
      { t: '검사 게이트', time: 'QC 진행 중', d: '검사 보고서가 합격으로 돌아올 때까지 생산 잔액은 출금되지 않습니다.' },
      { t: '최종 결제', time: '서명 완료 시', d: '승인 후 잔액이 정산되며, 청구서에 서면 영수증이 제공됩니다.' },
    ],
    checksLabel: '자금 보관 방식',
    checks: [
      { k: '모든 출금 승인 권한', v: '해당 단계에서 서면 승인 없이는 결제가 진행되지 않습니다.' },
      { k: '공급업체 우리가 지급', v: '우리가 직접 공장에 지급 — 알 수 없는 계좌로 절대 송금하지 않습니다.' },
      { k: '개인 계좌 불가', v: '자금이 개인 은행 계좌나 제3자 지갑으로 절대 이체되지 않습니다.' },
      { k: '전액 선불 없음', v: '공급업체든 우리든 누구도 100% 선불을 받지 않습니다.' },
      { k: '모든 이체에 대한 영수증', v: '모든 배송은 주문에 따라 문서화되고 상세 항목화됩니다.' },
    ],
    fail: '마일스톤이 충족되지 않으면 주문을 중단하고 돈은 고객님께 남아있습니다. 진행되지 않은 작업에 대해서는 아무도 지급을 받지 않습니다.',
  },
  {
    icon: 'shipping', n: '04', title: 'DDP 문 앞 배송',
    promise: '추적과 상품 — 문서 작업이 아닙니다.',
    img: '/img/g-packing.webp', alt: '문 앞 배송을 위해 밀봉되고 라벨이 부착된 카톤',
    steps: [
      { t: '예약 및 통합', time: '1–2일', d: '운송사를 선택하고 공간을 예약하며 카톤을 단일 출하로 통합합니다.' },
      { t: '수출 및 서류', time: '2–3일', d: '수출 신고서, 포장 목록 및 상업 송장 — 당사에서 준비 및 제출합니다.' },
      { t: '운송 및 수입', time: '항공 5–8일 · 해상 25–35일', d: 'DDP에 따른 관세 및 통관 절차를 거친 항공 또는 해상 운송으로 고객님께 부담되는 것은 없습니다.' },
      { t: '문 앞 배송', time: '1–3일', d: '주소지까지의 마지막 마일 또는 아마존으로 직접 배송, 종단 간 추적됩니다.' },
    ],
    checksLabel: '포함 사항',
    checks: [
      { k: '문간 DDP 서비스', v: '공장 출고부터 문앞까지 하나의 가격 — 갑작스러운 관세 청구서 없음' },
      { k: '관세 및 세금', v: '견적에 포함되어 있으며 별도로 항목화되어 확인할 수 있습니다.' },
      { k: '실시간 추적', v: '출발부터 배송까지 사용 가능한 추적 번호.' },
      { k: '포장 목록 및 송장', v: '아마존과 포워더가 요청하는 서류.' },
      { k: 'FBA 또는 귀하의 주소', v: '아마존 창고 또는 귀하에게 배송 — 예약 시 선택 가능.' },
    ],
    fail: '화물이 지연, 보류 또는 분실된 경우, 우리가 운송업체를 추적하고 클레임을 제출합니다. 서류 작업은 우리가 처리하며 귀하의 일이 아닙니다.',
  },
];
---
<BaseLayout title="Services" description="FBA 조달 및 검수 — 공급업체 선정, 샘플 확인, 전체 배치 검사, FBA 준비 및 화물 조정, 프라이빗 라벨, 사진, 1688 및 창고 보관과 같은 추가 서비스. 투명한 가격." ogImage="/img/case-relabel.webp" lang="ko">

  <PageHero
    overline="우리가 하는 일"
    title="FBA 공급<br/><em style='font-style:italic;color:var(--avo-300)'>및 품질 검사</em>"
    subtitle="공급업체 검색부터 Amazon 출고 준비까지 제공하는 통합 패키지. 필요 시 프라이빗 라벨링, 제품 촬영, 1688 구매 대행 또는 창고 보관과 같은 추가 서비스도 이용 가능합니다."
  />

  <!-- ═══ 核心服务包 ═══ -->
  <section class="section">
    <div class="container">
      <div class="core reveal">
        <div class="core__aside">
          <span class="tag tag-seal">메인 패키지</span>
          <h2>FBA 소싱<br/><em>&amp; 검수</em></h2>
          <p class="core__lead">각 FBA 판매자를 위한 올인원 패키지. '이 제품을 판매하고 싶다'는 아이디어부터 아마존 라벨 부착, 검수 완료된 출고 준비 박스까지 모든 과정을 단일 에이전트가 관리합니다.</p>
          <div class="core__price">
            <span class="core__price-label">가격 책정 방식</span>
            <p>에이전트 수수료 5-8% · 검수 $150/일 · FBA 준비 단위당 비용 — 모든 것이 하나의 견적서에 명시됩니다.</p>
          </div>
          <a href="/ko/contact" class="btn btn-primary">무료 견적 받기<svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
        </div>

        <ol class="core__list">
          {coreIncludes.map((c, i) => (
            <li class:list={['core-step reveal', `reveal-delay-${i}`]}>
              <span class="core-step__n">{c.n}</span>
              <div>
                <h4>{c.title}</h4>
                <p>{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- $1,000 订单说明 -->
      <div class="price-example price-example--inline reveal">
        <p class="price-example__title">실제 사례 — $1,000 규모 주문</p>
        <div class="price-example__rows">
          <div class="price-example__row"><span>공급가(상품 원가)</span><span>$1,000</span></div>
          <div class="price-example__row"><span>에이전트 수수료(8%)</span><span>$80</span></div>
          <div class="price-example__row"><span>Freight</span><span>실제 견적서 포함</span></div>
          <div class="price-example__row price-example__row--total"><span>총 비용</span><span>숨겨진 비용 없음</span></div>
        </div>
        <p class="price-example__foot">공급가 + 에이전트 수수료 + 운송비 = 당신이 지불할 전액입니다. 추가 비용 없습니다.</p>
      </div>
    </div>
  </section>

  <!-- ═══ 附加服务 ═══ -->
  <section class="section bg-parchment">
    <div class="container">
      <div class="add-head reveal">
        <p class="overline">추가 서비스</p>
        <h2>선택 옵션<br/><em>필요 시 제공</em></h2>
        <p class="add-lead">각 추가 서비스는 특정 문제를 해결합니다. 개별 선택 또는 메인 패키지에 추가 가능합니다.</p>
      </div>

      <div class="addons">
        {addOns.map((a, i) => (
          <article class:list={['addon reveal', `reveal-delay-${i}`]}>
            <div class="addon__media">
              <ImgPlaceholder src={'/img/'+svcImg[a.seed]+'.webp'} seed={a.seed} width={520} height={390} ratio="4/3" alt={a.title} />
            </div>
            <div class="addon__body">
              <span class="addon__icon"><Icon name={a.icon} size={24} color="var(--seal)" /></span>
              <h3>{a.title}</h3>
              <dl class="addon__rows">
                <div><dt>해결 문제</dt><dd>{a.problem}</dd></div>
                <div><dt>서비스 내용</dt><dd>{a.process}</dd></div>
                <div><dt>가격 책정 방법</dt><dd>{a.pricing}</dd></div>
              </dl>
              <a href="/ko/contact" class="addon__link">이것에 대해 질문하기<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Process — ledger 时间线 ═══ -->
  <section class="section">
    <div class="container">
      <div class="tl-head reveal">
        <p class="overline">저희 과정</p>
        <h2>전형적인 주문은 어떻게 이루어지나요?<br/><em>Flows</em></h2>
      </div>
      <ol class="ledger-list">
        {steps.map((step, i) => (
          <li class:list={['ledger-item reveal', `reveal-delay-${Math.min(i, 3)}`]}>
            <span class="ledger-item__day">{step.day}</span>
            <span class="ledger-item__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="ledger-item__body">
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 独立定价区块 ═══ -->
  <section class="section bg-parchment">
    <div class="container pricing__wrap">
      <div class="pricing__intro reveal">
        <p class="overline">투명한 가격</p>
        <h2>"가격 문의" 같은 것 없음<br/><em>모든 주문은 1달러도 쓰기 전에 항목별로 견적이 제공됩니다. 완전히 투명한 요금 구조를 확인하세요.</em></h2>
        <p class="pricing__lead">저희 보증, 모두 공개</p>
      </div>

      <div class="pricing__right">
        <ul class="pricetable reveal reveal-delay-1">
          {pricingFees.map(f => (
            <li>
              <span class="pricetable__label">{f.label}</span>
              <span class="pricetable__value">{f.value}</span>
              <span class="pricetable__note">{f.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ Our Guarantees, in full —— 四个承诺各自展开（流程 / 标准 / 失败兜底） ═══ -->
  <section class="section--tight" id="guarantees">
    <div class="container">
      <div class="guar-head reveal">
        <p class="overline">각 약속의 진짜 의미</p>
        <h2>홈페이지에 약속이 나와 있습니다. 여기 그 이면의 시스템이 있습니다: 단계별 프로세스, 각 단계 소요 시간, 저희가 유지하는 정확한 기준, 문제 발생 시 대처 방법.<br/><em>작동 방식</em></h2>
        <p class="guar-lead">문제 발생 시</p>
      </div>

      <div class="gmods">
        {guaranteeModules.map((m, i) => (
          <article class:list={['gmod reveal', i % 2 === 1 && 'gmod--flip']}>
            <div class="gmod__media">
              <ImgPlaceholder class="gmod__img" src={m.img} seed={700 + i} width={640} height={800} ratio="4/5" alt={m.alt} />
              <span class="gmod__n">{m.n}</span>
            </div>

            <div class="gmod__body">
              <span class="gmod__icon"><Icon name={m.icon} size={24} color="var(--seal)" /></span>
              <h3>{m.title}</h3>
              <p class="gmod__promise">{m.promise}</p>

              <div class="gmod__cols">
                <div class="gmod__col">
                  <h4 class="gmod__label">첫 주문 준비 완료?</h4>
                  <ol class="gmod__steps">
                    {m.steps.map((s, j) => (
                      <li>
                        <span class="gmod__step-n">{String(j + 1).padStart(2, '0')}</span>
                        <div>
                          <span class="gmod__step-t">{s.t}</span>
                          <span class="gmod__step-time">{s.time}</span>
                          <p>{s.d}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="gmod__col">
                  <h4 class="gmod__label">{m.checksLabel}</h4>
                  <ul class="gmod__checks">
                    {m.checks.map(c => (
                      <li>
                        <span class="gmod__check-k">{c.k}</span>
                        <span class="gmod__check-v">{c.v}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <p class="gmod__fail"><span class="gmod__fail-tag">상품을 보내주시면 48시간 내에 검증된 공급업체 옵션과 전체 가격 내역을 받아보실 수 있습니다.</span>{m.fail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="faq-head reveal">
        <p class="overline">FAQ</p>
        <h2>Common<br/><em>Questions</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class:list={['faq-item reveal', `reveal-delay-${i % 3}`]}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <span class="seal cta-seal" aria-hidden="true"><span>Start</span><span>Now</span></span>
      <p class="overline overline--light reveal">Empezar</p>
      <h2 style="color:#fff;margin-bottom:var(--s4);" class="reveal reveal-delay-1">무료 견적 받기<br/><em style="color:var(--avo-300)">FBA 조달 및 검수 — 공급업체 선정, 샘플 확인, 전체 로트 검수, FBA 준비 및 화물 조정, 프라이빗 라벨링, 사진 촬영, 1688, 창고 보관 등 추가 서비스. 투명한 가격.</em>
      </h2>
      <p style="color:rgba(255,255,255,.6);max-width:420px;margin:0 auto var(--s6);" class="reveal reveal-delay-2">저희가 하는 일</p>
      <a href="/ko/contact" class="btn btn-primary reveal reveal-delay-3">무료 견적 받기<svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  h2 em { font-style:italic; color:var(--avo-600); }

  /* ── 核心服务包 ── */
  .core{display:grid;grid-template-columns:0.9fr 1.1fr;gap:var(--s7);align-items:start;padding-bottom:var(--s6);border-bottom:1px solid var(--border-light);}
  .core__aside{position:sticky;top:100px;}
  .core__aside h2{font-size:clamp(28px,3.6vw,42px);line-height:1.1;margin:var(--s4) 0;}
  .core__lead{font-size:15.5px;line-height:1.72;color:var(--text-body);max-width:440px;}
  .core__price{margin:var(--s5) 0;padding:var(--s4) var(--s5);background:var(--bg-page);border-left:2px solid var(--seal);}
  .core__price-label{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--seal);}
  .core__price p{font-size:14px;line-height:1.6;color:var(--text-body);margin-top:6px;}
  .core__list{list-style:none;display:flex;flex-direction:column;border-top:1px solid var(--border-mid);}
  .core-step{display:grid;grid-template-columns:56px 1fr;gap:var(--s4);padding:var(--s4) 0;border-bottom:1px solid var(--border-light);}
  .core-step__n{font-family:var(--font-mono);font-size:13px;font-weight:600;letter-spacing:.08em;color:var(--seal);padding-top:3px;}
  .core-step h4{font-size:17px;margin-bottom:5px;}
  .core-step p{font-size:14px;line-height:1.65;color:var(--text-body);}

  /* $1,000 示例 */
  .price-example{margin-top:var(--s6);background:var(--avo-950);padding:var(--s5) var(--s6);border-left:2px solid var(--seal);}
  .price-example--inline{max-width:760px;margin-left:auto;margin-right:auto;}
  .price-example__title{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--avo-300);margin-bottom:var(--s4);}
  .price-example__rows{display:flex;flex-direction:column;}
  .price-example__row{display:flex;justify-content:space-between;gap:var(--s4);padding:10px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:14.5px;color:rgba(255,255,255,.7);}
  .price-example__row span:last-child{font-family:var(--font-mono);color:#fff;}
  .price-example__row--total{border-bottom:none;padding-top:var(--s4);margin-top:var(--s2);border-top:2px solid var(--seal);}
  .price-example__row--total span{color:#fff;font-weight:600;}
  .price-example__row--total span:last-child{color:var(--avo-300);}
  .price-example__foot{margin-top:var(--s4);font-size:13px;color:rgba(255,255,255,.5);}

  /* ── 附加服务 ── */
  .add-head{margin-bottom:var(--head-gap);max-width:680px;}
  .add-lead{font-size:15.5px;line-height:1.7;color:var(--text-muted);margin-top:var(--s4);}
  .addons{display:grid;grid-template-columns:1fr 1fr;gap:var(--s6);}
  .addon{display:flex;flex-direction:column;background:var(--bg-surface);border:1px solid var(--border-light);}
  .addon__media :global(.img-ph){border-bottom:1px solid var(--border-light);}
  .addon__body{padding:var(--s5);display:flex;flex-direction:column;gap:var(--s3);flex:1;}
  .addon__icon{color:var(--seal);}
  .addon h3{font-size:clamp(18px,2vw,22px);}
  .addon__rows{display:flex;flex-direction:column;gap:var(--s3);margin-top:var(--s2);flex:1;}
  .addon__rows dt{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--seal);margin-bottom:4px;}
  .addon__rows dd{font-size:13.5px;line-height:1.62;color:var(--text-body);}
  .addon__link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--seal);transition:gap var(--t-fast);margin-top:var(--s3);}
  .addon__link:hover{gap:10px;}

  .guar-head { margin-bottom:var(--head-gap); }
  .guar-head h2 em { font-style:italic; color:var(--avo-600); }
  .guar-lead { font-size:15.5px; line-height:1.72; color:var(--text-muted); margin-top:var(--s4); max-width:620px; }

  /* ── Our Guarantees, in full：四个展开模块 ── */
  .gmods { display:flex; flex-direction:column; }
  .gmod { display:grid; grid-template-columns:320px 1fr; gap:var(--s7); align-items:start; padding:var(--s7) 0; border-top:1px solid var(--border-light); }
  .gmod:first-child { border-top:2px solid var(--seal); }
  .gmod--flip { grid-template-columns:1fr 320px; }
  .gmod--flip .gmod__media { order:2; }
  .gmod__media { position:relative; }
  .gmod__media :global(figure.img-ph) { border:1px solid var(--border-light); }
  .gmod__n { position:absolute; top:-9px; left:-9px; z-index:1; background:var(--seal); color:#fff; font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:.08em; line-height:1; padding:5px 7px; }
  .gmod__body { display:flex; flex-direction:column; min-width:0; }
  .gmod__icon { color:var(--seal); display:flex; margin-bottom:var(--s3); }
  .gmod h3 { font-size:clamp(20px,2.4vw,26px); margin-bottom:var(--s3); }
  .gmod__promise { font-family:var(--font-serif); font-style:italic; font-size:16.5px; line-height:1.5; color:var(--avo-700); border-left:2px solid var(--seal); padding-left:var(--s4); margin-bottom:var(--s5); }
  .gmod__cols { display:grid; grid-template-columns:1fr 1fr; gap:var(--s6); }
  .gmod__label { font-family:var(--font-mono); font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--seal); padding-bottom:var(--s3); border-bottom:1px solid var(--border-mid); margin-bottom:var(--s2); }

  .gmod__steps { list-style:none; display:flex; flex-direction:column; }
  .gmod__steps li { display:grid; grid-template-columns:26px 1fr; gap:var(--s3); padding:var(--s3) 0; border-bottom:1px solid var(--border-light); }
  .gmod__steps li:last-child { border-bottom:none; padding-bottom:0; }
  .gmod__step-n { font-family:var(--font-mono); font-size:11px; font-weight:600; color:var(--avo-300); padding-top:3px; }
  .gmod__step-t { display:block; font-size:14.5px; font-weight:600; color:var(--text-primary); }
  .gmod__step-time { display:inline-block; font-family:var(--font-mono); font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--seal); margin:3px 0 5px; }
  .gmod__steps p { font-size:13px; line-height:1.6; color:var(--text-muted); }

  .gmod__checks { list-style:none; display:flex; flex-direction:column; }
  .gmod__checks li { position:relative; padding:var(--s3) 0 var(--s3) 20px; border-bottom:1px solid var(--border-light); }
  .gmod__checks li:last-child { border-bottom:none; padding-bottom:0; }
  .gmod__checks li::before { content:'✓'; position:absolute; left:0; top:calc(var(--s3) + 1px); font-size:12px; line-height:1; color:var(--seal); }
  .gmod__check-k { display:block; font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--avo-800); }
  .gmod__check-v { display:block; font-size:13px; line-height:1.6; color:var(--text-muted); margin-top:3px; }

  .gmod__fail { margin-top:var(--s5); background:var(--bg-page); border-left:2px solid var(--seal); padding:var(--s4) var(--s5); font-size:13.5px; line-height:1.62; color:var(--text-body); }
  .gmod__fail-tag { display:block; font-family:var(--font-mono); font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--seal); margin-bottom:5px; }

  /* ── 定价区块 ── */
  .pricing__wrap{display:grid;grid-template-columns:0.85fr 1.15fr;gap:var(--s7);align-items:start;}
  .pricing__lead{font-size:15px;line-height:1.7;color:var(--text-muted);margin-top:var(--s4);max-width:400px;}
  .pricetable{list-style:none;display:flex;flex-direction:column;border-top:2px solid var(--seal);}
