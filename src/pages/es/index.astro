---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { PHONE } from '../../config/site';

const services: Array<{ icon: IconName; n: string; title: string; body: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',   n: '01', title: 'Búsqueda de Productos', body: 'Buscamos entre miles de proveedores chinos para encontrar la mejor opción según tu presupuesto y estándares de calidad.', seed: 10, hint: '义乌商品城/供应商展会', delay: 0 },
  { icon: 'inspection', n: '02', title: 'Inspección de Calidad', body: 'Inspección física en fábrica antes del envío. Informe fotográfico y veredicto claro antes de aprobar el embarque.', seed: 20, hint: '质检员工作照/工厂', delay: 1, featured: true },
  { icon: 'payment',    n: '03', title: 'Compra y Pago',         body: 'Negociamos en chino y gestionamos todos los pagos a proveedores verificados. Tu dinero está protegido en cada paso.', seed: 30, hint: '签约/握手/合同', delay: 2 },
  { icon: 'shipping',   n: '04', title: 'Envío y Logística',     body: 'Entrega puerta a puerta en todo el mundo. Comparamos opciones de flete y gestionamos la documentación aduanera.', seed: 40, hint: '集装箱港口/货运', delay: 3 },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Día 1',    title: 'Envías tu solicitud',      body: 'Cuéntanos el tipo de producto, cantidad, requisitos y presupuesto en nuestro formulario.' },
  { day: 'Día 2',    title: 'Opciones de proveedores',  body: '3–5 proveedores verificados con precios y perfiles, en tu bandeja en 48 horas.' },
  { day: 'Día 7–20', title: 'Compramos e inspeccionamos', body: 'Pagamos al proveedor, supervisamos la producción y te enviamos el informe QC antes del envío.' },
  { day: 'Día 21+',  title: 'Entregado a tu puerta',    body: 'Los productos salen de China con número de rastreo. Aduanas gestionadas. Tú solo esperas.' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: 'Sin Barrera de Idioma', body: 'Negociamos directamente en chino — obtienes precios de fábrica, no de turista.' },
  { icon: 'trust',        n: '02', title: 'Responsabilidad Real',  body: 'Un agente dedicado gestiona tu pedido. Una persona, no una cola de tickets.' },
  { icon: 'handshake',    n: '03', title: 'Hecho para Principiantes', body: '¿Nunca has importado? Te guiamos paso a paso, de la primera consulta a la primera venta.' },
  { icon: 'transparent',  n: '04', title: 'Costos Transparentes',  body: 'Precio de proveedor + envío + nuestra tarifa. Ves todo antes de comprometerte.' },
];

const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: 'Solo proveedores verificados', body: 'Revisamos licencias, capacidad e historial de exportación antes de cotizar.' },
  { icon: 'inspection', title: 'QC antes del envío',           body: 'Inspección fotografiada con veredicto claro antes de mover dinero.' },
  { icon: 'payment',    title: 'Protección de pago',           body: 'Los fondos se liberan solo al cumplir hitos. Nunca a desconocidos.' },
  { icon: 'shipping',   title: 'Entrega DDP a puerta',         body: 'Aduanas y última milla gestionadas, con rastreo en vivo.' },
];

const blogPosts = [
  { cat: 'Guía de Abastecimiento', title: 'How to Find Reliable Suppliers on 1688 Without Speaking Chinese', slug: 'find-suppliers-1688', time: '5 min', seed: 101, hint: '1688/电商' },
  { cat: 'Envío',                 title: 'Air vs Sea Freight: Which to Choose for Your First Order?',        slug: 'air-vs-sea-freight',  time: '4 min', seed: 102, hint: '货运飞机/码头' },
  { cat: 'Tips de Negocio',       title: '5 Products That Are Cheaper in China and Sell Well Everywhere',    slug: 'cheap-china-products', time: '6 min', seed: 103, hint: '热销商品' },
];

const svcImg: Record<number,string> = {10:'sourcing-1688',20:'inspection',30:'payment',40:'shipping'};
const blogImg: Record<number,string> = {101:'sourcing-1688',102:'shipping',103:'blog-products'};
const guarImg: Record<string,string> = {trust:'factory',inspection:'inspection',payment:'payment',shipping:'shipping'};
const tickerItems = ['Lagos','São Paulo','Ciudad de México','Manila','Nairobi','Bogotá','El Cairo','HeBei · BaoDing → Mundo','Búsqueda 1688','Inspeccionado QC','Envío DDP','Proveedores Verificados'];
---
<BaseLayout title="Abastecimiento Confiable desde China para Emprendedores" description="CrossPals conecta emprendedores globales con proveedores chinos de confianza." lang="es">

<div class="topband">
  <a href="/es/contact" class="announce announce--dark">
    <span class="announce__dot" aria-hidden="true"></span>
    <span><strong>Nuevo:</strong> consulta de abastecimiento gratis para primeros importadores — lista de proveedores en 48h</span>
    <span class="announce__arrow" aria-hidden="true">→</span>
  </a>

  <div class="masthead">
    <div class="container masthead__inner">
      <span>CrossPals · Manual de Abastecimiento</span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span>Edición Nº01 — MMXXVI</span>
    </div>
  </div>
</div>

<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">Tu Socio de Abastecimiento en China</p>
        <h1 class="hero__title">Eliminamos el <em>riesgo</em> de comprar en China.</h1>
        <p class="hero__lead">CrossPals es el agente dedicado entre tu idea y la fábrica — búsqueda, inspección, pago y envío de principio a fin, para que nunca transfieras a un desconocido ni adivines la calidad.</p>
        <p class="hero__sidenote">Fig. 00 — La mayoría de los primeros importadores pierde dinero por barreras idiomáticas, proveedores falsos y envíos a ciegas. Nosotros cerramos las tres.</p>
        <div class="hero__actions">
          <a href="/es/contact" class="btn btn-primary">Cotización Gratis <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg></a>
          <a href="/es/services" class="btn btn-ghost">Cómo Funciona</a>
        </div>
        <ul class="hero__index">
          <li><span>01</span> Búsqueda</li>
          <li><span>02</span> Inspección</li>
          <li><span>03</span> Pago</li>
          <li><span>04</span> Envío</li>
        </ul>
      </div>
    </div>
    <div class="hero__right">
      <div class="hero__photo-fill">
        <ImgPlaceholder src="/img/hero-warehouse.webp" seed={42} width={900} height={1100} ratio="9/11" priority alt="Almacén en China — CrossPals" />
      </div>
      <div class="hero__cap">
        <span class="hero__cap-label">Fig. 01</span>
        <span class="hero__cap-text">HeBei · BaoDing, China</span>
        <span class="seal seal--sm" aria-hidden="true"><span>Verified</span><span>Agent</span></span>
      </div>
    </div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[...tickerItems, ...tickerItems].map(t => <span class="ticker__item">{t}</span>)}
  </div>
</div>

<section class="regionwrap" aria-label="Regiones que atendemos">
  <div class="container">
    <p class="overline" style="margin-bottom:var(--s4);">Con la confianza de emprendedores en</p>
    <div class="regionwall reveal">
      {['Nigeria','Brasil','México','Filipinas','Kenia','Colombia','Egipto','Vietnam','Perú','Ghana','Chile','Indonesia'].map(r => <span>{r}</span>)}
    </div>
  </div>
</section>

<section class="section--tight statband grain" style="position:relative;overflow:hidden;">
  <div class="container statband__grid">
    <div class="reveal">
      <p class="overline statband__overline">En Números</p>
      <div class="statband__nums">
        <div class="statband__num"><b>500<em>+</em></b><span>Emprendedores atendidos</span></div>
        <div class="statband__num"><b>30<em>+</em></b><span>Países alcanzados</span></div>
        <div class="statband__num"><b>48<em>h</em></b><span>Lista de proveedores</span></div>
        <div class="statband__num"><b>0</b><span>Costos ocultos</span></div>
      </div>
    </div>
    <ul class="statband__list reveal reveal-delay-1">
      <li><span><b>Búsqueda</b> en 1688, Alibaba y redes de fábricas directas en HeBei · BaoDing, Guangzhou y Shenzhen.</span></li>
      <li><span><b>Inspección</b> fotografiada y aprobada en fábrica antes de cualquier envío.</span></li>
      <li><span><b>Pago</b> liberado solo a proveedores verificados — nunca a desconocidos.</span></li>
      <li><span><b>Entrega</b> puerta a puerta DDP, aduanas gestionadas y rastreo en vivo.</span></li>
    </ul>
  </div>
</section>

<section class="section svc ledger">
  <div class="container svc__wrap">
    <aside class="svc__aside">
      <p class="overline">Qué Hacemos</p>
      <h2 class="svc__h">Abastecimiento<br/><em>desde China</em></h2>
      <p class="svc__intro">Cuatro disciplinas, un agente responsable. Cada paso se documenta, fotografía y aprueba antes de que tu dinero se mueva.</p>
      <a href="/es/services" class="svc__all">Índice de servicios →</a>
    </aside>
    <ol class="svc__list">
      {services.map(s => (
        <li class:list={['svc-row reveal', `reveal-delay-${s.delay}`]}>
          <div class="svc-row__num"><span class="indexnum">{s.n}</span></div>
          <div class="svc-row__thumb"><ImgPlaceholder src={'/img/'+svcImg[s.seed]+'.webp'} seed={s.seed} width={360} height={240} ratio="3/2" alt={s.title} /></div>
          <div class="svc-row__body">
            <div class="svc-row__top">
              <h3>{s.title}</h3>
            </div>
            <div class="lede-row">
              <p>{s.body}</p>
              <a href="/es/services" class="svc-row__link">Más información <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg></a>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section hiw grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="hiw__head reveal">
      <p class="overline overline--light">Proceso</p>
      <h2 class="text-white">De la Idea al Inventario<br/><em style="color:var(--avo-300)">en 4 Pasos</em></h2>
    </div>
    <div class="manifest reveal reveal-delay-1">
      {steps.map((step, i) => (
        <div class:list={['manifest__col', { 'manifest__col--end': i === steps.length - 1 }]}>
          <span class="manifest__day">{step.day}</span>
          <span class="manifest__n">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="manifest__title">{step.title}</h4>
          <p class="manifest__body">{step.body}</p>
        </div>
      ))}
      <div class="manifest__stamp" aria-hidden="true"><span class="seal"><span>Cross</span><span>Pals ✓</span></span></div>
    </div>
    <div class="hiw__cta reveal reveal-delay-2">
      <a href="/es/contact" class="btn btn-primary">Empieza tu Primer Pedido</a>
      <a href="/es/about" class="btn btn-ghost">Conoce al Equipo</a>
    </div>
  </div>
</section>

<section class="section testi">
  <div class="container">
    <div class="testi__head reveal">
      <p class="overline">Casos de Éxito</p>
      <h2>Negocios Reales,<br/><em>Resultados Reales</em></h2>
    </div>
    <blockquote class="pullquote reveal">
      <span class="pullquote__mark" aria-hidden="true">“</span>
      <p>CrossPals encontró un proveedor certificado, gestionó 3 envíos en 6 meses, y ahora tengo una marca real — todo comenzando con $800.</p>
      <footer><span class="pullquote__region">🇧🇷 Brasil · São Paulo</span><span class="pullquote__result">ROI 3× en primer trimestre</span></footer>
    </blockquote>
    <div class="testi__row">
      <blockquote class="pq-sm reveal reveal-delay-1">
        <img class="pq-sm__avatar" src="/img/avatar-nigeria.webp" alt="Cliente de CrossPals en Lagos, Nigeria" loading="lazy" decoding="async" width="56" height="56" />
        <p>"Mi proveedor en HeBei · BaoDing en 48 horas. Fotos QC, envío DHL — nunca salí de Lagos."</p>
        <footer><span>🇳🇬 Nigeria</span><span class="text-seal">40% menos costo</span></footer>
      </blockquote>
      <blockquote class="pq-sm reveal reveal-delay-2">
        <img class="pq-sm__avatar" src="/img/avatar-mexico.webp" alt="Cliente de CrossPals en México" loading="lazy" decoding="async" width="56" height="56" />
        <p>"El soporte de reorden continuo significa que siempre soy competitiva. 12 pedidos y contando."</p>
        <footer><span>🇲🇽 México</span><span class="text-seal">12 reordenes y creciendo</span></footer>
      </blockquote>
      <div class="testi__stat reveal reveal-delay-1">
        <p class="overline overline--avo">Nuestro historial</p>
        <div class="testi__bignum">500<span>+</span></div>
        <p>emprendedores atendidos en 30+ países de África, América Latina y el Sudeste Asiático.</p>
        <a href="/es/about" class="btn btn-outline" style="margin-top:var(--s4);border-color:rgba(186,209,133,.4);color:rgba(255,255,255,.85);">Nuestra Historia →</a>
      </div>
    </div>
  </div>
</section>

<section class="banner-cta banner-cta--dark">
  <div class="container banner-cta__inner">
    <div class="banner-cta__text">
      <span class="banner-cta__eyebrow">Cupos limitados</span>
      <h3 class="banner-cta__head">Consulta de abastecimiento gratis para primeros importadores</h3>
      <span class="banner-cta__note">Sin compromiso · Respuesta en 24h</span>
    </div>
    <a href="/es/contact" class="btn btn-primary">
      Reserva tu cupo
      <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
    </a>
  </div>
</section>

<section class="section why bg-parchment">
  <div class="container why__grid">
    <div class="why__left reveal">
      <p class="overline">Por Qué CrossPals</p>
      <h2>Resolvimos las Partes<br/><em>Difíciles para Ti</em></h2>
      <div class="divider" style="margin:var(--s4) 0;"></div>
      <div class="lede-row">
        <p style="font-size:15px;line-height:1.72;">La mayoría fracasa en el abastecimiento desde China por barreras idiomáticas, riesgo de pago e incertidumbre de calidad. CrossPals elimina las tres.</p>
        <a href="/es/contact" class="btn btn-primary">Empieza Gratis <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg></a>
      </div>
      <ImgPlaceholder src="/img/team-wide.webp" seed={15} width={560} height={420} ratio="4/3" alt="Equipo CrossPals" />
    </div>
    <div class="why__right">
      {whyItems.map((w, i) => (
        <div class:list={['why-item reveal', `reveal-delay-${i}`]}>
          <span class="indexnum why-item__n">{w.n}</span>
          <div class="why-item__body">
            <h4>{w.title}</h4>
            <p>{w.body}</p>
            <p class="sidenote why-item__note">Estándar CrossPals — aplica a cada pedido, no solo a los grandes.</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section blog-prev">
  <div class="container">
    <div class="blog-prev__head reveal">
      <div><p class="overline">Recursos</p><h2>Base de<br/><em>Conocimiento</em></h2></div>
      <a href="/blog" class="btn btn-outline">Todos los Artículos →</a>
    </div>
    <div class="blog-prev__grid">
      {blogPosts.map((post, i) => (
        <a href={`/blog/${post.slug}`} class:list={['bcard', i === 0 ? 'bcard--feat' : 'bcard--sm', 'reveal', `reveal-delay-${i}`]}>
          <ImgPlaceholder
            src={'/img/' + blogImg[post.seed] + '.webp'}
            seed={post.seed}
            width={i === 0 ? 720 : 640}
            height={i === 0 ? 960 : 360}
            ratio={i === 0 ? '3/4' : '16/9'}
            alt={post.title}
          />
          <div class="bcard__body">
            <span class="bcard__cat">{post.cat}</span>
            {i === 0 ? <h3>{post.title}</h3> : <h4>{post.title}</h4>}
            <div class="bcard__foot">
              <div class="bcard__time"><Icon name="clock" size={12} color="var(--warm-400)" /><span>{post.time} lectura</span></div>
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container">
    <div class="guar-head reveal">
      <p class="overline">Nuestras Garantías</p>
      <h2>Lo que Recibes, <em>en Cada Pedido</em></h2>
    </div>
    <div class="guarantee reveal">
      {guarantees.map((g, i) => (
        <div class="guarantee__item">
          <span class="guarantee__n">{String(i + 1).padStart(2, '0')}</span>
          <div class="guarantee__icon"><Icon name={g.icon} size={26} color="var(--seal)" /></div>
          <ImgPlaceholder class="guarantee__img" src={'/img/' + guarImg[g.icon] + '.webp'} seed={600 + i} width={480} height={320} ratio="3/2" alt={g.title} />
          <h4>{g.title}</h4>
          <p>{g.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta-final grain" style="position:relative;overflow:hidden;">
  <div class="container cta-final__inner">
    <div class="cta-final__text reveal">
      <span class="seal cta-final__seal" aria-hidden="true"><span>Listo</span><span>48h</span></span>
      <p class="overline overline--light">¿Listo?</p>
      <h2 class="text-white" style="margin:var(--s3) 0 var(--s4);font-size:clamp(30px,4.4vw,56px);">Tu Primer Proveedor<br/><em style="color:var(--avo-300)">Está a 48 Horas</em></h2>
      <p class="text-light" style="max-width:400px;">Sin compromiso. Sin experiencia. Solo dinos qué quieres importar.</p>
    </div>
    <div class="cta-final__form reveal reveal-delay-2">
      <form class="quick-form" action="/es/contact" method="GET">
        <input type="text" name="product" placeholder="¿Qué quieres importar?" required />
        <button type="submit" class="btn btn-primary">Cotizar <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg></button>
      </form>
      <p class="cta-final__note">O <a href={PHONE.wa}>chatea por WhatsApp</a> · Gratis, sin compromiso</p>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* — Home styles shared with EN (scoped copy) — */
.topband{background:var(--avo-950);padding-top:var(--hdr-h);}
.announce--dark{background:transparent;border-bottom:1px solid rgba(255,255,255,.08);color:rgba(232,229,218,.82);}
.announce--dark strong{color:var(--seal);font-weight:600;}
.announce--dark:hover{background:rgba(255,255,255,.05);}
.announce--dark:hover .announce__arrow{transform:translateX(3px);}
.masthead{background:var(--avo-950);border-bottom:1px solid rgba(255,255,255,.08);}
.masthead__inner{display:flex;align-items:center;gap:var(--s4);padding:10px var(--s5);font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);}
.masthead__rule{flex:1;height:1px;background:rgba(255,255,255,.1);}
.hero{background:var(--avo-950);min-height:min(78vh,680px);display:flex;flex-direction:column;}
.hero__grid{display:grid;grid-template-columns:1.05fr 0.95fr;flex:1;min-height:0;}
.hero__left{display:flex;align-items:center;padding:84px var(--s7) var(--s7) var(--s7);}
.hero__left-inner{max-width:560px;}
.hero__title{color:#fff;font-size:clamp(34px,4.4vw,58px);line-height:1.05;margin:var(--s2) 0 var(--s4);font-weight:560;}
.hero__title em{font-style:italic;color:var(--seal);font-weight:400;}
.hero__lead{color:rgba(255,255,255,.62);font-size:16px;line-height:1.7;max-width:460px;margin-bottom:var(--s4);}
.hero__sidenote{font-family:var(--font-mono);font-size:11px;line-height:1.6;color:rgba(255,255,255,.4);border-left:1px solid var(--seal);padding-left:var(--s3);max-width:420px;margin-bottom:var(--s5);}
.hero__actions{display:flex;gap:var(--s3);flex-wrap:wrap;margin-bottom:var(--s5);}
.hero__index{list-style:none;display:flex;flex-wrap:wrap;gap:var(--s5);padding-top:var(--s4);border-top:1px solid rgba(255,255,255,.1);}
.hero__index li{display:flex;align-items:baseline;gap:6px;font-family:var(--font-serif);font-size:15px;color:rgba(255,255,255,.7);}
.hero__index li span{font-family:var(--font-mono);font-size:10px;color:var(--seal);letter-spacing:.08em;}
.hero__right{position:relative;overflow:hidden;display:flex;}
.hero__photo-fill{position:absolute;inset:0;}
.hero__photo-fill :global(.img-ph){height:100%;}
.hero__photo-fill :global(.img-ph__wrap){padding-top:0!important;height:100%;}
.hero__photo-fill :global(img){width:100%;height:100%;object-fit:cover;}
.hero__cap{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:var(--s4);padding:var(--s4) var(--s5);background:linear-gradient(0deg,rgba(28,33,20,.9),transparent);}
.hero__cap-label{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--avo-300);}
.hero__cap-text{font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:rgba(255,255,255,.7);text-transform:uppercase;flex:1;}
.hero__cap .seal{transform:rotate(-8deg);background:rgba(28,33,20,.4);border-color:var(--seal);color:#fff;backdrop-filter:blur(2px);}
.svc{background:var(--bg-page);}
.svc__wrap{display:grid;grid-template-columns:300px 1fr;gap:var(--s7);align-items:start;}
