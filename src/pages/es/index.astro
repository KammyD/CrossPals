---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { PHONE } from '../../config/site';
import { getCollection } from 'astro:content';

/* ── Servicios（ cada uno con su propia nota de precio ） ── */
const services: Array<{ icon: IconName; n: string; title: string; body: string; price: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',    n: '01', title: 'Búsqueda de Productos',     body: 'Buscamos entre miles de proveedores chinos — 1688, Alibaba y redes de fábrica directa — para hallar la coincidencia exacta para tu presupuesto y tus estándares.', price: 'Pedido de <b>1.000 $</b> → <b>80 $</b> de tarifa de búsqueda (8%). Bajamos el precio unitario y no le agregamos recargo.', seed: 10, hint: '义乌商品城/供应商展会场景', delay: 0 },
  { icon: 'inspection',  n: '02', title: 'Inspección de Calidad',   body: 'Inspección física en la fábrica antes de que tu mercancía se envíe. Informe fotográfico detallado, conteo de defectos y un aprobado/rechazado claro para que nunca envíes a ciegas.', price: 'Pedido de <b>1.000 $</b> → <b>150 $</b> de inspección (medio día). Informe fotográfico completo incluido.', seed: 20, hint: '质检员工作照/工厂内部', delay: 1, featured: true },
  { icon: 'payment',     n: '03', title: 'Compra y Pago', body: 'Negociamos en chino y gestionamos todos los pagos a proveedores verificados. Tu dinero está protegido en cada paso — sin transferencias a desconocidos.', price: 'Pedido de <b>1.000 $</b> → 30% de depósito / 70% tras el QC. <b>5–8%</b> de gestión, sin recargos ocultos.', seed: 30, hint: '签约/握手/合同场景', delay: 2 },
  { icon: 'shipping',    n: '04', title: 'Envío y Logística', body: 'Puerta a puerta en todo el mundo. Comparamos aéreo, marítimo y exprés, gestionamos los documentos de aduana y te damos seguimiento en tiempo real.', price: 'Pedido de <b>1.000 $</b> → flete según la cotización en vivo del transportista. <b>0 $</b> agregados encima.', seed: 40, hint: '集装箱港口/货运飞机', delay: 3 },
];

/* ── Tres escenarios reales de vendedores FBA（los posts que aparecen cada día en los grupos de Amazon） ── */
const scenarios: Array<{ quote: string; tag: string; title: string; body: string; cta: string }> = [
  { quote: 'Pedí 500 unidades y llegaron con un 30% de defectos.', tag: 'Inspeccionado antes de enviar', title: 'Inspección de Calidad',
    body: 'Revisamos el lote completo en la fábrica — midiendo, probando y contando defectos ante la cámara. Si la tasa de aprobación no llega, el proveedor retrabaja o reemplaza antes de que salga una sola caja de China.',
    cta: 'Ver cómo funciona la inspección' },
  { quote: 'Mi proveedor desapareció después de que pagué.', tag: 'Verificado antes de que pagues', title: 'Verificación de Proveedores',
    body: 'Nunca transferimos a un proveedor que no hayamos verificado. Licencia comercial, dirección de la fábrica, historial de exportación y un recorrido en video en vivo — comprobado antes de que liberes un depósito, no después.',
    cta: 'Ver cómo verificamos proveedores' },
  { quote: 'No sé si mi producto cumple los requisitos de FBA.', tag: 'Listo para FBA antes de salir', title: 'Preparación FBA',
    body: 'Etiquetamos, embolsamos, empaquetamos en bundles, pesamos y medimos según la especificación exacta de Amazon — y te damos las etiquetas de caja y la lista de empaque que pasan recepción a la primera.',
    cta: 'Ver la preparación FBA' },
];

/* ── Módulo de inspección independiente: los 5 estándares que revisamos ── */
const inspectionStandards: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'Apariencia',      body: 'Superficie, color, impresión y acabado revisados contra tu muestra aprobada.' },
  { n: '02', title: 'Dimensiones',      body: 'Largo, ancho, peso y tolerancias medidos con calibrador y báscula.' },
  { n: '03', title: 'Prueba de función',   body: 'Cada unidad muestreada encendida, ensamblada o usada como la usará tu cliente.' },
  { n: '04', title: 'Empaque',       body: 'Caja retail, insertos e integridad de la bolsa — además de resistencia a caídas en tránsito.' },
  { n: '05', title: 'Revisión de etiquetas FBA', body: 'FNSKU, etiquetas de caja, advertencias de asfixia y legibilidad del código de barras de Amazon.' },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Día 1',    title: 'Envías tu producto',      body: 'Cuéntanos el producto, la cantidad, el nivel de calidad y el presupuesto en nuestro formulario.' },
  { day: 'Día 2',    title: 'Proveedores verificados',  body: '3–5 proveedores verificados con precios y perfiles, en tu bandeja en 48 horas.' },
  { day: 'Día 7–20', title: 'Compramos e inspeccionamos',         body: 'Pagamos al proveedor, supervisamos la producción y te enviamos un informe QC completo antes de que algo se embarque.' },
  { day: 'Día 21+',  title: 'Listo para FBA, entregado',     body: 'La mercancía sale de China etiquetada y empacada según la especificación de Amazon, aduanas gestionadas, con seguimiento.' },
];

/* ── Testimonios: formato vendedor FBA (categoría / pedido / problema / resultado) ── */
const testiFeatured = {
  quote: 'Vendo utensilios de cocina en Amazon EE. UU. CrossPals buscó mi producto estrella, detectó 15 unidades defectuosas antes del envío y lo dejó todo listo para FBA en 18 días. Desde entonces he reordenado dos veces.',
  name: 'Marcus T.', meta: 'Vendedor Amazon · Estados Unidos · Cocina y Menaje',
  result: '15 defectos detectados antes del envío · Listo para FBA en 18 días', avatar: '/img/avatar-nigeria.webp',
};
const testiSmall = [
  { quote: 'Mi primer pedido de marca propia — 800 unidades de productos para mascotas. Verificaron la fábrica, detectaron un problema de empaque y llegó a FBA sin un solo rechazo.',
    name: 'Ana R.', meta: 'Amazon FBA · España · Mascotas', result: '0 rechazos en FBA', avatar: '/img/avatar-mexico.webp' },
  { quote: 'Mi proveedor anterior me dejó plantado tras el depósito. CrossPals verificó uno nuevo, hizo el QC ellos mismos y nunca más envié dinero a un desconocido.',
    name: 'David O.', meta: 'Amazon y Shopify · Reino Unido · Hogar y Jardín', result: '2 reposiciones', avatar: '/img/avatar-uk.webp' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: 'Sin Barrera de Idioma',  body: 'Negociamos directamente en chino — obtienes precios de fábrica, no precios de turista.' },
  { icon: 'trust',        n: '02', title: 'Responsabilidad Real',   body: 'Un agente dedicado gestiona tu pedido. Una persona, no una cola de tickets.' },
  { icon: 'handshake',    n: '03', title: 'Hecho para Vendedores FBA', body: 'Todo lo que hacemos termina en una caja lista para Amazon: buscada, inspeccionada, etiquetada, empacada.' },
  { icon: 'transparent',  n: '04', title: 'Costos Transparentes',     body: 'Precio del proveedor + flete + nuestra tarifa. Ves cada número antes de comprometerte.' },
];

/* La portada solo da la promesa（resultado），no el proceso; el proceso completo está en Servicios */
const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: 'Solo proveedores verificados', body: 'Verificamos a cada proveedor antes de que pagues un centavo.' },
  { icon: 'inspection', title: 'QC antes del envío',      body: 'Informe fotográfico + aprobado/rechazado antes de que tu dinero se mueva.' },
  { icon: 'payment',    title: 'Protección de pago',      body: 'Retenemos los fondos hasta que se cumplan los hitos. Sin transferencias a desconocidos.' },
  { icon: 'shipping',   title: 'Entrega DDP a puerta',       body: 'Seguimiento y mercancía — no papeleo.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'Tarifa de agencia',     value: '5–8% del pedido', note: 'Pedido de 10.000 $ = 600 $ de tarifa' },
  { label: 'Inspección',    value: '150 $ / día',          note: 'La mayoría termina en medio día' },
  { label: 'Preparación FBA',      value: 'Por unidad',            note: 'Detallado línea por línea en tu cotización' },
  { label: 'Flete',       value: 'Según cotización',    note: 'No agregamos nada sobre el precio del transportista' },
];

/* Recursos: los 3 artículos más recientes (src/content/blog/*.md — al añadir un artículo aparece solo) */
const blogPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map(p => ({
    slug: p.slug,
    cat: p.data.categoryEs ?? p.data.category,
    title: p.data.titleEs ?? p.data.title,
    time: p.data.readTime,
    cover: p.data.cover,
  }));

const svcImg: Record<number,string> = {10:'sourcing-1688',20:'inspection',30:'payment',40:'shipping'};
const guarImg: Record<string,string> = {trust:'factory',inspection:'inspection',payment:'payment',shipping:'shipping'};
const tickerItems = ['Preparación FBA', 'QC Previo al Envío', 'Búsqueda en 1688', 'Verificación de Proveedores', 'Envío DDP', 'Marca Propia', 'Fotografía de Producto', 'Amazon FBA', 'HeBei · BaoDing → Mundo', 'Informes QC con Fotos', 'Sin Cargos Ocultos'];
const categories = ['Cocina y Menaje', 'Hogar y Jardín', 'Mascotas', 'Juguetes y Juegos', 'Deportes y Aire Libre', 'Belleza y Cuidado Personal', 'Accesorios Electrónicos', 'Productos de Oficina'];
---
<BaseLayout
  title="El socio de abastecimiento en que confían los vendedores de Amazon"
  description="Verificación de proveedores, control de calidad y preparación FBA para vendedores de Amazon. Tú vendes, nosotros nos encargamos del resto del proceso."
  lang="es"
>

<!-- ═══ 顶部深色带：公告条 + 刊头信息行 ═══ -->
<div class="topband">
  <a href="/es/contact" class="announce announce--dark">
    <span class="announce__dot" aria-hidden="true"></span>
    <span><strong>Nuevo:</strong> consulta de abastecimiento gratis para primeros importadores — lista de proveedores en 48h</span>
    <span class="announce__arrow" aria-hidden="true">→</span>
  </a>

  <div class="masthead">
    <div class="container masthead__inner">
      <span>CrossPals · Manual de Abastecimiento</span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span>Edición Nº01 — MMXXVI</span>
    </div>
  </div>
</div>

<!-- ═══ HERO — 面向 Amazon 卖家 ═══ -->
<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">Abastecimiento en China para vendedores FBA</p>
        <h1 class="hero__title">El socio de abastecimiento en que confían los vendedores de Amazon — <em>inspección de calidad incluida.</em></h1>
        <p class="hero__lead">Buscamos, inspeccionamos y preparamos tus productos para FBA — para que te centres en vender, no en proveedores.</p>

        <p class="hero__sidenote">Fig. 00 — La mayoría de los vendedores FBA pierde dinero por las barreras idiomáticas, los proveedores falsos y los envíos a ciegas. Nosotros cerramos las tres.</p>

        <div class="hero__actions">
          <a href="/es/contact" class="btn btn-primary">
            Cotización gratis
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href="/es/services" class="btn btn-ghost">Ver cómo funciona</a>
        </div>

        <ul class="hero__index">
          <li><span>01</span> Buscar</li>
          <li><span>02</span> Inspeccionar</li>
          <li><span>03</span> Preparar FBA</li>
          <li><span>04</span> Entregar</li>
        </ul>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__photo-fill">
        <ImgPlaceholder src="/img/hero-warehouse.webp" seed={42} width={900} height={1100} ratio="9/11" priority
          alt="Almacén de fábrica en China — abastecimiento CrossPals" />
      </div>
      <div class="hero__cap">
        <span class="hero__cap-label">Fig. 01</span>
        <span class="hero__cap-text">HeBei · BaoDing, China</span>
        <span class="seal seal--sm" aria-hidden="true"><span>Verified</span><span>Agent</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TICKER ═══ -->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[...tickerItems, ...tickerItems].map(t => <span class="ticker__item">{t}</span>)}
  </div>
</div>

<!-- ═══ 信任带：品类场景标识 + 数字指标 ═══ -->
<section class="trustbar" aria-label="Qué gestionamos y a quién servimos">
  <div class="container">
    <p class="overline" style="margin-bottom:var(--s4);">Buscando, inspeccionando y preparando para vendedores de Amazon y Shopify en</p>
    <div class="regionwall reveal">
      {categories.map(c => <span>{c}</span>)}
    </div>
    <ul class="trustmetrics reveal reveal-delay-1">
      <li><b>47</b><span>Vendedores Amazon atendidos</span></li>
      <li><b>$2.3M<em>+</em></b><span>En mercancía abastecida</span></li>
      <li><b>98<em>%</em></b><span>Entregas a tiempo</span></li>
    </ul>
  </div>
</section>

<!-- ═══ SERVICES — 每项带独立定价说明 ═══ -->
<section class="section svc ledger">
  <div class="container svc__wrap">
    <aside class="svc__aside">
      <p class="overline">Qué Hacemos</p>
      <h2 class="svc__h">Abastecimiento en China<br/><em>de Extremo a Extremo</em></h2>
      <p class="svc__intro">Cuatro disciplinas, un agente responsable. Cada paso se documenta, fotografía y presupuesta antes de que tu dinero se mueva.</p>
      <a href="/es/services" class="svc__all">Índice completo de servicios →</a>
    </aside>

    <ol class="svc__list">
      {services.map(s => (
        <li class:list={['svc-row reveal', `reveal-delay-${s.delay}`]}>
          <div class="svc-row__num"><span class="indexnum">{s.n}</span></div>
          <div class="svc-row__thumb">
            <ImgPlaceholder src={'/img/'+svcImg[s.seed]+'.webp'} seed={s.seed} width={360} height={240} ratio="3/2" alt={s.title} />
          </div>
          <div class="svc-row__body">
            <div class="svc-row__top">
              <h3>{s.title}</h3>
            </div>
            <div class="lede-row">
              <p>{s.body}</p>
              <a href="/es/services" class="svc-row__link">Más información
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
            <div class="price-note">
              <span class="price-note__label">Precio</span>
              <span class="price-note__calc" set:html={s.price} />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═══ HOW IT WORKS ═══ -->
<section class="section hiw grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="hiw__head reveal">
      <p class="overline overline--light">Proceso</p>
      <h2 class="text-white">Del Proveedor a<br/><em style="color:var(--avo-300)">Listo para FBA en 4 Pasos</em></h2>
    </div>

    <div class="manifest reveal reveal-delay-1">
      {steps.map((step, i) => (
        <div class:list={['manifest__col', { 'manifest__col--end': i === steps.length - 1 }]}>
          <span class="manifest__day">{step.day}</span>
          <span class="manifest__n">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="manifest__title">{step.title}</h4>
          <p class="manifest__body">{step.body}</p>
        </div>
      ))}
      <div class="manifest__stamp" aria-hidden="true">
        <span class="seal"><span>Cross</span><span>Pals ✓</span></span>
      </div>
    </div>

    <div class="hiw__cta reveal reveal-delay-2">
      <a href="/es/contact" class="btn btn-primary">Cotización gratis</a>
      <a href="/es/case-studies" class="btn btn-ghost">Ver casos de estudio</a>
    </div>
  </div>
</section>

<!-- ═══ 三个真实 FBA 卖家场景（解决痛点） ═══ -->
<section class="section scen">
  <div class="container">
    <div class="scen__head reveal">
      <p class="overline">Problemas que resolvemos</p>
      <h2>Tres Posts que Escribe<br/><em>Cada Vendedor de Amazon</em></h2>
      <p class="scen__lead">Estos son los hilos que aparecen todos los días en los grupos de vendedores de Amazon. Así respondemos exactamente a cada uno.</p>
    </div>

    <div class="scen__list">
      {scenarios.map((s, i) => (
        <article class:list={['scen-item reveal', `reveal-delay-${i}`]}>
          <div class="scen-item__quote">
            <span class="scen-item__mark" aria-hidden="true">“</span>
            <p>{s.quote}</p>
            <span class="scen-item__src">— Publicación en un foro de vendedores FBA</span>
          </div>
          <div class="scen-item__sol">
            <span class="tag tag-seal">{s.tag}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <a href="/es/services" class="scen-item__link">{s.cta}
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 独立质检模块（差异化武器） ═══ -->
<section class="section inspect grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="inspect__head reveal">
      <p class="overline overline--light">Inspección de Calidad</p>
      <h2 class="text-white">Cada pedido llega con un<br/><em>informe de inspección completo.</em></h2>
      <p class="inspect__lead">No una foto de una caja. Un informe estructurado, línea por línea, contra cinco estándares — enviado antes de que tu mercancía se embarque, en cada pedido, sea del tamaño que sea.</p>
    </div>

    <div class="inspect__grid">
      <ol class="inspect__std reveal">
        {inspectionStandards.map((s, i) => (
          <li class:list={['inspect-std', `reveal-delay-${i}`]}>
            <span class="inspect-std__n">{s.n}</span>
            <div>
              <h4>{s.title}</h4>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <!-- Informe de inspección de ejemplo（datos de cliente y proveedor ocultos） -->
      <div class="qcreport reveal reveal-delay-2">
        <div class="qcreport__head">
          <span class="qcreport__brand">CrossPals · Inspección Previa al Envío</span>
          <span class="qcreport__no">Informe № CP-2026-0418</span>
        </div>
        <dl class="qcreport__grid">
          <div><dt>Producto</dt><dd>Utensilio de cocina de acero inoxidable</dd></div>
          <div><dt>Cantidad</dt><dd>1.000 uds.</dd></div>
          <div><dt>Muestra</dt><dd>80 uds. (AQL 2.5)</dd></div>
          <div><dt>Dónde</dt><dd>En fábrica, antes del envío</dd></div>
        </dl>
        <ul class="qcreport__checks">
          <li><span>Apariencia</span><span class="ok">Pasa</span></li>
          <li><span>Dimensiones</span><span class="ok">Pasa</span></li>
          <li><span>Prueba de función</span><span class="ok">Pasa</span></li>
          <li><span>Empaque</span><span class="warn">12 uds. retrabajadas</span></li>
          <li><span>Revisión de etiquetas FBA</span><span class="ok">Pasa</span></li>
        </ul>
        <div class="qcreport__result">
          <span class="qcreport__verdict">APROBADO</span>
          <span>12 defectos estéticos menores rechazados y reemplazados por el proveedor antes del empaque.</span>
        </div>
        <p class="qcreport__note">Informe de ejemplo — datos del cliente y del proveedor ocultos. Cada pedido se envía con un informe como este.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIALS — FBA 卖家格式 ═══ -->
<section class="section testi">
  <div class="container">
    <div class="testi__head reveal">
      <p class="overline">Casos de Éxito</p>
      <h2>Vendedores de Amazon,<br/><em>Pedidos Reales</em></h2>
    </div>

    <!-- Testimonio destacado：texto a la izquierda, retrato a la derecha -->
    <blockquote class="pullquote pullquote--feat reveal">
      <div class="pullquote__body">
        <span class="pullquote__mark" aria-hidden="true">“</span>
        <p>{testiFeatured.quote}</p>
        <footer>
          <span class="pullquote__name">{testiFeatured.name}</span>
          <span class="pullquote__region">{testiFeatured.meta}</span>
          <span class="pullquote__result">{testiFeatured.result}</span>
        </footer>
      </div>
      <img class="pullquote__avatar" src={testiFeatured.avatar} alt={`${testiFeatured.name} — retrato de vendedor de Amazon`} loading="lazy" decoding="async" width="160" height="160" />
    </blockquote>

    <div class="testi__row">
      {testiSmall.map((t, i) => (
        <blockquote class:list={['pq-sm reveal', `reveal-delay-${i + 1}`]}>
          <img class="pq-sm__avatar" src={t.avatar} alt={`${t.name} — retrato de vendedor de Amazon`} loading="lazy" decoding="async" width="56" height="56" />
          <p>“{t.quote}”</p>
          <footer>
            <span class="pq-sm__name">{t.name}</span>
            <span>{t.meta}</span>
            <span class="text-seal">{t.result}</span>
          </footer>
        </blockquote>
      ))}
      <div class="testi__stat reveal reveal-delay-1">
        <p class="overline overline--avo">Nuestro historial</p>
        <div class="testi__bignum">47<span>+</span></div>
        <p>Vendedores de Amazon atendidos, 2,3 M$+ en mercancía abastecida, 98% de entregas a tiempo.</p>
        <a href="/es/case-studies" class="btn btn-outline" style="margin-top:var(--s5);border-color:rgba(186,209,133,.4);color:rgba(255,255,255,.85);">Ver casos de estudio →</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 定价说明区块（独立、透明） ═══ -->
<section class="section pricing bg-parchment">
  <div class="container pricing__wrap">
    <div class="pricing__intro reveal">
      <p class="overline">Precios Transparentes</p>
