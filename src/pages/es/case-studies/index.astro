---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ImgPlaceholder from '../../../components/ImgPlaceholder.astro';
import { getCollection } from 'astro:content';

/* Los casos viven en src/content/case-studies/*.md; la traducción completa, si existe,
   en src/content/case-studies-es/<mismo-slug>.md. Orden de resolución:
   traducción -es → campo *Es del inglés → inglés. */
const esBySlug = new Map((await getCollection('case-studies-es')).map(c => [c.slug, c]));
const cases = (await getCollection('case-studies'))
  .filter(c => !c.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map(c => {
    const es = esBySlug.get(c.slug);
    return {
      slug: c.slug,
      date: c.data.date,
      cover: c.data.cover,
      title:   es?.data.title   ?? c.data.titleEs   ?? c.data.title,
      client:  es?.data.client  ?? c.data.clientEs  ?? c.data.client,
      summary: es?.data.summary ?? c.data.summaryEs ?? c.data.summary,
      results: es
        ? es.data.results
        : c.data.results.map((r, i) => ({ v: r.v, l: c.data.resultsEs?.[i] ?? r.l })),
    };
  });

const num = (i: number) => String(i + 1).padStart(2, '0');
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
---
<BaseLayout title="Casos de Éxito" description="Pedidos reales que CrossPals abasteció, inspeccionó y preparó para vendedores de Amazon FBA — el problema, lo que hicimos y el resultado." lang="es">

  <PageHero
    overline="Casos de Éxito"
    title="Pedidos Reales,<br/><em style='font-style:italic;color:var(--avo-300)'>Resultados Reales</em>"
    subtitle="Pedidos anonimizados: el problema del vendedor, lo que hicimos y qué cambió. Primero los números, después los adjetivos."
  />

  <section class="section">
    <div class="container">
      <div class="cases">
        {cases.map((c, i) => (
          <a href={`/es/case-studies/${c.slug}`} class:list={['ccard reveal', `reveal-delay-${i % 3}`]}>
            <ImgPlaceholder src={c.cover} width={800} height={600} ratio="4/3" alt={c.title} />

            <div class="ccard__body">
              <div class="ccard__head">
                <span class="indexnum ccard__n">{num(i)}</span>
                <span class="ccard__client">{c.client}</span>
              </div>

              <h3>{c.title}</h3>
              <p class="ccard__sum">{c.summary}</p>

              <div class="ccard__results">
                {c.results.map(r => (
                  <div class="ccard__res">
                    <strong>{r.v}</strong>
                    <span>{r.l}</span>
                  </div>
                ))}
              </div>

              <div class="ccard__foot">
                <time>{fmt(c.date)}</time>
                <span class="ccard__more">Ver el caso →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="esnote reveal">
        Cada caso incluye la narrativa completa en español: la situación, el problema, lo que hicimos y el resultado.
      </p>
    </div>
  </section>

  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <span class="seal cta-seal" aria-hidden="true"><span>Tu</span><span>Turno</span></span>
      <p class="overline overline--light reveal">Siguiente caso</p>
      <h2 style="color:#fff;margin-bottom:var(--s4);" class="reveal reveal-delay-1">
        Hagamos del Tuyo<br/><em style="color:var(--avo-300)">El Siguiente</em>
      </h2>
      <p style="color:rgba(255,255,255,.6);max-width:440px;margin:0 auto var(--s6);" class="reveal reveal-delay-2">
        Cuéntanos qué quieres abastecer. Te responderemos con proveedores verificados y un desglose de precio completo en 48 horas.
      </p>
      <a href="/es/contact" class="btn btn-primary reveal reveal-delay-3">
        Pedir presupuesto gratis
        <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .cases{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s5);align-items:stretch;}
  .ccard{background:#fff;border:1px solid var(--warm-200);display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:var(--t-med);overflow:hidden;}
  .ccard:hover{border-color:var(--avo-300);}
  .ccard :global(.img-ph){border-radius:0;flex-shrink:0;}
  .ccard :global(.img-ph__wrap){border-radius:0;}
  .ccard__body{padding:var(--s4) var(--s5) var(--s5);display:flex;flex-direction:column;gap:var(--s3);flex:1;}
  /* 序号独占一行，「类别标签」另起一行 —— 不再和序号挤在同一行 */
  .ccard__head{display:block;}
  .ccard__n{display:block;font-size:26px;}
  .ccard__client{display:block;margin-top:9px;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--text-muted);}
  .ccard h3{font-size:17px;line-height:1.34;transition:color var(--t-fast);}
  .ccard:hover h3{color:var(--seal);}
  .ccard__sum{font-size:13px;line-height:1.62;color:var(--text-body);}
  .ccard__results{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s3);border-top:2px solid var(--seal);padding-top:var(--s3);}
  .ccard__res strong{display:block;font-family:var(--font-serif);font-size:19px;font-weight:600;color:var(--avo-700);line-height:1.1;margin-bottom:3px;}
  .ccard__res span{font-family:var(--font-mono);font-size:9.5px;line-height:1.45;color:var(--text-muted);display:block;}
  .ccard__foot{display:flex;align-items:center;justify-content:space-between;gap:var(--s3);font-size:11px;color:var(--warm-400);font-family:var(--font-mono);padding-top:var(--s3);border-top:1px solid var(--warm-200);margin-top:auto;}
  .ccard__more{color:var(--seal);font-weight:600;}
  .cta-seal{display:inline-flex;margin-bottom:var(--s4);background:rgba(28,33,20,.4);border-color:var(--seal);color:#fff;}
  .esnote{margin-top:var(--s6);font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;color:var(--text-muted);border-left:2px solid var(--seal);padding:var(--s2) 0 var(--s2) var(--s4);max-width:620px;}

  @media(max-width:1000px){.cases{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:640px){
    .cases{grid-template-columns:1fr;}
    .ccard__results{grid-template-columns:repeat(3,1fr);gap:var(--s2);}
    .ccard__res strong{font-size:17px;}
  }
</style>
