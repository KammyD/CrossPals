---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

// Mismos artículos que el blog en inglés (los textos están redactados en inglés).
// El contenido vive en src/content/blog/*.md — los campos *Es del frontmatter, si existen, se usan aquí.
const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const first = posts[0]?.slug;
---
<BaseLayout title="Recursos" description="Guías prácticas para vendedores de Amazon y Shopify que abastecen desde China." lang="es">

  <PageHero overline="Recursos" title="Para<br /><em style='font-style:italic;color:var(--avo-300)'>Vendedores Amazon</em>" subtitle="Guías de abastecimiento, inspección y preparación FBA — escritas para vendedores de Amazon y Shopify." />

  <section class="section">
    <div class="container">
      <p class="esnote reveal">
        Por ahora todos los artículos están redactados en inglés. Si necesitas alguno en español, escríbenos y lo traducimos.
      </p>

      <div class="alist">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class:list={['arow reveal', { 'arow--feat': post.slug === first }, `reveal-delay-${Math.min(i,3)}`]}>
            <div class="arow__thumb">
              <ImgPlaceholder src={post.data.cover} width={480} height={300} ratio="8/5" alt={post.data.title} />
            </div>
            <div class="arow__body">
              <span class="arow__cat">{post.data.categoryEs ?? post.data.category}</span>
              <h3>{post.data.titleEs ?? post.data.title}</h3>
              <div class="arow__foot">
                <span class="arow__time"><Icon name="clock" size={12} color="var(--warm-400)" />{post.data.readTime} de lectura</span>
                <span class="arow__read">Leer en inglés →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="escta reveal">
        <a href="/es/contact" class="btn btn-primary">Habla con CrossPals</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .esnote {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; color: var(--text-muted);
    border-left: 2px solid var(--seal); padding: var(--s2) 0 var(--s2) var(--s4);
    margin-bottom: var(--s7); max-width: 620px;
  }
  .alist { display: flex; flex-direction: column; border-top: 1px solid var(--border-light); }
  .arow {
    display: grid; grid-template-columns: 220px 1fr; gap: var(--s5);
    align-items: center; padding: var(--s5) 0;
    border-bottom: 1px solid var(--border-light);
    text-decoration: none; color: inherit;
  }
  .arow__thumb :global(.img-ph) { border: 1px solid var(--border-light); }
  .arow--feat .arow__thumb :global(.img-ph) { border-color: var(--seal); }
  .arow__body { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }
  .arow__cat {
    font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: .12em; text-transform: uppercase; color: var(--avo-600);
  }
  .arow h3 { font-size: clamp(17px, 2vw, 21px); line-height: 1.3; transition: color var(--t-fast); }
  .arow:hover h3 { color: var(--seal); }
  .arow__foot { display: flex; align-items: center; gap: var(--s4); margin-top: var(--s1); }
  .arow__time { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--warm-400); font-family: var(--font-mono); }
  .arow__read { font-size: 12px; font-family: var(--font-mono); color: var(--seal); font-weight: 500; }
  .escta { margin-top: var(--s7); }
  @media (max-width: 640px) {
    .arow { grid-template-columns: 1fr; gap: var(--s4); }
    .arow__thumb { max-width: 320px; }
  }
</style>
