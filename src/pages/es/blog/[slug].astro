---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../../components/ImgPlaceholder.astro';
import { getCollection } from 'astro:content';

/* Detalle del artículo.
   Cuerpo: primero se busca la traducción en src/content/blog-es/<mismo-slug>.md;
   si no existe, se cae al inglés de src/content/blog/ y se avisa en la página.
   Metadatos: traducción -es → campo *Es del inglés → inglés. */
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const esPosts = await getCollection('blog-es');
  const esBySlug = new Map(esPosts.map(p => [p.slug, p]));
  return posts
    .filter(p => !p.data.draft)
    .map(p => ({ params: { slug: p.slug }, props: { post: p, es: esBySlug.get(p.slug) ?? null } }));
}

const { post, es } = Astro.props;
const { Content } = await (es ?? post).render();

const title       = es?.data.title       ?? post.data.titleEs       ?? post.data.title;
const description = es?.data.description ?? post.data.descriptionEs ?? post.data.description;
const category    = es?.data.category    ?? post.data.categoryEs    ?? post.data.category;
const readTime    = es?.data.readTime    ?? post.data.readTime;

const published = new Date(post.data.date + 'T00:00:00')
  .toLocaleDateString('es-ES', { month: 'long', day: 'numeric', year: 'numeric' });

const all = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const others = all.filter(p => p.slug !== post.slug).slice(0, 3);
---
<BaseLayout
  title={title}
  description={description}
  lang="es"
  article={{ published: post.data.date, section: category }}
>

  <div class="article-cover" style="padding-top:var(--hdr-h);">
    <ImgPlaceholder src={post.data.cover} width={1680} height={720} ratio="21/9" priority alt={title} />
  </div>

  <header class="article-hdr">
    <div class="container article-hdr__inner">
      <a href="/es/blog" class="back">← Volver a Recursos</a>
      <span class="article-cat">{category}</span>
      <h1>{title}</h1>
      <div class="article-meta">
        <time>{published}</time>
        <span>·</span><span>{readTime} de lectura</span>
        <span>·</span><span>Equipo CrossPals</span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container article-grid">
      <div>
        {!es && (
          <p class="esnote reveal">
            Todavía no hemos traducido este artículo al español; el texto aparece en inglés.
          </p>
        )}
        <div class="prose reveal"><Content /></div>
      </div>

      <aside class="article-aside reveal reveal-delay-2">
        <div class="aside-cta">
          <p class="overline">¿Necesitas ayuda?</p>
          <h4>Pide presupuesto gratis</h4>
          <p>Cuéntanos tu producto. Proveedores verificados y un desglose de precio completo en 48 horas.</p>
          <a href="/es/contact" class="btn btn-primary" style="margin-top:var(--s5);">Pedir presupuesto <svg class="arrow-icon" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <nav class="aside-nav">
          <p class="overline">Explorar</p>
          <a href="/es/services">FBA Sourcing &amp; Inspection →</a>
          <a href="/es/case-studies">Casos de estudio →</a>
          <a href="/es/blog">Todos los artículos →</a>
        </nav>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section bg-parchment">
      <div class="container">
        <p class="overline reveal">Sigue leyendo</p>
        <h2 class="reveal reveal-delay-1" style="margin-bottom:var(--head-gap);">Otros artículos, <em style="font-style:italic;color:var(--avo-600);">otros problemas resueltos</em></h2>
        <div class="ocards">
          {others.map((p, i) => (
            <a href={`/es/blog/${p.slug}`} class:list={['ocard reveal', `reveal-delay-${i + 1}`]}>
              <div class="ocard__thumb">
                <ImgPlaceholder src={p.data.cover} width={480} height={360} ratio="4/3" alt={p.data.titleEs ?? p.data.title} />
              </div>
              <div class="ocard__body">
                <span class="ocard__client">{p.data.categoryEs ?? p.data.category}</span>
                <h4>{p.data.titleEs ?? p.data.title}</h4>
                <span class="ocard__more">Leer artículo →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* padding-top 只是给固定顶栏让位，限幅要把它加回来，否则图片被压扁 */
  .article-cover{max-height:calc(44vh + var(--hdr-h));min-height:260px;overflow:hidden;}
  .article-cover :global(.img-ph){border-radius:0;}
  .article-cover :global(.img-ph__wrap){border-radius:0;}
  .article-hdr{background:var(--warm-100);padding:var(--s6) 0 var(--s5);border-bottom:1px solid var(--border-light);}
  .article-hdr__inner{max-width:820px;}
  .back{display:inline-block;font-size:13px;font-weight:600;font-family:var(--font-mono);color:var(--text-body);text-decoration:none;margin-bottom:var(--s3);transition:color var(--t-fast);letter-spacing:0.04em;}
  .back:hover{color:var(--seal);}
  .article-cat{font-family:var(--font-mono);font-size:10px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--avo-600);display:block;margin-bottom:var(--s2);}
  .article-hdr h1{margin-bottom:var(--s3);max-width:760px;}
  .article-meta{display:flex;align-items:center;gap:var(--s3);font-size:12px;color:var(--warm-400);font-family:var(--font-mono);}
  .article-grid{display:grid;grid-template-columns:1fr 280px;gap:var(--s6);align-items:start;}
  .esnote{font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;color:var(--text-muted);border-left:2px solid var(--seal);padding:var(--s2) 0 var(--s2) var(--s4);margin-bottom:var(--s5);max-width:620px;}
  .prose{font-size:16.5px;line-height:1.72;color:var(--text-body);max-width:660px;}
  .prose :global(p){margin-bottom:var(--s4);}
  .prose :global(h2){font-family:var(--font-serif);font-size:clamp(21px,2.3vw,26px);color:var(--warm-950);margin:var(--s6) 0 var(--s3);padding-top:var(--s5);border-top:2px solid var(--seal);}
  .prose :global(h2:first-child){margin-top:0;border-top:none;padding-top:0;}
  .prose :global(h3){font-family:var(--font-serif);font-size:19px;color:var(--warm-950);margin:var(--s5) 0 var(--s2);}
  .prose :global(strong){color:var(--warm-950);}
  .prose :global(a){color:var(--seal);font-weight:600;text-decoration:underline;text-decoration-color:var(--seal-soft);}
  .prose :global(ul),.prose :global(ol){margin:0 0 var(--s4) var(--s5);padding-left:var(--s4);}
  .prose :global(li){margin-bottom:var(--s2);}
  .prose :global(blockquote){border-left:2px solid var(--seal);padding:var(--s2) 0 var(--s2) var(--s4);margin:var(--s5) 0;font-family:var(--font-mono);font-size:13px;line-height:1.7;color:var(--text-muted);}
  .article-aside{position:sticky;top:84px;display:flex;flex-direction:column;gap:var(--s4);}
  .aside-cta{background:var(--avo-950);border-left:2px solid var(--seal);padding:var(--s5);color:#fff;}
  .aside-cta .overline{color:rgba(255,255,255,.45);margin-bottom:var(--s2);}
  .aside-cta h4{color:#fff;font-size:16px;margin-bottom:var(--s2);}
  .aside-cta>p{font-size:13.5px;color:rgba(255,255,255,.6);}
  .aside-nav{background:var(--warm-100);border-top:2px solid var(--seal);padding:var(--s4) var(--s5) var(--s5);display:flex;flex-direction:column;gap:var(--s2);}
  .aside-nav .overline{margin-bottom:var(--s2);}
  .aside-nav a{font-size:14px;font-weight:600;color:var(--avo-800);text-decoration:none;transition:color var(--t-fast);}
  .aside-nav a:hover{color:var(--seal);}

  .ocards{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s5);}
  .ocard{display:flex;flex-direction:column;background:#fff;border:1px solid var(--warm-200);text-decoration:none;color:inherit;transition:var(--t-med);}
  .ocard:hover{border-color:var(--avo-300);}
  .ocard :global(.img-ph__wrap){border-radius:0;}
  .ocard__body{padding:var(--s4) var(--s5) var(--s5);display:flex;flex-direction:column;gap:var(--s2);flex:1;}
  .ocard__client{font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--avo-600);}
  .ocard h4{font-size:15.5px;line-height:1.34;transition:color var(--t-fast);}
  .ocard:hover h4{color:var(--seal);}
  .ocard__more{margin-top:auto;padding-top:var(--s3);font-family:var(--font-mono);font-size:11.5px;color:var(--seal);font-weight:600;}

  @media(max-width:900px){
    .article-grid{grid-template-columns:1fr;}
    .article-aside{position:static;}
    .ocards{grid-template-columns:1fr;}
  }
</style>
