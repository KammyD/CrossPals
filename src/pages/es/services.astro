---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';

const services: Array<{ icon: IconName; n: string; title: string; desc: string; details: string[]; featured?: boolean; seed: number; hint: string }> = [
  { icon: 'sourcing', n: '01', title: 'Búsqueda de Productos', seed: 11, hint: '1688/义乌采购',
    desc: 'Buscamos entre miles de proveedores chinos para encontrar la opción ideal según tu presupuesto y estándares.',
    details: ['Búsqueda en 1688, Alibaba y fábricas directas','3–5 proveedores verificados con cotizaciones','Certificaciones e historial verificados','Perfil completo del proveedor en 48 horas'] },
  { icon: 'inspection', n: '02', title: 'Inspección de Calidad', featured: true, seed: 22, hint: '工厂质检/出货前',
    desc: 'Inspección física en fábrica antes del envío. Informe fotográfico y veredicto claro — cada pedido.',
    details: ['Inspección previa al envío en fábrica','Informe fotográfico de 20–40 fotos','Pruebas de funcionalidad y conteo de defectos','Recomendación clara antes de aprobar el envío'] },
  { icon: 'payment', n: '03', title: 'Compra y Pago', seed: 33, hint: '合同/付款',
    desc: 'Negociamos en chino y gestionamos todos los pagos a proveedores verificados de forma segura.',
    details: ['Negociación de precios en chino','Pago seguro solo a proveedores verificados','Documentación completa de la orden de compra','Múltiples métodos de pago aceptados'] },
  { icon: 'shipping', n: '04', title: 'Envío y Logística', seed: 44, hint: '港口/货运',
    desc: 'Entrega puerta a puerta en todo el mundo con flete comparado y aduanas gestionadas.',
    details: ['Flete aéreo, marítimo y express comparados','Envíos consolidados de múltiples proveedores','Factura comercial y trámites aduaneros','Seguimiento en tiempo real compartido'] },
  { icon: 'factory', n: '05', title: 'Visitas a Fábrica', seed: 55, hint: '验厂/审核',
    desc: 'Para pedidos grandes o proveedores nuevos, organizamos auditorías presenciales.',
    details: ['Recorrido por instalaciones y verificación de capacidad','Chequeo de seguridad y cumplimiento','Aprobación de muestras en sitio','Videollamada contigo durante la visita si es necesario'] },
  { icon: 'reorder', n: '06', title: 'Soporte de Reordenamiento', seed: 66, hint: '补货/库存',
    desc: 'Construimos un sistema de reordenamiento confiable para que nunca te quedes sin stock.',
    details: ['Gestión de relación con proveedor dedicado','Renegociación de precios estacional a tu favor','Alertas de reorden y planificación de inventario','Manejo prioritario para clientes frecuentes'] },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Día 1',    title: 'Envías tu solicitud',         body: 'Detalles del producto, cantidad, requisitos y presupuesto vía nuestro formulario.' },
  { day: 'Día 2',    title: 'Enviamos opciones',          body: '3–5 proveedores verificados con cotizaciones y perfiles, listos para tu revisión.' },
  { day: 'Día 3–5',  title: 'Negociación y compra',       body: 'Acordamos términos en chino, emitimos la PO y liberamos el depósito con seguridad.' },
  { day: 'Día 7–20', title: 'Producción e inspección',    body: 'Se fabrica la mercancía. Inspeccionamos y te enviamos el informe QC antes del envío.' },
  { day: 'Día 21+',  title: 'Enviado y entregado',        body: 'Sale de China. Rastreas en tiempo real y recibes en tu puerta, aduanas listas.' },
];

const faqs = [
  { q: '¿Cuál es el tamaño mínimo de pedido?',     a: 'Sin mínimo estricto, pero trabajamos mejor con pedidos de $300 USD o más. Los pedidos pequeños pueden tener menos opciones.' },
  { q: '¿Cuánto tarda todo el proceso?',            a: 'Lista de proveedores: 24–48h. Negociación y compra: 1–3 días. Inspección: 2–5 días tras producción. Envío: 5–35 días.' },
  { q: '¿Cuál es su tarifa?',                       a: 'Tarifa transparente según el valor del pedido — típicamente 5–10%. Ves el desglose completo antes de comprometer un dólar.' },
  { q: '¿Qué pasa si la mercancía falla la inspección?', a: 'Trabajamos con el proveedor para resolver — retrabajo, reemplazo o reembolso. Nunca liberamos el pago sin tu aprobación.' },
  { q: '¿Puedo tener empaque personalizado con mi logo?', a: 'Sí. Manejamos cajas, bolsas, etiquetas y tags personalizados. MOQ varía, típicamente 300–1,000 piezas.' },
  { q: '¿Apoyan dropshipping?',                     a: 'Sí. Enviamos directo a tus clientes en varios países, con empaque discreto o de marca.' },
];

const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: 'Solo proveedores verificados', body: 'Licencias, capacidad e historial de exportación revisados antes de cotizar.' },
  { icon: 'inspection', title: 'QC antes del envío',           body: 'Inspección fotografiada con veredicto claro antes de mover dinero.' },
  { icon: 'payment',    title: 'Protección de pago',           body: 'Fondos liberados solo al cumplir hitos. Nunca a desconocidos.' },
  { icon: 'shipping',   title: 'Entrega DDP a puerta',         body: 'Aduanas y última milla gestionadas, con rastreo en vivo.' },
];
---
<BaseLayout title="Servicios" description="CrossPals ofrece servicios completos de abastecimiento desde China." lang="es">
  <PageHero
    overline="Qué Hacemos"
    title="Abastecimiento Completo<br/><em style='font-style:italic;color:var(--avo-300)'>desde China</em>"
    subtitle="Desde tu primera idea de producto hasta los reordenes — gestionamos cada paso."
  />

  <section class="section">
    <div class="container svcs">
      {services.map((s, i) => (
        <article class:list={['svc-row reveal', { 'svc-row--featured': s.featured, 'svc-row--reverse': i % 2 === 1 }]}>
          <div class="svc-row__meta">
            <div class="svc-row__head">
              <span class="indexnum">{s.n}</span>
              <h3>{s.title}</h3>
            </div>
            <p>{s.desc}</p>
            <ImgPlaceholder seed={s.seed} width={480} height={300} ratio="8/5" alt={s.title} hint={s.hint} />
            <a href="/es/contact" class:list={['btn', s.featured ? 'btn-primary' : 'btn-outline']} style="margin-top:var(--s5);align-self:flex-start;">
              Empezar
              <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </a>
          </div>
          <ul class="svc-row__list">
            {s.details.map(d => (
              <li>
                <Icon name="check-circle" size={15} color={s.featured ? 'var(--seal)' : '#637d3e'} />
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-parchment">
    <div class="container">
      <div class="tl-head reveal">
        <p class="overline">Nuestro Proceso</p>
        <h2>Cómo Fluye un<br/><em>Pedido Típico</em></h2>
      </div>
      <ol class="ledger-list">
        {steps.map((step, i) => (
          <li class:list={['ledger-item reveal', `reveal-delay-${Math.min(i, 3)}`]}>
            <span class="ledger-item__day">{step.day}</span>
            <span class="ledger-item__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="ledger-item__body">
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="guar-head reveal">
        <p class="overline">Nuestras Garantías</p>
        <h2>Lo que Recibes, <em>en Cada Pedido</em></h2>
      </div>
      <div class="guarantee reveal">
        {guarantees.map((g, i) => (
          <div class="guarantee__item">
            <span class="guarantee__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="guarantee__icon"><Icon name={g.icon} size={26} color="var(--seal)" /></div>
            <h4>{g.title}</h4>
            <p>{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="faq-head reveal">
        <p class="overline">Preguntas</p>
        <h2>Preguntas<br/><em>Frecuentes</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class:list={['faq-item reveal', `reveal-delay-${i % 3}`]}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <span class="seal cta-seal" aria-hidden="true"><span>Start</span><span>Now</span></span>
      <p class="overline overline--light reveal">Empieza</p>
      <h2 style="color:#fff;margin-bottom:var(--s4);" class="reveal reveal-delay-1">¿Listo para tu<br/><em style="color:var(--avo-300)">Primer Pedido?</em></h2>
      <p style="color:rgba(255,255,255,.6);max-width:420px;margin:0 auto var(--s6);" class="reveal reveal-delay-2">Envíanos tus requisitos y tendremos opciones de proveedores en 48 horas.</p>
      <a href="/es/contact" class="btn btn-primary reveal reveal-delay-3">Cotización Gratis
        <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg></a>
    </div>
  </section>
</BaseLayout>

<style>
  h2 em { font-style:italic; color:var(--avo-600); }
  .svcs { display:flex; flex-direction:column; }
  .svc-row { display:grid; grid-template-columns:1fr 1fr; gap:var(--s7); align-items:center; padding:var(--s7) 0; border-bottom:1px solid var(--border-light); }
  .svc-row:first-child { padding-top:0; }
  .svc-row:last-child  { border-bottom:none; }
  .svc-row--reverse .svc-row__meta { order:2; }
  .svc-row--reverse .svc-row__list { order:1; }
  .svc-row--featured { background:var(--avo-950); padding:var(--s6); border:1px solid var(--avo-800); margin:var(--s5) 0; }
  .svc-row--featured h3 { color:#fff; }
  .svc-row--featured p { color:rgba(255,255,255,.75); }
  .svc-row__head { display:flex; align-items:baseline; gap:var(--s4); margin-bottom:var(--s3); }
  .svc-row__head .indexnum { font-size:44px; }
  .svc-row__meta { display:flex; flex-direction:column; gap:var(--s3); }
  .svc-row__meta > p { font-size:15px; line-height:1.68; }
  .svc-row__list { list-style:none; display:flex; flex-direction:column; border-top:2px solid var(--seal); }
  .svc-row--featured .svc-row__list { border-top-color:var(--seal); }
  .svc-row__list li { display:flex; align-items:flex-start; gap:var(--s3); padding:var(--s3) 0; border-bottom:1px solid var(--border-light); font-size:14px; color:var(--text-body); }
  .svc-row--featured .svc-row__list li { border-color:rgba(255,255,255,.08); color:rgba(255,255,255,.7); }
  .svc-row__list :global(.icon-svg) { flex-shrink:0; margin-top:2px; }
  .guar-head { margin-bottom:var(--s6); }
  .guar-head h2 em { font-style:italic; color:var(--avo-600); }
  .tl-head { margin-bottom:var(--head-gap); }
  .tl-head h2 em { font-style:italic; color:var(--avo-600); }
  .ledger-list { list-style:none; display:flex; flex-direction:column; border-top:1px solid var(--border-mid); max-width:820px; }
  .ledger-item { display:grid; grid-template-columns:120px 64px 1fr; gap:var(--s5); align-items:baseline; padding:var(--s4) 0; border-bottom:1px solid var(--border-light); }
  .ledger-item__day { font-family:var(--font-mono); font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--seal); }
  .ledger-item__n { font-family:var(--font-serif); font-size:36px; font-weight:600; color:var(--avo-200); line-height:1; }
  .ledger-item__body h4 { font-size:17px; margin-bottom:4px; }
  .ledger-item__body p { font-size:14px; }
  .faq-wrap { display:grid; grid-template-columns:260px 1fr; gap:var(--s6); align-items:start; }
  .faq-head h2 em { font-style:italic; color:var(--avo-600); }
  .faq-head { position:sticky; top:100px; }
  .faq-list { display:flex; flex-direction:column; }
  .faq-item { border-bottom:1px solid var(--border-light); }
  .faq-item summary { font-family:var(--font-serif); font-size:17px; font-weight:560; color:var(--text-primary); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:var(--s5); padding:var(--s4) 0; cursor:pointer; user-select:none; transition:color var(--t-fast); }
  .faq-item summary::-webkit-details-marker { display:none; }
  .faq-item summary::after { content:'+'; font-size:22px; font-weight:300; color:var(--seal); flex-shrink:0; transition:transform var(--t-med); }
  .faq-item[open] summary { color:var(--avo-700); }
  .faq-item[open] summary::after { transform:rotate(45deg); }
  .faq-item > p { font-size:15px; color:var(--text-body); padding:0 0 var(--s4); line-height:1.68; }
  .cta-seal { display:inline-flex; margin-bottom:var(--s4); background:rgba(28,33,20,.4); border-color:var(--seal); color:#fff; }
  @media (max-width:900px) {
    .svc-row { grid-template-columns:1fr; gap:var(--s6); }
    .svc-row--reverse .svc-row__meta { order:0; }
    .svc-row--reverse .svc-row__list { order:0; }
    .faq-wrap { grid-template-columns:1fr; }
    .faq-head { position:static; }
    .ledger-item { grid-template-columns:90px 1fr; }
    .ledger-item__n { display:none; }
  }
</style>
