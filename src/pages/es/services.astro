---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';

/* ── Paquete principal（产品推荐）：de extremo a extremo ── */
const coreIncludes: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'Búsqueda de proveedores',   body: '3–5 proveedores verificados con precios reales — licencias, dirección de fábrica e historial de exportación comprobados antes de cotizar.' },
  { n: '02', title: 'Confirmación de muestra', body: 'Pedimos y evaluamos la muestra contra tu especificación y las expectativas de tu cliente antes de que te comprometas al volumen.' },
  { n: '03', title: 'Inspección del lote completo', body: 'Control de calidad previo al envío en fábrica: apariencia, dimensiones, funcionamiento, empaque y revisión de etiquetas FBA.' },
  { n: '04', title: 'Preparación FBA',            body: 'Etiquetado FNSKU, embolsado, empaquetado en bundles, pesaje y medición según la especificación exacta de Amazon.' },
  { n: '05', title: 'Coordinación de flete', body: 'Comparamos aéreo, marítimo y exprés; gestionamos los trámites aduaneros; entrega DDP puerta a puerta con seguimiento en vivo.' },
];

/* ── Servicios adicionales：contratables por separado ── */
const addOns: Array<{ icon: IconName; title: string; problem: string; process: string; pricing: string; seed: number }> = [
  { icon: 'package', title: 'Marca Propia y Diseño de Empaque', seed: 71,
    problem: 'Tu producto debe parecer una marca, no una importación genérica — y un empaque flojo mata la conversión.',
    process: 'Ubicación del logo, arte de cajas / bolsas / etiquetas, tarjetas insertadas y negociación de MOQ con la fábrica de empaques.',
    pricing: 'Una tarifa fija de diseño más el empaque a costo de fábrica. MOQ habitualmente 300–1.000 piezas.' },
  { icon: 'transparent', title: 'Fotografía de Producto', seed: 72,
    problem: 'Amazon entierra — o bloquea — los listados cuya imagen principal no cumple el estándar de fondo blanco.',
    process: 'Tomas con fondo blanco según la especificación de imagen principal de Amazon, más variantes de estilo de vida e infografías a pedido.',
    pricing: 'Tarifa por imagen, más económica por volumen. Tarifa plana por SKU disponible.' },
  { icon: 'sourcing', title: 'Servicio de Compra en 1688', seed: 73,
    problem: 'Los precios más bajos están en 1688 — pero el sitio solo está en chino y no envía al extranjero.',
    process: 'Envíanos un enlace o una foto. Compramos al vendedor de 1688, inspeccionamos, consolidamos y te enviamos.',
    pricing: 'Un porcentaje del valor del pedido con un mínimo pequeño. No necesitas chino.' },
  { icon: 'shipping', title: 'Almacenaje y Transbordo', seed: 74,
    problem: 'Comprar a varios proveedores significa varios fletes internacionales — y nadie revisando la mercancía.',
    process: 'Recibimos, inspeccionamos, reempacamos y consolidamos múltiples pedidos en un solo envío desde nuestro almacén.',
    pricing: 'Almacenaje por metro cúbico por día, más una tarifa de consolidación por pedido.' },
];

const svcImg: Record<number,string> = {71:'blog-packaging',72:'blog-products',73:'sourcing-1688',74:'shipping'};
const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Día 1',    title: 'Envías tu producto',          body: 'Detalles del producto, cantidad, nivel de calidad y presupuesto vía nuestro formulario.' },
  { day: 'Día 2',    title: 'Te enviamos opciones',        body: '3–5 proveedores verificados con cotizaciones y perfiles, listos para tu revisión.' },
  { day: 'Día 3–5',  title: 'Muestra y negociación',       body: 'Confirmamos la muestra, acordamos términos en chino, emitimos la PO y liberamos el depósito con seguridad.' },
  { day: 'Día 7–20', title: 'Producción e inspección',     body: 'Se fabrica la mercancía. Inspeccionamos el lote completo y enviamos un informe QC con fotos antes del envío.' },
  { day: 'Día 21+',  title: 'Listo para FBA, entregado',   body: 'Sale de China etiquetado y empacado según la especificación de Amazon, aduanas despachadas, con seguimiento en vivo.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'Tarifa de agencia', value: '5–8% del pedido', note: 'Pedido de 10.000 $ = 600 $ de tarifa' },
  { label: 'Inspección',  value: '150 $ / día',          note: 'La mayoría termina en medio día' },
  { label: 'Preparación FBA',   value: 'Por unidad',            note: 'Detallado línea por línea en tu cotización' },
  { label: 'Flete',    value: 'Según cotización del transportista',    note: 'No agregamos nada sobre el precio del transportista' },
];

const faqs = [
  { q: '¿Qué incluye el paquete FBA Sourcing & Inspection?', a: 'Búsqueda de proveedores, confirmación de muestra, inspección del lote completo, preparación FBA (etiquetado, embolsado, pesaje, medición) y coordinación de flete — un solo agente responsable, una sola cotización.' },
  { q: '¿Cuánto cuesta su servicio?',                            a: 'La tarifa de agencia es 5–8% del valor del pedido. La inspección es 150 $/día (la mayoría de los pedidos termina en medio día). La preparación FBA se cobra por unidad. Todo está detallado en tu cotización antes de que te comprometas.' },
  { q: '¿Cuál es el tamaño mínimo de pedido?',                         a: 'No hay mínimo estricto, pero trabajamos mejor con pedidos de 300 USD o más. Los pedidos más pequeños pueden tener menos opciones de proveedores.' },
  { q: '¿Qué pasa si la mercancía falla la inspección?',                           a: 'Trabajamos con el proveedor para resolverlo — retrabajo, reemplazo o reembolso — antes de que algo se envíe. Nunca liberamos el pago final sin tu aprobación.' },
  { q: '¿Gestionan la preparación y el etiquetado FBA?',                    a: 'Sí. Etiquetas FNSKU, embolsado, bundles, etiquetas de caja, pesos y dimensiones según la especificación de Amazon — para que tu envío pase recepción a la primera.' },
  { q: '¿Puedo tener empaque personalizado con mi logo?',                 a: 'Sí — ese es nuestro complemento de Marca Propia y Empaque. Cajas, bolsas, etiquetas y tags. El MOQ varía según el proveedor, habitualmente 300–1.000 piezas.' },
];

/* ── Nuestras Garantías, en detalle ──
   La portada solo da la promesa (el resultado); aquí cada una se despliega:
   proceso (pasos y duración) + criterio concreto (lista) + qué pasa si falla.
   Las imágenes no repiten las cuatro de la portada (factory/inspection/payment/shipping);
   las cuatro van a 1024×1280 con ratio "4/5". */
type GuaranteeModule = {
  icon: IconName; n: string; title: string; promise: string;
  img: string; alt: string;
  steps: Array<{ t: string; time: string; d: string }>;
  checksLabel: string;
  checks: Array<{ k: string; v: string }>;
  fail: string;
};
const guaranteeModules: GuaranteeModule[] = [
  {
    icon: 'trust', n: '01', title: 'Solo proveedores verificados',
    promise: 'Verificamos a cada proveedor antes de que pagues un centavo.',
    img: '/img/g-market.webp', alt: 'Recorriendo el piso del mercado mayorista para verificar proveedores en persona',
    steps: [
      { t: 'Preselección', time: 'Día 1–2', d: 'Apartamos 3–5 candidatos de nuestra propia red de fábricas y de 1688, según la especificación de tu producto.' },
      { t: 'Revisión documental', time: 'Día 2–3', d: 'Licencia comercial, dirección registrada, capacidad de producción e historial de exportación — comprobados contra la fábrica misma, no contra una página de ventas.' },
      { t: 'Recorrido en vivo', time: 'Día 3–5', d: 'Una videollamada por el taller: la línea real, el stock real, la muestra real.' },
    ],
    checksLabel: 'Qué verificamos',
    checks: [
      { k: 'Licencia y entidad legal', v: 'La licencia comercial coincide con el nombre que aparecerá en tu factura.' },
      { k: 'Dirección vs. taller', v: 'La dirección registrada se contrasta con donde realmente se fabrica la mercancía.' },
      { k: 'Capacidad y plazo', v: 'Si pueden sostener tu cantidad, tu fecha límite y tu reposición.' },
      { k: 'Historial de exportación', v: 'Envíos anteriores y clientes actuales — a quién ya le venden en el extranjero.' },
      { k: 'Línea de producción en vivo', v: 'Vista por video antes de que salga un solo dólar de tu cuenta.' },
    ],
    fail: 'Si una fábrica no supera la revisión documental o rechaza el recorrido en vivo, nunca llega a tu cotización. Seguimos buscando.',
  },
  {
    icon: 'inspection', n: '02', title: 'QC antes del envío',
    promise: 'Informe fotográfico + aprobado/rechazado antes de que tu dinero se mueva.',
    img: '/img/g-production.webp', alt: 'Inspector revisando mercancía en la planta de producción antes del envío',
    steps: [
      { t: 'Agendar la inspección', time: 'Un día antes de cerrar el lote', d: 'Programada contra la fecha de fin de producción — no contra la fecha de envío, para que quede tiempo de arreglar.' },
      { t: 'Revisión en sitio del lote completo', time: 'Medio día, lo habitual', d: 'Estamos en la fábrica: contamos, medimos, probamos y fotografiamos el lote nosotros mismos.' },
      { t: 'Informe y veredicto', time: 'El mismo día', d: 'Recibes el informe fotográfico con un aprobado/rechazado claro, el conteo de defectos y el estándar de muestreo usado.' },
      { t: 'Retrabajo o reemplazo', time: '3–7 días', d: 'Un rechazo vuelve directo al proveedor para retrabajo o reemplazo — y luego re-inspeccionamos antes de empacar.' },
    ],
    checksLabel: 'Qué revisamos',
    checks: [
      { k: 'Apariencia', v: 'Superficies, color, acabado, costuras, impresión y daños visibles — contra la muestra aprobada.' },
      { k: 'Dimensiones', v: 'Peso y medidas según especificación, con las unidades fuera de tolerancia marcadas individualmente.' },
      { k: 'Funcionamiento', v: 'Cada unidad muestreada encendida, ensamblada o usada tal como la usará tu cliente.' },
      { k: 'Empaque', v: 'Caja retail, bolsa, advertencia de asfixia, insertos y resistencia de la caja de cartón.' },
      { k: 'Etiquetas FBA', v: 'Los códigos FNSKU escanean, las etiquetas de caja son correctas, pesos y dimensiones según la especificación de Amazon.' },
    ],
    fail: 'Si el lote falla, no se envía. El proveedor lo retrabaja o lo reemplaza, y tu saldo se queda con nosotros hasta que pase.',
  },
  {
    icon: 'payment', n: '03', title: 'Protección de pago',
    promise: 'Retenemos los fondos hasta que se cumplan los hitos. Sin transferencias a desconocidos.',
    img: '/img/payment-escrow.webp', alt: 'Fondos retenidos contra cajas selladas hasta que cada hito se cumple',
    steps: [
      { t: 'PO escrita con hitos', time: 'Día 1', d: 'Depósito, producción, inspección y envío quedan fijados como puntos de liberación separados antes de empezar.' },
      { t: 'Depósito liberado', time: 'Día 1–2', d: 'Solo sale el depósito acordado, y solo después de que apruebes la PO por escrito.' },
      { t: 'Puerta de inspección', time: 'En el QC', d: 'El saldo de producción no se libera hasta que el informe de inspección vuelva como aprobado.' },
      { t: 'Liquidación final', time: 'Con tu visto bueno', d: 'El saldo se liquida después de que apruebes, con un recibo escrito en tu factura.' },
    ],
    checksLabel: 'Cómo se retiene tu dinero',
    checks: [
      { k: 'Tú apruebas cada liberación', v: 'Ningún pago se mueve sin tu autorización escrita en ese hito.' },
      { k: 'Nosotros pagamos al proveedor', v: 'Pagamos directamente a la fábrica — nunca envías dinero a una cuenta desconocida.' },
      { k: 'Sin cuentas personales', v: 'Los fondos nunca van a una cuenta bancaria personal ni a una billetera de terceros.' },
      { k: 'Sin prepago total', v: 'Nadie recibe el 100% por adelantado — ni el proveedor, ni nosotros.' },
      { k: 'Recibo en cada transferencia', v: 'Cada liberación queda documentada y detallada contra tu pedido.' },
    ],
    fail: 'Si un hito no se cumple, detenemos el pedido y el dinero se queda contigo — nadie cobra por un trabajo que no se hizo.',
  },
  {
    icon: 'shipping', n: '04', title: 'Entrega DDP a puerta',
    promise: 'Seguimiento y mercancía — no papeleo.',
    img: '/img/g-packing.webp', alt: 'Cajas selladas, etiquetadas y listas para la entrega a puerta',
    steps: [
      { t: 'Reserva y consolidación', time: 'Día 1–2', d: 'Elegimos el transportista, reservamos el espacio y consolidamos tus cajas en un solo envío.' },
      { t: 'Exportación y documentos', time: '2–3 días', d: 'Declaración de exportación, lista de empaque y factura comercial — preparadas y presentadas de nuestro lado.' },
      { t: 'Flete e importación', time: 'Aéreo 5–8 días · Marítimo 25–35 días', d: 'Flete aéreo o marítimo, con aranceles y aduanas despachados bajo DDP para que nada recaiga sobre ti.' },
      { t: 'Entrega a puerta', time: '1–3 días', d: 'Última milla hasta tu dirección o directo a Amazon, con seguimiento de extremo a extremo.' },
    ],
    checksLabel: 'Qué está incluido',
    checks: [
      { k: 'DDP puerta a puerta', v: 'Un solo precio desde la puerta de la fábrica hasta la tuya — sin facturas de aduana sorpresa.' },
      { k: 'Aranceles e impuestos', v: 'Incluidos en la cotización, detallados por separado para que los veas.' },
      { k: 'Seguimiento en vivo', v: 'Un número de seguimiento que funciona desde la salida hasta la entrega.' },
      { k: 'Lista de empaque y factura', v: 'El papeleo que Amazon y tu forwarder te van a pedir.' },
      { k: 'FBA o tu dirección', v: 'Entregado a un almacén de Amazon o a ti — tú eliges al reservar.' },
    ],
    fail: 'Si un envío se retrasa, se retiene o se pierde, perseguimos al transportista y presentamos el reclamo. El papeleo es nuestro problema, no tuyo.',
  },
];
---
<BaseLayout title="FBA Sourcing & Inspection: Proveedores y Logística Amazon" description="Servicios FBA: búsqueda de proveedores, inspección de productos, logística y soporte para 1688. Precios transparentes, fotografía y almacenaje incluidos." lang="es" ogImage="/covers/samples/fba-sourcing-inspection-social.jpg">

  <PageHero
    overline="Qué Hacemos"
    title="Sourcing FBA<br/><em style='font-style:italic;color:var(--avo-300)'>&amp; Inspección</em>"
    subtitle="Un solo paquete — desde la búsqueda del proveedor hasta una caja lista para Amazon. Añade marca propia, fotografía, compras en 1688 o almacenaje cuando los necesites."
  />

  <!-- ═══ Paquete principal ═══ -->
  <section class="section">
    <div class="container">
      <div class="core reveal">
        <div class="core__aside">
          <span class="tag tag-seal">Paquete principal</span>
          <h2>Sourcing FBA<br/><em>&amp; Inspección</em></h2>
          <p class="core__lead">El único paquete que recomendamos a cada vendedor FBA. Todo lo que hace falta para pasar de «quiero vender esto» a una caja etiquetada, inspeccionada y lista para Amazon — gestionado por un solo agente.</p>
          <div class="core__price">
            <span class="core__price-label">Cómo se cobra</span>
            <p>Tarifa de agencia 5–8% · inspección 150 $/día · preparación FBA por unidad — todo detallado en una sola cotización.</p>
          </div>
          <a href="/es/contact" class="btn btn-primary">
            Cotización gratis
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
        </div>

        <ol class="core__list">
          {coreIncludes.map((c, i) => (
            <li class:list={['core-step reveal', `reveal-delay-${i}`]}>
              <span class="core-step__n">{c.n}</span>
              <div>
                <h4>{c.title}</h4>
                <p>{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Ejemplo de pedido de 1.000 $ -->
      <div class="price-example price-example--inline reveal">
        <p class="price-example__title">Ejemplo real — un pedido de 1.000 $</p>
        <div class="price-example__rows">
          <div class="price-example__row"><span>Precio del proveedor (mercancía)</span><span>1.000 $</span></div>
          <div class="price-example__row"><span>Tarifa de agencia (8%)</span><span>80 $</span></div>
          <div class="price-example__row"><span>Flete</span><span>según cotización real</span></div>
          <div class="price-example__row price-example__row--total"><span>Tu costo completo</span><span>Sin cargos ocultos</span></div>
        </div>
        <p class="price-example__foot">Precio del proveedor + tarifa de agencia + flete = todo lo que pagas. Nada más.</p>
      </div>
    </div>
  </section>

  <!-- ═══ Servicios adicionales ═══ -->
  <section class="section bg-parchment">
    <div class="container">
      <div class="add-head reveal">
        <p class="overline">Servicios adicionales</p>
        <h2>Complementos Opcionales<br/><em>Cuando los Necesitas</em></h2>
        <p class="add-lead">Cada complemento resuelve un problema concreto. Tómalos por separado, o combínalos con tu paquete principal.</p>
      </div>

      <div class="addons">
        {addOns.map((a, i) => (
          <article class:list={['addon reveal', `reveal-delay-${i}`]}>
            <div class="addon__media">
              <ImgPlaceholder src={'/img/'+svcImg[a.seed]+'.webp'} seed={a.seed} width={520} height={390} ratio="4/3" alt={a.title} />
            </div>
            <div class="addon__body">
              <span class="addon__icon"><Icon name={a.icon} size={24} color="var(--seal)" /></span>
              <h3>{a.title}</h3>
              <dl class="addon__rows">
                <div><dt>Problema que resuelve</dt><dd>{a.problem}</dd></div>
                <div><dt>Qué hacemos</dt><dd>{a.process}</dd></div>
                <div><dt>Cómo se cobra</dt><dd>{a.pricing}</dd></div>
              </dl>
              <a href="/es/contact" class="addon__link">Consulta por esto
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Proceso — ledger 时间线 ═══ -->
  <section class="section">
    <div class="container">
      <div class="tl-head reveal">
        <p class="overline">Nuestro Proceso</p>
        <h2>Cómo Fluye un Pedido<br/><em>Típico</em></h2>
      </div>
      <ol class="ledger-list">
        {steps.map((step, i) => (
          <li class:list={['ledger-item reveal', `reveal-delay-${Math.min(i, 3)}`]}>
            <span class="ledger-item__day">{step.day}</span>
            <span class="ledger-item__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="ledger-item__body">
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ Precios independientes ═══ -->
  <section class="section bg-parchment">
    <div class="container pricing__wrap">
      <div class="pricing__intro reveal">
        <p class="overline">Precios Transparentes</p>
        <h2>Sin «Contáctanos<br/><em>por el Precio»</em></h2>
        <p class="pricing__lead">Cada pedido se cotiza línea por línea antes de que comprometas un dólar. Aquí está la estructura de tarifas, a la vista.</p>
      </div>

      <div class="pricing__right">
        <ul class="pricetable reveal reveal-delay-1">
          {pricingFees.map(f => (
            <li>
              <span class="pricetable__label">{f.label}</span>
              <span class="pricetable__value">{f.value}</span>
              <span class="pricetable__note">{f.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ Nuestras Garantías, en detalle —— 四个承诺各自展开（proceso / criterio / si falla） ═══ -->
  <section class="section--tight" id="guarantees">
    <div class="container">
      <div class="guar-head reveal">
        <p class="overline">Nuestras Garantías, en Detalle</p>
        <h2>Lo que Realmente<br/><em>Significa Cada Promesa</em></h2>
        <p class="guar-lead">La promesa está en la portada. Aquí está la maquinaria detrás — cuántos pasos, cuánto tarda cada uno, el criterio exacto que aplicamos y qué pasa el día que algo sale mal.</p>
      </div>

      <div class="gmods">
        {guaranteeModules.map((m, i) => (
          <article class:list={['gmod reveal', i % 2 === 1 && 'gmod--flip']}>
            <div class="gmod__media">
              <ImgPlaceholder class="gmod__img" src={m.img} seed={700 + i} width={640} height={800} ratio="4/5" alt={m.alt} />
              <span class="gmod__n">{m.n}</span>
            </div>

            <div class="gmod__body">
              <span class="gmod__icon"><Icon name={m.icon} size={24} color="var(--seal)" /></span>
              <h3>{m.title}</h3>
              <p class="gmod__promise">{m.promise}</p>

              <div class="gmod__cols">
                <div class="gmod__col">
                  <h4 class="gmod__label">Cómo funciona</h4>
                  <ol class="gmod__steps">
                    {m.steps.map((s, j) => (
                      <li>
                        <span class="gmod__step-n">{String(j + 1).padStart(2, '0')}</span>
                        <div>
                          <span class="gmod__step-t">{s.t}</span>
                          <span class="gmod__step-time">{s.time}</span>
                          <p>{s.d}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="gmod__col">
                  <h4 class="gmod__label">{m.checksLabel}</h4>
                  <ul class="gmod__checks">
                    {m.checks.map(c => (
                      <li>
                        <span class="gmod__check-k">{c.k}</span>
                        <span class="gmod__check-v">{c.v}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <p class="gmod__fail"><span class="gmod__fail-tag">Si esto falla</span>{m.fail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="faq-head reveal">
        <p class="overline">Preguntas</p>
        <h2>Preguntas<br/><em>Frecuentes</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class:list={['faq-item reveal', `reveal-delay-${i % 3}`]}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <span class="seal cta-seal" aria-hidden="true"><span>Empieza</span><span>Ya</span></span>
      <p class="overline overline--light reveal">Empieza Ahora</p>
