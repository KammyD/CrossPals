---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { PHONE } from '../../config/site';
import { getCollection } from 'astro:content';
import { defaultLang, entriesForLang, baseSlug, contentLink } from '../../i18n/utils';

/* 本页语言 —— 脚手架复制出 /<prefix>/index.astro 时会改成 `const PAGE_LANG = '<语言码>';` */
const PAGE_LANG = 'hi';

/* ── 服务（每项带一条独立定价说明） ── */
const services: Array<{ icon: IconName; n: string; title: string; body: string; price: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',    n: '01', title: 'Product Sourcing',     body: 'We search thousands of Chinese suppliers — 1688, Alibaba, and direct factory networks — to find the exact match for your budget and standards.', price: '<b>$1,000</b> order → <b>$80</b> sourcing fee (8%). We push the unit price down and add no markup to it.', seed: 10, hint: '义乌商品城/供应商展会场景', delay: 0 },
  { icon: 'inspection',  n: '02', title: 'Quality Inspection',   body: 'Physical inspection at the factory before your goods ship. Detailed photo report, defect counts, and a clear pass/fail so you never ship blind.', price: '<b>$1,000</b> order → <b>$150</b> flat inspection (half-day). Full photo report included.', seed: 20, hint: '质检员工作照/工厂内部', delay: 1, featured: true },
  { icon: 'payment',     n: '03', title: 'Purchasing & Payment', body: 'We negotiate in Chinese and handle all payments to verified suppliers. Your money is protected at every step — no wires to strangers.', price: '<b>$1,000</b> order → 30% deposit / 70% after QC. <b>5–8%</b> handling, no hidden markups.', seed: 30, hint: '签约/握手/合同场景', delay: 2 },
  { icon: 'shipping',    n: '04', title: 'Shipping & Logistics', body: 'Door-to-door worldwide. We compare air, sea, and express options, then handle customs docs and give you real-time tracking.', price: '<b>$1,000</b> order → freight at the carrier\'s live quote. <b>$0</b> added on top.', seed: 40, hint: '集装箱港口/货运飞机', delay: 3 },
];

/* ── 三个真实 FBA 卖家场景（Facebook 群组每天都在发的帖） ── */
const scenarios: Array<{ quote: string; tag: string; title: string; body: string; cta: string }> = [
  { quote: 'I ordered 500 units and got 30% defects.', tag: 'Inspected before it ships', title: 'Quality Inspection',
    body: 'We check the whole batch at the factory — measuring, testing, and counting defects on camera. If the pass rate falls short, the supplier reworks or replaces before a single box leaves China.',
    cta: 'See how inspection works' },
  { quote: 'My supplier disappeared after I paid.', tag: 'Verified before you pay', title: 'Supplier Verification',
    body: 'We never wire a supplier we have not verified. Business licence, factory address, export history, and a live video walkthrough — checked before you release a deposit, not after.',
    cta: 'See how we vet suppliers' },
  { quote: 'I don\'t know if my product meets FBA requirements.', tag: 'FBA-ready before it leaves', title: 'FBA Prep',
    body: 'We label, poly-bag, bundle, weigh, and measure to Amazon\'s exact spec — then hand you carton labels and a packing list that clears receiving the first time.',
    cta: 'See FBA prep' },
];

/* ── 独立质检模块：5 项质检标准 ── */
const inspectionStandards: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'Appearance',      body: 'Surface, colour, print and finish checked against your approved sample.' },
  { n: '02', title: 'Dimensions',      body: 'Length, width, weight and tolerances measured with calipers and scales.' },
  { n: '03', title: 'Function test',   body: 'Every sampled unit powered on, assembled or used the way your customer will.' },
  { n: '04', title: 'Packaging',       body: 'Retail box, inserts and poly-bag integrity — plus transit-drop readiness.' },
  { n: '05', title: 'FBA label check', body: 'FNSKU, carton labels, suffocation warnings, and Amazon barcode scannability.' },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Day 1',    title: 'Submit your product',      body: 'Tell us the product, quantity, quality bar, and budget via our simple form.' },
  { day: 'Day 2',    title: 'Vetted supplier options',  body: '3–5 verified suppliers with pricing and profiles, in your inbox within 48 hours.' },
  { day: 'Day 7–20', title: 'We buy & inspect',         body: 'We pay the supplier, oversee production, and send a full QC photo report before anything ships.' },
  { day: 'Day 21+',  title: 'FBA-ready, delivered',     body: 'Goods leave China labelled and packed to Amazon spec, customs handled, with tracking.' },
];

/* ── 证言：FBA 卖家格式（品类 / 订单 / 问题 / 结果） ── */
const testiFeatured = {
  quote: 'I sell kitchen gadgets on Amazon US. CrossPals sourced my hero product, caught 15 defective units before shipping, and got everything FBA-ready in 18 days. Reordered twice since.',
  name: 'Marcus T.', meta: 'Amazon seller · United States · Kitchen & Dining',
  result: '15 defects caught pre-ship · FBA-ready in 18 days', avatar: '/img/avatar-nigeria.webp',
};
const testiSmall = [
  { quote: 'First private-label order — 800 units of pet supplies. They verified the factory, caught a packaging problem, and it hit FBA without a single rejection.',
    name: 'Ana R.', meta: 'Amazon FBA · Spain · Pet Supplies', result: '0 FBA rejections', avatar: '/img/avatar-mexico.webp' },
  { quote: 'My previous supplier ghosted me after the deposit. CrossPals vetted a new one, ran the QC themselves, and I never sent money to a stranger again.',
    name: 'David O.', meta: 'Amazon & Shopify · United Kingdom · Home & Garden', result: '2 reorders', avatar: '/img/avatar-uk.webp' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: 'No Language Barrier',  body: 'We negotiate directly in Chinese — you get factory prices, not tourist prices.' },
  { icon: 'trust',        n: '02', title: 'Real Accountability',   body: 'A dedicated agent manages your order. You get one person, not a ticket queue.' },
  { icon: 'handshake',    n: '03', title: 'Built for FBA Sellers', body: 'Everything we do ends in an Amazon-ready carton: sourced, inspected, labelled, packed.' },
  { icon: 'transparent',  n: '04', title: 'Transparent Costs',     body: 'Supplier price + freight + our fee. You see every number before committing.' },
];

/* 首页只给承诺（结果），不说过程；过程全部放到 Services 页的展开模块 */
const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: 'Verified suppliers only', body: 'We vet every supplier before you pay a cent.' },
  { icon: 'inspection', title: 'QC before shipping',      body: 'Photo report + pass/fail before your money moves.' },
  { icon: 'payment',    title: 'Payment protection',      body: 'We hold funds until milestones clear. No wires to strangers.' },
  { icon: 'shipping',   title: 'DDP door delivery',       body: 'Tracking and goods — not paperwork.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'Agent fee',     value: '5–8% of order value', note: '$10,000 order = $600 agent fee' },
  { label: 'Inspection',    value: '$150 / day',          note: 'Most orders finish in half a day' },
  { label: 'FBA Prep',      value: 'Per unit',            note: 'Itemised line-by-line on your quote' },
  { label: 'Freight',       value: 'At carrier quote',    note: 'Nothing added on top of the carrier price' },
];

/* Resources：自动取最新 3 篇文章（来自 src/content/blog/*.md —— 加文章即自动出现在首页） */
const blogPosts = entriesForLang((await getCollection('blog')).filter(p => !p.data.draft), PAGE_LANG)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map(p => ({ slug: p.slug, cat: p.data.category, title: p.data.title, time: p.data.readTime, cover: p.data.cover }));

const svcImg: Record<number,string> = {10:'sourcing-1688',20:'inspection',30:'payment',40:'shipping'};
const guarImg: Record<string,string> = {trust:'factory',inspection:'inspection',payment:'payment',shipping:'shipping'};
const tickerItems = ['FBA Prep', 'Pre-Shipment QC', '1688 Sourcing', 'Supplier Verification', 'DDP Shipping', 'Private Label', 'Product Photography', 'Amazon FBA', 'HeBei · BaoDing → World', 'QC Photo Reports', 'No Hidden Fees'];
const categories = ['Kitchen & Dining', 'Home & Garden', 'Pet Supplies', 'Toys & Games', 'Sports & Outdoors', 'Beauty & Personal Care', 'Electronics Accessories', 'Office Products'];
---
<BaseLayout
  title="Amazon सेलर्स का विश्वसनीय सोर्सिंग पार्टनर"
  description="CrossPals, FBA के लिए उत्पादों को सोर्स, निरीक्षण और तैयार करता है — सप्लायर वेरिफिकेशन, प्री-शिपमेंट QC, और FBA प्रीप, ताकि आप सप्लायर्स पर नहीं बल्कि सेलिंग पर ध्यान दे सकें।"
 lang="hi">

<!-- ═══ 顶部深色带：公告条 + 刊头信息行 ═══ -->
<div class="topband">
  <a href="/hi/contact" class="announce announce--dark">
    <span class="announce__dot" aria-hidden="true"></span>
    <span><strong>नया:</strong>पहली बार आयात करने वालों के लिए मुफ्त सोर्सिंग परामर्श — 48 घंटे में आपूर्तिकर्ता शॉर्टलिस्ट</span>
    <span class="announce__arrow" aria-hidden="true">→</span>
  </a>

  <div class="masthead">
    <div class="container masthead__inner">
      <span>CrossPals · चीन सोर्सिंग मैनुअल</span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span>अंक Nº01 — MMXXVI</span>
    </div>
  </div>
</div>

<!-- ═══ HERO — 面向 Amazon 卖家 ═══ -->
<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">FBA विक्रेताओं के लिए चीन से सोर्सिंग</p>
        <h1 class="hero__title">Amazon विक्रेताओं का विश्वसनीय सोर्सिंग पार्टनर — <em>गुणवत्ता निरीक्षण शामिल।</em></h1>
        <p class="hero__lead">हम FBA के लिए आपके उत्पादों को सोर्स, निरीक्षण और तैयार करते हैं — ताकि आप आपूर्तिकर्ताओं की जगह बिक्री पर ध्यान दे सकें।</p>

        <p class="hero__sidenote">चित्र 00 — अधिकांश FBA विक्रेता भाषा अंतराल, नकली आपूर्तिकर्ताओं और अंधी शिपमेंट के कारण पैसा खो देते हैं। हम इन तीनों को बंद कर देते हैं।</p>

        <div class="hero__actions">
          <a href="/hi/contact" class="btn btn-primary">
            मुफ्त कोटेशन प्राप्त करें
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href="/hi/services" class="btn btn-ghost">यह कैसे काम करता है देखें</a>
        </div>

        <ul class="hero__index">
          <li><span>01</span> Source</li>
          <li><span>02</span> Inspect</li>
          <li><span>03</span> FBA के लिए तैयारी</li>
          <li><span>04</span> Deliver</li>
        </ul>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__photo-fill">
        <ImgPlaceholder src="/img/hero-warehouse.webp" seed={42} width={900} height={1100} ratio="9/11" priority
          alt="चीन फैक्टरी वेयरहाउस — CrossPals सोर्सिंग" />
      </div>
      <div class="hero__cap">
        <span class="hero__cap-label">चित्र. 01</span>
        <span class="hero__cap-text">हेबेई · बाओडिंग, चीन</span>
        <span class="seal seal--sm" aria-hidden="true"><span>Verified</span><span>Agent</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TICKER ═══ -->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[...tickerItems, ...tickerItems].map(t => <span class="ticker__item">{t}</span>)}
  </div>
</div>

<!-- ═══ 信任带：服务场景标识 + 数字指标（替代原来的国家旗帜列表） ═══ -->
<section class="trustbar" aria-label="हम क्या संभालते हैं और हम किनकी सेवा करते हैं">
  <div class="container">
    <p class="overline" style="margin-bottom:var(--s4);">Amazon और Shopify विक्रेताओं के लिए सोर्सिंग, निरीक्षण और तैयारी</p>
    <div class="regionwall reveal">
      {categories.map(c => <span>{c}</span>)}
    </div>
    <ul class="trustmetrics reveal reveal-delay-1">
      <li><b>47</b><span>सेवा प्राप्त Amazon विक्रेता</span></li>
      <li><b>$2.3M<em>+</em></b><span>सोर्स किया गया सामान</span></li>
      <li><b>98<em>%</em></b><span>समय पर वितरण</span></li>
    </ul>
  </div>
</section>

<!-- ═══ SERVICES — 每项带独立定价说明 ═══ -->
<section class="section svc ledger">
  <div class="container svc__wrap">
    <aside class="svc__aside">
      <p class="overline">हम क्या करते हैं</p>
      <h2 class="svc__h">एंड-टू-एंड<br/><em>चीन सोर्सिंग</em></h2>
      <p class="svc__intro">चार अनुशासन, एक जिम्मेदार एजेंट। आपका पैसा ट्रांसफर होने से पहले प्रत्येक चरण दस्तावेजीकृत, फोटोग्राफ़ और मूल्य निर्धारित किया जाता है।</p>
      <a href="/hi/services" class="svc__all">पूर्ण सेवा सूचकांक →</a>
    </aside>

    <ol class="svc__list">
      {services.map(s => (
        <li class:list={['svc-row reveal', `reveal-delay-${s.delay}`]}>
          <div class="svc-row__num"><span class="indexnum">{s.n}</span></div>
          <div class="svc-row__thumb">
            <ImgPlaceholder src={'/img/'+svcImg[s.seed]+'.webp'} seed={s.seed} width={360} height={240} ratio="3/2" alt={s.title} />
          </div>
          <div class="svc-row__body">
            <div class="svc-row__top">
              <h3>{s.title}</h3>
            </div>
            <div class="lede-row">
              <p>{s.body}</p>
              <a href="/hi/services" class="svc-row__link">और जानें<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
            <div class="price-note">
              <span class="price-note__label">Price</span>
              <span class="price-note__calc" set:html={s.price} />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═══ HOW IT WORKS ═══ -->
<section class="section hiw grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="hiw__head reveal">
      <p class="overline overline--light">Process</p>
      <h2 class="text-white">सप्लायर से<br/><em style="color:var(--avo-300)">4 चरणों में FBA-तैयार</em></h2>
    </div>

    <div class="manifest reveal reveal-delay-1">
      {steps.map((step, i) => (
        <div class:list={['manifest__col', { 'manifest__col--end': i === steps.length - 1 }]}>
          <span class="manifest__day">{step.day}</span>
          <span class="manifest__n">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="manifest__title">{step.title}</h4>
          <p class="manifest__body">{step.body}</p>
        </div>
      ))}
      <div class="manifest__stamp" aria-hidden="true">
        <span class="seal"><span>Cross</span><span>पाल्स ✓</span></span>
      </div>
    </div>

    <div class="hiw__cta reveal reveal-delay-2">
      <a href="/hi/contact" class="btn btn-primary">मुफ्त उद्धरण प्राप्त करें</a>
      <a href="/hi/case-studies" class="btn btn-ghost">केस स्टडीज़ देखें</a>
    </div>
  </div>
</section>

<!-- ═══ 三个真实 FBA 卖家场景（解决痛点） ═══ -->
<section class="section scen">
  <div class="container">
    <div class="scen__head reveal">
      <p class="overline">जिन समस्याओं का हम समाधान करते हैं</p>
      <h2>हर अमेज़न सेलर की तीन पोस्टें<br/><em>ये वो धागे हैं जो रोज़ अमेज़न सेलर समूहों में दिखते हैं। हम प्रत्येक का ठीक यही जवाब देते हैं।</em></h2>
      <p class="scen__lead">— FBA सेलर फोरम पोस्ट</p>
    </div>

    <div class="scen__list">
      {scenarios.map((s, i) => (
        <article class:list={['scen-item reveal', `reveal-delay-${i}`]}>
          <div class="scen-item__quote">
            <span class="scen-item__mark" aria-hidden="true">“</span>
            <p>{s.quote}</p>
            <span class="scen-item__src">गुणवत्ता निरीक्षण</span>
          </div>
          <div class="scen-item__sol">
            <span class="tag tag-seal">{s.tag}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <a href="/hi/services" class="scen-item__link">{s.cta}
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 独立质检模块（差异化武器） ═══ -->
<section class="section inspect grain" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="inspect__head reveal">
      <p class="overline overline--light">हर ऑर्डर के साथ आता है</p>
      <h2 class="text-white">पूर्ण निरीक्षण रिपोर्ट।<br/><em>सिर्फ़ एक बॉक्स की तस्वीर नहीं। पाँच मानकों के खिलाफ़ एक संरचित, पंक्ति-दर-पंक्ति रिपोर्ट — हर ऑर्डर पर, हर ऑर्डर साइज़ में, माल भेजने से पहले आपको भेजी जाती है।</em></h2>
      <p class="inspect__lead">क्रॉसपाल्स · प्री-शिपमेंट निरीक्षण</p>
    </div>

    <div class="inspect__grid">
      <ol class="inspect__std reveal">
        {inspectionStandards.map((s, i) => (
          <li class:list={['inspect-std', `reveal-delay-${i}`]}>
            <span class="inspect-std__n">{s.n}</span>
            <div>
              <h4>{s.title}</h4>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <!-- 样例质检报告（客户/供应商信息打码） -->
      <div class="qcreport reveal reveal-delay-2">
        <div class="qcreport__head">
          <span class="qcreport__brand">क्रॉसपाल्स · प्री-शिपमेंट इंस्पेक्शन</span>
          <span class="qcreport__no">रिपोर्ट संख्या CP-2026-0418</span>
        </div>
        <dl class="qcreport__grid">
          <div><dt>Product</dt><dd>स्टेनलेस-स्टील किचन गैजेट</dd></div>
          <div><dt>ऑर्डर मात्रा</dt><dd>1,000 पीसी</dd></div>
          <div><dt>नमूना आकार</dt><dd>80 पीसी (AQL 2.5)</dd></div>
          <div><dt>Where</dt><dd>फैक्ट्री में, शिपमेंट पूर्व</dd></div>
        </dl>
        <ul class="qcreport__checks">
          <li><span>Appearance</span><span class="ok">Pass</span></li>
          <li><span>Dimensions</span><span class="ok">Pass</span></li>
          <li><span>फंक्शन टेस्ट</span><span class="ok">Pass</span></li>
          <li><span>Packaging</span><span class="warn">12 पीसी दोबारा काम किया गया</span></li>
          <li><span>FBA लेबल जांच</span><span class="ok">Pass</span></li>
        </ul>
        <div class="qcreport__result">
          <span class="qcreport__verdict">PASS</span>
          <span>पैकिंग से पहले 12 मामूली कॉस्मेटिक दोषों को रिजेक्ट कर सप्लायर द्वारा बदल दिया गया।</span>
        </div>
        <p class="qcreport__note">नमूना रिपोर्ट - क्लाइंट और सप्लायर विवरण छिपाए गए। हर ऑर्डर के साथ इस तरह की रिपोर्ट शिप की जाती है।</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIALS — FBA 卖家格式 ═══ -->
<section class="section testi">
  <div class="container">
    <div class="testi__head reveal">
      <p class="overline">सफलता की कहानियाँ</p>
