        <button type="submit" class="btn btn-primary">क्वोट प्राप्त करें<svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
        </button>
      </form>
      <p class="cta-final__note">Or <a href={PHONE.wa}>WhatsApp पर चैट करें</a> · निःशुल्क, कोई प्रतिबद्धता नहीं</p>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* TOPBAND */
.topband{background:var(--avo-950);padding-top:var(--hdr-h);}
.announce--dark{background:transparent;border-bottom:1px solid rgba(255,255,255,.08);color:rgba(232,229,218,.82);}
.announce--dark strong{color:var(--seal);font-weight:600;}
.announce--dark:hover{background:rgba(255,255,255,.05);}
.announce--dark:hover .announce__arrow{transform:translateX(3px);}

/* MASTHEAD */
.masthead{background:var(--avo-950);border-bottom:1px solid rgba(255,255,255,.08);}
.masthead__inner{display:flex;align-items:center;gap:var(--s4);padding:10px var(--s5);font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);}
.masthead__rule{flex:1;height:1px;background:rgba(255,255,255,.1);}

/* HERO */
.hero{background:var(--avo-950);min-height:min(78vh,680px);display:flex;flex-direction:column;}
.hero__grid{display:grid;grid-template-columns:1.05fr 0.95fr;flex:1;min-height:0;}
.hero__left{display:flex;align-items:center;padding:84px var(--s7) var(--s7) var(--s7);}
.hero__left-inner{max-width:600px;}
.hero__title{color:#fff;font-size:clamp(32px,4.1vw,54px);line-height:1.06;margin:var(--s2) 0 var(--s4);font-weight:560;}
.hero__title em{font-style:italic;color:var(--seal);font-weight:400;}
.hero__lead{color:rgba(255,255,255,.66);font-size:16.5px;line-height:1.7;max-width:500px;margin-bottom:var(--s4);}
.hero__sidenote{font-family:var(--font-mono);font-size:11px;line-height:1.6;color:rgba(255,255,255,.4);border-left:1px solid var(--seal);padding-left:var(--s3);max-width:440px;margin-bottom:var(--s5);}
.hero__actions{display:flex;gap:var(--s3);flex-wrap:wrap;margin-bottom:var(--s5);}
.hero__index{list-style:none;display:flex;flex-wrap:wrap;gap:var(--s5);padding-top:var(--s4);border-top:1px solid rgba(255,255,255,.1);}
.hero__index li{display:flex;align-items:baseline;gap:6px;font-family:var(--font-serif);font-size:15px;color:rgba(255,255,255,.7);}
.hero__index li span{font-family:var(--font-mono);font-size:10px;color:var(--seal);letter-spacing:.08em;}

.hero__right{position:relative;overflow:hidden;display:flex;}
.hero__photo-fill{position:absolute;inset:0;}
.hero__photo-fill :global(.img-ph){height:100%;}
.hero__photo-fill :global(.img-ph__wrap){padding-top:0!important;height:100%;}
.hero__photo-fill :global(img){width:100%;height:100%;object-fit:cover;}
.hero__cap{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:var(--s4);padding:var(--s4) var(--s5);background:linear-gradient(0deg,rgba(28,33,20,.9),transparent);}
.hero__cap-label{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--avo-300);}
.hero__cap-text{font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:rgba(255,255,255,.7);text-transform:uppercase;flex:1;}
.hero__cap .seal{transform:rotate(-8deg);background:rgba(28,33,20,.4);border-color:var(--seal);color:#fff;backdrop-filter:blur(2px);}

/* TRUSTBAR */
.trustbar{padding:var(--section-y-sm) var(--s5);background:var(--bg-page);border-bottom:1px solid var(--border-light);}
.trustmetrics{list-style:none;display:flex;flex-wrap:wrap;gap:var(--s6);margin-top:var(--s5);padding-top:var(--s5);border-top:1px solid var(--border-light);}
.trustmetrics li{display:flex;align-items:baseline;gap:var(--s3);}
.trustmetrics b{font-family:var(--font-serif);font-size:clamp(28px,3.4vw,40px);font-weight:600;color:var(--avo-700);line-height:1;}
.trustmetrics b em{font-style:normal;color:var(--seal);}
.trustmetrics span{font-family:var(--font-mono);font-size:12px;letter-spacing:.03em;color:var(--text-muted);}

/* SERVICES */
.svc{background:var(--bg-page);}
.svc__wrap{display:grid;grid-template-columns:300px 1fr;gap:var(--s7);align-items:start;}
.svc__aside{position:sticky;top:100px;}
.svc__h em{font-style:italic;color:var(--avo-600);}
.svc__intro{font-size:15px;line-height:1.7;color:var(--text-body);margin:var(--s4) 0;}
.svc__all{font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;color:var(--seal);text-transform:uppercase;}
.svc__list{list-style:none;display:flex;flex-direction:column;}
.svc-row{display:grid;grid-template-columns:56px 180px 1fr;gap:var(--s5);align-items:center;padding:var(--s5) 0;border-top:1px solid var(--border-light);}
.svc-row:last-child{border-bottom:1px solid var(--border-light);}
.svc-row__num .indexnum{font-size:40px;}
.svc-row__thumb :global(.img-ph){border:1px solid var(--border-light);}
.svc-row__top{display:flex;align-items:center;gap:var(--s3);margin-bottom:var(--s2);flex-wrap:wrap;}
.svc-row__body .lede-row{margin-top:var(--s2);}
.svc-row__body h3{font-size:clamp(19px,2.1vw,25px);}
.svc-row__body p{font-size:14px;line-height:1.65;margin:0;max-width:520px;}
.svc-row__link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--seal);transition:gap var(--t-fast);}
.svc-row__link:hover{gap:10px;}
.svc-row{transition:background var(--t-med),color var(--t-med);}
.svc-row:hover{background:var(--avo-950);}
.svc-row:hover .svc-row__body h3{color:#fff;}
.svc-row:hover .svc-row__body p{color:rgba(255,255,255,.62);}
.svc-row:hover .svc-row__num .indexnum{color:var(--avo-300);}
.svc-row:hover .svc-row__thumb :global(.img-ph){border-color:rgba(255,255,255,.15);}
.svc-row:hover .svc-row__link{color:var(--avo-300);}
.svc-row__body h3,.svc-row__body p,.svc-row__link,.svc-row__num .indexnum{transition:color var(--t-med);}
/* 每项服务的独立定价说明 */
.price-note{display:flex;align-items:flex-start;gap:var(--s3);margin-top:var(--s4);padding-top:var(--s3);border-top:1px dashed var(--border-mid);max-width:560px;}
.price-note__label{flex-shrink:0;font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--seal);padding-top:2px;}
.price-note__calc{font-size:13px;line-height:1.55;color:var(--text-muted);}
.price-note__calc b{color:var(--avo-800);font-weight:600;}
.svc-row:hover .price-note{border-top-color:rgba(255,255,255,.2);}
.svc-row:hover .price-note__calc{color:rgba(255,255,255,.6);}
.svc-row:hover .price-note__calc b{color:var(--avo-300);}

/* HOW IT WORKS */
.guar-head{margin-bottom:var(--s6);}
.guar-head h2 em{font-style:italic;color:var(--avo-600);}
.guar-lede{margin-top:var(--s6);padding-top:var(--s5);border-top:1px solid var(--border-light);}
.guar-lede p{font-size:14px;color:var(--text-muted);}
.hiw{background:var(--avo-950);}
.hiw__head{margin-bottom:var(--head-gap);}
.hiw__head h2 em{font-style:italic;color:var(--avo-300);}
.manifest{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.15);position:relative;}
.manifest__col{padding:var(--s5) var(--s5) var(--s6) 0;border-right:1px solid rgba(255,255,255,.08);}
.manifest__day{display:block;font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--seal);margin-bottom:var(--s3);}
.manifest__n{display:block;font-family:var(--font-serif);font-size:46px;font-weight:600;color:rgba(255,255,255,.1);line-height:1;margin-bottom:var(--s2);}
.manifest__title{color:#fff;font-size:18px;margin-bottom:var(--s2);}
.manifest__body{font-size:14px;color:rgba(255,255,255,.5);}
.manifest__stamp{position:absolute;right:0;top:-10px;}
.hiw__cta{display:flex;gap:var(--s4);flex-wrap:wrap;margin-top:var(--s6);}

/* SCENARIOS */
.scen{background:var(--warm-100);}
.scen__head{margin-bottom:var(--head-gap);max-width:720px;}
.scen__head h2 em{font-style:italic;color:var(--avo-600);}
.scen__lead{font-size:16px;line-height:1.7;color:var(--text-muted);margin-top:var(--s4);max-width:620px;}
.scen__list{display:flex;flex-direction:column;}
.scen-item{display:grid;grid-template-columns:1fr 1.15fr;gap:var(--s7);align-items:center;padding:var(--s6) 0;border-top:1px solid var(--border-light);}
.scen-item:last-child{border-bottom:1px solid var(--border-light);}
.scen-item__quote{position:relative;padding-left:var(--s6);}
.scen-item__mark{position:absolute;left:0;top:-14px;font-family:var(--font-serif);font-size:56px;line-height:1;color:var(--seal);opacity:.3;}
.scen-item__quote p{font-family:var(--font-serif);font-style:italic;font-size:clamp(19px,2.3vw,26px);line-height:1.4;color:var(--text-primary);}
.scen-item__src{display:block;margin-top:var(--s3);font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-faint);}
.scen-item__sol h3{font-size:clamp(18px,2vw,22px);margin:var(--s3) 0 var(--s3);}
