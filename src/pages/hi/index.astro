    </div>

    <div class="blog-prev__grid">
      {blogPosts.map((post, i) => (
        <a href={contentLink(PAGE_LANG, 'blog', post.slug)} class:list={['bcard', i === 0 ? 'bcard--feat' : 'bcard--sm', 'reveal', `reveal-delay-${i}`]}>
          <ImgPlaceholder
            src={post.cover}
            width={i === 0 ? 720 : 640}
            height={i === 0 ? 960 : 360}
            ratio={i === 0 ? '3/4' : '16/9'}
            alt={post.title}
          />
          <div class="bcard__body">
            <span class="bcard__cat">{post.cat}</span>
