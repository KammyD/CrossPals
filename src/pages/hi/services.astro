---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';

/* ── 核心服务包（主推产品）：一条龙 ── */
const coreIncludes: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'Supplier sourcing',   body: '3–5 verified suppliers with real pricing — licences, factory address, and export history checked before we quote.' },
  { n: '02', title: 'Sample confirmation', body: 'We order and evaluate the sample against your spec and your customer\'s expectations before you commit to bulk.' },
  { n: '03', title: 'Full-batch inspection', body: 'Pre-shipment QC at the factory: appearance, dimensions, function, packaging, and FBA label check.' },
  { n: '04', title: 'FBA Prep',            body: 'FNSKU labelling, poly-bagging, bundling, weighing and measuring to Amazon\'s exact specification.' },
  { n: '05', title: 'Freight coordination', body: 'Air, sea, or express compared; customs paperwork handled; door-to-door DDP with live tracking.' },
];

/* ── 附加服务：单独可选 ── */
const addOns: Array<{ icon: IconName; title: string; problem: string; process: string; pricing: string; seed: number }> = [
  { icon: 'package', title: 'Private Label & Packaging Design', seed: 71,
    problem: 'Your product needs to look like a brand, not a generic import — and weak packaging kills conversion.',
    process: 'Logo placement, box / bag / label artwork, insert cards, and MOQ negotiation with the packaging factory.',
    pricing: 'A flat design fee plus packaging at factory cost. MOQ typically 300–1,000 pcs.' },
  { icon: 'transparent', title: 'Product Photography', seed: 72,
    problem: 'Amazon buries — or blocks — listings whose main image doesn\'t meet the white-background standard.',
    process: 'White-background shots to Amazon main-image spec, plus lifestyle and infographic variants on request.',
    pricing: 'Per-image rate, cheaper at volume. Flat rate per SKU available.' },
  { icon: 'sourcing', title: '1688 Purchasing Service', seed: 73,
    problem: 'The lowest prices live on 1688 — but the site is Chinese-only and won\'t ship overseas.',
    process: 'Send a product link or photo. We buy from the 1688 seller, inspect, consolidate, and ship to you.',
    pricing: 'A percentage of order value with a small minimum. No Chinese required.' },
  { icon: 'shipping', title: 'Warehousing & Transshipment', seed: 74,
    problem: 'Buying from several suppliers means several international freight bills — and no one checking the goods.',
    process: 'We receive, inspect, repack, and consolidate multiple orders into a single shipment from our warehouse.',
    pricing: 'Storage per cubic metre per day, plus a consolidation fee per order.' },
];

const svcImg: Record<number,string> = {71:'blog-packaging',72:'blog-products',73:'sourcing-1688',74:'shipping'};
const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'Day 1',    title: 'You submit your product',    body: 'Product details, quantity, quality bar, and budget via our inquiry form.' },
  { day: 'Day 2',    title: 'We send supplier options',   body: '3–5 verified suppliers with quotes and profiles, ready for your review.' },
  { day: 'Day 3–5',  title: 'Sample & negotiation',       body: 'We confirm the sample, agree terms in Chinese, issue the PO, and release the deposit securely.' },
  { day: 'Day 7–20', title: 'Production & inspection',    body: 'Goods are made. We inspect the full batch and send a QC photo report before shipment.' },
  { day: 'Day 21+',  title: 'FBA-ready, delivered',       body: 'Goods leave China labelled and packed to Amazon spec, customs cleared, with live tracking.' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'Agent fee',  value: '5–8% of order value', note: '$10,000 order = $600 agent fee' },
  { label: 'Inspection', value: '$150 / day',          note: 'Most orders finish in half a day' },
  { label: 'FBA Prep',   value: 'Per unit',            note: 'Itemised line-by-line on your quote' },
  { label: 'Freight',    value: 'At carrier quote',    note: 'Nothing added on top of the carrier price' },
];

const faqs = [
  { q: 'What does the FBA Sourcing & Inspection package include?', a: 'Supplier sourcing, sample confirmation, full-batch inspection, FBA prep (labelling, bagging, weighing, measuring), and freight coordination — one accountable agent, one quote.' },
  { q: 'How much is your service fee?',                            a: 'Agent fee is 5–8% of order value. Inspection is $150/day (most orders finish in half a day). FBA prep is charged per unit. Everything is itemised on your quote before you commit.' },
  { q: 'What is your minimum order size?',                         a: 'No strict minimum, but we work best with orders of $300 USD or more. Smaller orders may have fewer supplier options.' },
  { q: 'What if goods fail inspection?',                           a: 'We work with the supplier to resolve — rework, replacement, or refund — before anything ships. We never release final payment without your approval.' },
  { q: 'Do you handle FBA prep and labelling?',                    a: 'Yes. FNSKU labels, poly-bagging, bundling, carton labels, weights and dimensions to Amazon\'s spec — so your shipment clears receiving the first time.' },
  { q: 'Can I get custom packaging with my logo?',                 a: 'Yes — that\'s our Private Label & Packaging add-on. Boxes, bags, labels, and hang tags. MOQ varies by supplier, typically 300–1,000 pieces.' },
];

/* ── Our Guarantees, in full ──
   首页只给「承诺」（结果）；这里把四个承诺各自展开：流程（几步/每步多久）+ 具体标准（清单）+ 失败兜底。
   图片刻意不用首页那四张（factory/inspection/payment/shipping），四张统一 1024×1280、统一 ratio="4/5"。 */
type GuaranteeModule = {
  icon: IconName; n: string; title: string; promise: string;
  img: string; alt: string;
  steps: Array<{ t: string; time: string; d: string }>;
  checksLabel: string;
  checks: Array<{ k: string; v: string }>;
  fail: string;
};
const guaranteeModules: GuaranteeModule[] = [
  {
    icon: 'trust', n: '01', title: 'Verified suppliers only',
    promise: 'We vet every supplier before you pay a cent.',
    img: '/img/g-market.webp', alt: 'Walking the wholesale market floor to vet suppliers in person',
    steps: [
      { t: 'Shortlist', time: 'Day 1–2', d: 'We pull 3–5 candidates from our own factory network and from 1688, matched to your product spec.' },
      { t: 'Paper check', time: 'Day 2–3', d: 'Business licence, registered address, production capacity, and export history — checked against the factory itself, not a sales page.' },
      { t: 'Live walkthrough', time: 'Day 3–5', d: 'A video call through the workshop: the real line, the real stock, the real sample.' },
    ],
    checksLabel: 'What we verify',
    checks: [
      { k: 'Licence & legal entity', v: 'Business licence matched to the name that will appear on your invoice.' },
      { k: 'Address vs. workshop', v: 'The registered address is cross-checked against where the goods are actually made.' },
      { k: 'Capacity & lead time', v: 'Whether they can hold your quantity, your deadline, and your reorder.' },
      { k: 'Export history', v: 'Past shipments and existing clients — who they already sell to abroad.' },
      { k: 'Live production line', v: 'Seen on video before a single dollar leaves your account.' },
    ],
    fail: 'If a factory cannot clear the paper check or refuses a live walkthrough, it never reaches your quote. We keep looking.',
  },
  {
    icon: 'inspection', n: '02', title: 'QC before shipping',
    promise: 'Photo report + pass/fail before your money moves.',
    img: '/img/g-production.webp', alt: 'Inspector checking goods on the production floor before shipment',
    steps: [
      { t: 'Book the inspection', time: 'Day before the batch closes', d: 'Scheduled against the production end date — not the ship date, so there is still time to fix things.' },
      { t: 'On-site full-batch check', time: 'Half a day, typical', d: 'We stand at the factory, count, measure, test, and photograph the batch ourselves.' },
      { t: 'Report & verdict', time: 'Same day', d: 'You receive the photo report with a clear pass/fail, the defect count, and the sampling standard used.' },
      { t: 'Rework or replace', time: '3–7 days', d: 'A fail goes straight back to the supplier for rework or replacement — then we re-inspect before packing.' },
    ],
    checksLabel: 'What we check',
    checks: [
      { k: 'Appearance', v: 'Surfaces, colour, finish, stitching, print, and visible damage — against the approved sample.' },
      { k: 'Dimensions', v: 'Weight and measurements to spec, with out-of-tolerance units flagged individually.' },
      { k: 'Function', v: 'Every sampled unit powered on, assembled, or used exactly as your customer will use it.' },
      { k: 'Packaging', v: 'Retail box, poly-bag, suffocation warning, inserts, and carton strength.' },
      { k: 'FBA labels', v: 'FNSKU barcodes scan, carton labels correct, weights and dimensions to Amazon spec.' },
    ],
    fail: 'If the batch fails, it does not ship. The supplier reworks or replaces it, and your balance stays with us until it passes.',
  },
  {
    icon: 'payment', n: '03', title: 'Payment protection',
    promise: 'We hold funds until milestones clear. No wires to strangers.',
    img: '/img/payment-escrow.webp', alt: 'Funds held against sealed cartons until each milestone clears',
    steps: [
      { t: 'PO written with milestones', time: 'Day 1', d: 'Deposit, production, inspection, and shipment are fixed as separate release points before anything starts.' },
      { t: 'Deposit released', time: 'Day 1–2', d: 'Only the agreed deposit goes out, and only after you approve the PO in writing.' },
      { t: 'Inspection gate', time: 'At QC', d: 'The production balance is not released until the inspection report comes back as a pass.' },
      { t: 'Final settlement', time: 'On your sign-off', d: 'The balance settles after you approve, with a written receipt on your invoice.' },
    ],
    checksLabel: 'How your money is held',
    checks: [
      { k: 'You approve every release', v: 'No payment moves without your written go-ahead at that milestone.' },
      { k: 'Supplier paid by us', v: 'We pay the factory directly — you never send money to an unknown account.' },
      { k: 'No personal accounts', v: 'Funds never go to a personal bank account or a third-party wallet.' },
      { k: 'No full prepayment', v: 'Nobody receives 100% up front — not the supplier, not us.' },
      { k: 'Receipt on every transfer', v: 'Each release is documented and itemised against your order.' },
    ],
    fail: 'If a milestone does not clear, we stop the order and the money stays with you — nobody is paid for work that did not happen.',
  },
  {
    icon: 'shipping', n: '04', title: 'DDP door delivery',
    promise: 'Tracking and goods — not paperwork.',
    img: '/img/g-packing.webp', alt: 'Cartons sealed, labelled and ready for door delivery',
    steps: [
      { t: 'Book & consolidate', time: 'Day 1–2', d: 'We choose the carrier, book the space, and consolidate your cartons into a single shipment.' },
      { t: 'Export & documents', time: '2–3 days', d: 'Export declaration, packing list, and commercial invoice — prepared and filed on our side.' },
      { t: 'Freight & import', time: 'Air 5–8 days · Sea 25–35 days', d: 'Air or sea freight, with duty and customs cleared under DDP so nothing lands on you.' },
      { t: 'Door delivery', time: '1–3 days', d: 'Last mile to your address or straight to Amazon, tracked end to end.' },
    ],
    checksLabel: 'What is included',
    checks: [
      { k: 'Door-to-door DDP', v: 'One price from the factory gate to your door — no surprise customs invoice.' },
      { k: 'Duty & taxes', v: 'Included in the quote, itemised separately so you can see it.' },
      { k: 'Live tracking', v: 'A tracking number that works from departure to delivery.' },
      { k: 'Packing list & invoice', v: 'The paperwork Amazon and your forwarder will ask for.' },
      { k: 'FBA or your address', v: 'Delivered to an Amazon warehouse or to you — your choice at booking.' },
    ],
    fail: 'If a shipment is delayed, held, or lost, we chase the carrier and file the claim. The paperwork is ours to fight, not yours.',
  },
];
---
<BaseLayout title="Services" description="एफबीए सोर्सिंग और निरीक्षण — आपूर्तिकर्ता सोर्सिंग, नमूना पुष्टिकरण, पूर्ण-बैच निरीक्षण, एफबीए प्रीप, और माल परिवहन समन्वय, साथ ही प्राइवेट लेबल, फोटोग्राफी, 1688 और वेयरहाउसिंग एड-ऑन। पारदर्शी मूल्य निर्धारण।" ogImage="/img/case-relabel.webp" lang="hi">

  <PageHero
    overline="हम क्या करते हैं"
    title="एफबीए सोर्सिंग<br/><em style='font-style:italic;color:var(--avo-300)'>&amp; निरीक्षण</em>"
    subtitle="एक पैकेज - आपूर्तिकर्ता खोज से लेकर Amazon-तैयार कार्टन तक। जब आवश्यक हो, प्राइवेट लेबल, फोटोग्राफी, 1688 खरीदारी, या वेयरहाउसिंग जोड़ें।"
  />

  <!-- ═══ 核心服务包 ═══ -->
  <section class="section">
    <div class="container">
      <div class="core reveal">
        <div class="core__aside">
          <span class="tag tag-seal">कोर पैकेज</span>
          <h2>एफबीए सोर्सिंग<br/><em>और निरीक्षण</em></h2>
          <p class="core__lead">हम हर एफबीए विक्रेता को सुझाने वाला एकल पैकेज। "मैं यह बेचना चाहता हूँ" से लेबल किया हुआ, निरीक्षित, अमेज़न-तैयार कार्टन तक का पूरा प्रक्रिया - एक एजेंट द्वारा संभाला जाता है।</p>
          <div class="core__price">
            <span class="core__price-label">कीमत कैसे तय होती है</span>
            <p>एजेंट शुल्क 5–8% · निरीक्षण $150/दिन · एफबीए प्रीपाई प्रति यूनिट - सभी एक कोटेशन पर दर्ज होते हैं।</p>
          </div>
          <a href="/hi/contact" class="btn btn-primary">मुफ़्त कोटेशन प्राप्त करें<svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
        </div>

        <ol class="core__list">
          {coreIncludes.map((c, i) => (
            <li class:list={['core-step reveal', `reveal-delay-${i}`]}>
              <span class="core-step__n">{c.n}</span>
              <div>
                <h4>{c.title}</h4>
                <p>{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- $1,000 订单说明 -->
      <div class="price-example price-example--inline reveal">
        <p class="price-example__title">कार्य उदाहरण — $1,000 का ऑर्डर</p>
        <div class="price-example__rows">
          <div class="price-example__row"><span>आपूर्तिकर्ता कीमत (माल)</span><span>$1,000</span></div>
          <div class="price-example__row"><span>एजेंट शुल्क (8%)</span><span>$80</span></div>
          <div class="price-example__row"><span>Freight</span><span>वास्तविक कोटेशन पर</span></div>
          <div class="price-example__row price-example__row--total"><span>आपकी कुल लागत</span><span>कोई छिपे शुल्क नहीं</span></div>
        </div>
        <p class="price-example__foot">आपूर्तिकर्ता कीमत + एजेंट शुल्क + मालभाड़ा = आपका कुल भुगतान। और कुछ नहीं।</p>
      </div>
    </div>
  </section>

  <!-- ═══ 附加服务 ═══ -->
  <section class="section bg-parchment">
    <div class="container">
      <div class="add-head reveal">
        <p class="overline">अतिरिक्त सेवाएँ</p>
        <h2>वैकल्पिक एड-ऑन<br/><em>जब आपको ज़रूरत हो</em></h2>
        <p class="add-lead">प्रत्येक एड-ऑन एक विशिष्ट समस्या का समाधान करता है। उन्हें अलग-अलग लें, या अपने कोर पैकेज में बंडल करें।</p>
      </div>

      <div class="addons">
        {addOns.map((a, i) => (
          <article class:list={['addon reveal', `reveal-delay-${i}`]}>
            <div class="addon__media">
              <ImgPlaceholder src={'/img/'+svcImg[a.seed]+'.webp'} seed={a.seed} width={520} height={390} ratio="4/3" alt={a.title} />
            </div>
            <div class="addon__body">
              <span class="addon__icon"><Icon name={a.icon} size={24} color="var(--seal)" /></span>
              <h3>{a.title}</h3>
              <dl class="addon__rows">
                <div><dt>यह किस समस्या का समाधान करता है</dt><dd>{a.problem}</dd></div>
                <div><dt>हम क्या करते हैं</dt><dd>{a.process}</dd></div>
                <div><dt>इसकी कीमत कैसे तय होती है</dt><dd>{a.pricing}</dd></div>
              </dl>
              <a href="/hi/contact" class="addon__link">इसके बारे में पूछें<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Process — ledger 时间线 ═══ -->
  <section class="section">
    <div class="container">
      <div class="tl-head reveal">
        <p class="overline">हमारी प्रक्रिया</p>
        <h2>एक सामान्य ऑर्डर कैसा होता है<br/><em>Flows</em></h2>
      </div>
      <ol class="ledger-list">
        {steps.map((step, i) => (
          <li class:list={['ledger-item reveal', `reveal-delay-${Math.min(i, 3)}`]}>
            <span class="ledger-item__day">{step.day}</span>
            <span class="ledger-item__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="ledger-item__body">
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 独立定价区块 ═══ -->
  <section class="section bg-parchment">
    <div class="container pricing__wrap">
      <div class="pricing__intro reveal">
        <p class="overline">पारदर्शी मूल्य निर्धारण</p>
        <h2>कोई "हमसे संपर्क करें" नहीं<br/><em>मूल्य के लिए</em></h2>
        <p class="pricing__lead">हर ऑर्डर को आपके पैसे लगाने से पहले लाइन बाई लाइन उद्धृत किया जाता है। यहां खुलकर फीस संरचना दी गई है।</p>
      </div>

      <div class="pricing__right">
        <ul class="pricetable reveal reveal-delay-1">
          {pricingFees.map(f => (
            <li>
              <span class="pricetable__label">{f.label}</span>
              <span class="pricetable__value">{f.value}</span>
              <span class="pricetable__note">{f.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ Our Guarantees, in full —— 四个承诺各自展开（流程 / 标准 / 失败兜底） ═══ -->
  <section class="section--tight" id="guarantees">
    <div class="container">
      <div class="guar-head reveal">
        <p class="overline">हमारी गारंटी, पूर्ण रूप से</p>
        <h2>प्रत्येक वादा क्या है<br/><em>वास्तव में इसका क्या अर्थ है</em></h2>
        <p class="guar-lead">वादा होमपेज पर है। यहां इसके पीछे की मशीनरी है - कितने कदम, प्रत्येक को कितना समय लगता है, जो मानक हम रखते हैं, और जब यह गलत हो जाता है तो क्या होता है।</p>
      </div>

      <div class="gmods">
        {guaranteeModules.map((m, i) => (
          <article class:list={['gmod reveal', i % 2 === 1 && 'gmod--flip']}>
            <div class="gmod__media">
              <ImgPlaceholder class="gmod__img" src={m.img} seed={700 + i} width={640} height={800} ratio="4/5" alt={m.alt} />
              <span class="gmod__n">{m.n}</span>
            </div>

            <div class="gmod__body">
              <span class="gmod__icon"><Icon name={m.icon} size={24} color="var(--seal)" /></span>
              <h3>{m.title}</h3>
              <p class="gmod__promise">{m.promise}</p>

              <div class="gmod__cols">
                <div class="gmod__col">
                  <h4 class="gmod__label">यह कैसे काम करता है</h4>
                  <ol class="gmod__steps">
                    {m.steps.map((s, j) => (
                      <li>
                        <span class="gmod__step-n">{String(j + 1).padStart(2, '0')}</span>
                        <div>
                          <span class="gmod__step-t">{s.t}</span>
                          <span class="gmod__step-time">{s.time}</span>
                          <p>{s.d}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="gmod__col">
                  <h4 class="gmod__label">{m.checksLabel}</h4>
                  <ul class="gmod__checks">
                    {m.checks.map(c => (
                      <li>
                        <span class="gmod__check-k">{c.k}</span>
                        <span class="gmod__check-v">{c.v}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <p class="gmod__fail"><span class="gmod__fail-tag">अगर यह विफल होता है</span>{m.fail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="faq-head reveal">
        <p class="overline">FAQ</p>
        <h2>Common<br/><em>Questions</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class:list={['faq-item reveal', `reveal-delay-${i % 3}`]}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <span class="seal cta-seal" aria-hidden="true"><span>Start</span><span>Now</span></span>
      <p class="overline overline--light reveal">शुरू करें</p>
