---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';

/* ── 核心服务包（主推产品）：一条龙 ── */
const coreIncludes: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'आपूर्तिकर्ता सोर्सिंग',   body: '3-5 सत्यापित आपूर्तिकर्ता वास्तविक मूल्य के साथ — लाइसेंस, फैक्ट्री पता और निर्यात इतिहास की जाँच हमारे द्वारा उद्धृत करने से पहले।' },
  { n: '02', title: 'नमूना पुष्टि', body: 'हम आपके विनिर्देश और ग्राहक की अपेक्षाओं के अनुसार नमूना ऑर्डर और मूल्यांकन करते हैं, बल्क ऑर्डर करने से पहले।' },
  { n: '03', title: 'पूर्ण बैच निरीक्षण', body: 'फैक्ट्री में शिपमेंट-पूर्व गुणवत्ता नियंत्रण: उपस्थिति, आयाम, कार्य, पैकेजिंग और FBA लेबल जाँच।' },
  { n: '04', title: 'FBA तैयारी',            body: 'FNSKU लेबलिंग, पॉली-बैगिंग, बंडलिंग, वजन और माप Amazon के सटीक विनिर्देश के अनुसार।' },
  { n: '05', title: 'माल भाड़ा समन्वय', body: 'हवाई, समुद्री या एक्सप्रेस की तुलना; कस्टम कागजी कार्रवाई संभाली; लाइव ट्रैकिंग के साथ दर-से-दर DDP।' },
];

/* ── 附加服务：单独可选 ── */
const addOns: Array<{ icon: IconName; title: string; problem: string; process: string; pricing: string; seed: number }> = [
  { icon: 'package', title: 'प्राइवेट लेबल और पैकेजिंग डिज़ाइन', seed: 71,
    problem: 'आपके उत्पाद को एक ब्रांड की तरह दिखना चाहिए, न कि सामान्य आयात की तरह — और खराब पैकेजिंग रूपांतरण को मारती है।',
    process: 'लोगो प्लेसमेंट, बॉक्स/बैग/लेबल कलाकृति, इन्सर्ट कार्ड और पैकेजिंग फैक्ट्री के साथ MOQ वार्ता।',
    pricing: 'एक सपाट डिज़ाइन फीस प्लस फैक्ट्री लागत पर पैकेजिंग। MOQ आमतौर पर 300-1,000 टुकड़े।' },
  { icon: 'transparent', title: 'उत्पाद फोटोग्राफी', seed: 72,
    problem: 'Amazon उन लिस्टिंग को दबा देता है — या ब्लॉक कर देता है — जिनकी मुख्य छवि सफेद पृष्ठभूमि मानक को पूरा नहीं करती।',
    process: 'Amazon मुख्य छवि विनिर्देश के लिए सफेद पृष्ठभूमि शॉट्स, साथ ही अनुरोध पर जीवन शैली और इन्फोग्राफिक वेरिएंट।',
    pricing: 'प्रति छवि दर, मात्रा पर सस्ता। प्रति SKU सपाट दर उपलब्ध।' },
  { icon: 'sourcing', title: '1688 खरीद सेवा', seed: 73,
    problem: '1688 पर सबसे कम कीमतें उपलब्ध हैं — लेकिन साइट केवल चीनी में है और विदेशों में शिप नहीं करती।',
    process: 'एक उत्पाद लिंक या फोटो भेजें। हम 1688 विक्रेता से खरीदते हैं, निरीक्षण करते हैं, समेकित करते हैं और आपको भेजते हैं।',
    pricing: 'ऑर्डर मूल्य का एक प्रतिशत जिसमें एक छोटी न्यूनतम राशि होती है। चीनी की आवश्यकता नहीं है।' },
  { icon: 'shipping', title: 'वेयरहाउसिंग और ट्रांसशिपमेंट', seed: 74,
    problem: 'कई आपूर्तिकर्ताओं से खरीदारी का मतलब है कई अंतरराष्ट्रीय माल भाड़े के बिल — और कोई भी माल की जांच नहीं कर रहा है।',
    process: 'हम कई ऑर्डर प्राप्त करते हैं, उनका निरीक्षण करते हैं, फिर से पैक करते हैं और अपने गोदाम से एक ही शिपमेंट में समेकित करते हैं।',
    pricing: 'प्रति घन मीटर प्रति दिन भंडारण, साथ ही प्रति ऑर्डर एक समेकन शुल्क।' },
];

const svcImg: Record<number,string> = {71:'blog-packaging',72:'blog-products',73:'sourcing-1688',74:'shipping'};
const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'दिन 1',    title: 'आप अपना उत्पाद जमा करें',    body: 'हमारे पूछताछ फॉर्म के माध्यम से उत्पाद विवरण, मात्रा, गुणवत्ता मानक और बजट।' },
  { day: 'दिन 2',    title: 'हम आपूर्तिकर्ता विकल्प भेजते हैं',   body: '3-5 सत्यापित आपूर्तिकर्ता उद्धरण और प्रोफाइल के साथ, आपकी समीक्षा के लिए तैयार।' },
  { day: 'दिन 3-5',  title: 'नमूना और समझौता',       body: 'हम नमूना की पुष्टि करते हैं, चीनी में शर्तें सहमत करते हैं, PO जारी करते हैं और जमा राशि सुरक्षित रूप से जारी करते हैं।' },
  { day: 'दिन 7-20', title: 'उत्पादन और निरीक्षण',    body: 'माल तैयार किया जाता है। हम पूरे बैच का निरीक्षण करते हैं और शिपमेंट से पहले एक QC फोटो रिपोर्ट भेजते हैं।' },
  { day: 'दिन 21+',  title: 'FBA-तैयार, वितरित',       body: 'माल चीन से एमेज़ॉन स्पेस के अनुसार लेबल और पैक किया जाता है, कस्टम क्लीयर किया जाता है, और लाइव ट्रैकिंग के साथ भेजा जाता है।' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'एजेंट शुल्क',  value: 'ऑर्डर मूल्य का 5–8%', note: '$10,000 के ऑर्डर पर $600 एजेंट शुल्क' },
  { label: 'निरीक्षण', value: '$150 / दिन',          note: 'अधिकांश ऑर्डर आधे दिन में पूरे हो जाते हैं' },
  { label: 'FBA प्रीप',   value: 'प्रति यूनिट',            note: 'आपके कोटेशन में आइटम दर आइटम विवरण दिया जाएगा' },
  { label: 'माल भाड़ा',    value: 'वाहक द्वारा कोटेशन के अनुसार',    note: 'वाहक की कीमत के ऊपर कोई अतिरिक्त शुल्क नहीं' },
];

const faqs = [
  { q: 'FBA सोर्सिंग और निरीक्षण पैकेज में क्या शामिल है?', a: 'आपूर्तिकर्ता सोर्सिंग, नमूना पुष्टि, पूरे बैच का निरीक्षण, FBA प्रीप (लेबलिंग, बैगिंग, वजन और माप), और माल भाड़ा समन्वय – एक जवाबदेह एजेंट, एक कोटेशन।' },
  { q: 'आपकी सेवा शुल्क कितनी है?',                            a: 'एजेंट शुल्क ऑर्डर मूल्य का 5–8% है। निरीक्षण $150/दिन है (अधिकांश ऑर्डर आधे दिन में पूरे हो जाते हैं)। FBA प्रीप प्रति यूनिट लिया जाता है। आपके प्रतिबद्ध होने से पहले सब कुछ आपके कोटेशन में विस्तृत किया जाएगा।' },
  { q: 'आपका न्यूनतम ऑर्डर आकार क्या है?',                         a: 'कोई सख्त न्यूनतम नहीं है, लेकिन $300 USD या अधिक के ऑर्डर के साथ हम सबसे अच्छा काम करते हैं। छोटे ऑर्डर में आपूर्तिकर्ता विकल्प कम हो सकते हैं।' },
  { q: 'अगर माल निरीक्षण में फेल हो जाए तो क्या होगा?',                           a: 'हम आपूर्तिकर्ता के साथ समाधान के लिए काम करते हैं — पुनः कार्य, प्रतिस्थापन, या धनवापसी — कुछ भी शिप होने से पहले। हम आपकी मंजूरी के बिना अंतिम भुगतान कभी नहीं जारी करते।' },
  { q: 'क्या आप FBA प्रीप और लेबलिंग संभालते हैं?',                    a: 'हाँ। FNSKU लेबल, पॉली-बैगिंग, बंडलिंग, कार्टन लेबल, वज़न और माप Amazon के स्पेक के अनुसार — ताकि आपका शिपमेंट पहली बार में ही प्राप्ति पास कर ले।' },
  { q: 'क्या मैं अपने लोगो के साथ कस्टम पैकेजिंग प्राप्त कर सकता हूँ?',                 a: 'हाँ — यह हमारा प्राइवेट लेबल और पैकेजिंग ऐड-ऑन है। बॉक्स, बैग, लेबल और हैंग टैग। MOQ आपूर्तिकर्ता के अनुसार अलग-अलग होता है, आमतौर पर 300–1,000 टुकड़े।' },
];

/* ── Our Guarantees, in full ──
   首页只给「承诺」（结果）；这里把四个承诺各自展开：流程（几步/每步多久）+ 具体标准（清单）+ 失败兜底。
   图片刻意不用首页那四张（factory/inspection/payment/shipping），四张统一 1024×1280、统一 ratio="4/5"。 */
type GuaranteeModule = {
  icon: IconName; n: string; title: string; promise: string;
  img: string; alt: string;
  steps: Array<{ t: string; time: string; d: string }>;
  checksLabel: string;
  checks: Array<{ k: string; v: string }>;
  fail: string;
};
const guaranteeModules: GuaranteeModule[] = [
  {
    icon: 'trust', n: '01', title: 'केवल सत्यापित आपूर्तिकर्ता',
    promise: 'हम आपके एक पैसा भुगतान करने से पहले हर आपूर्तिकर्ता की जांच करते हैं।',
    img: '/img/g-market.webp', alt: 'थोक बाजार में जाकर आपूर्तिकर्ताओं की व्यक्तिगत रूप से जांच करना',
    steps: [
      { t: 'शॉर्टलिस्ट', time: 'दिन 1–2', d: 'हम आपके उत्पाद स्पेक से मेल खाते हुए, अपने स्वयं के फैक्ट्री नेटवर्क और 1688 से 3–5 उम्मीदवारों को चुनते हैं।' },
      { t: 'पेपर चेक', time: 'दिन 2–3', d: 'व्यवसाय लाइसेंस, पंजीकृत पता, उत्पादन क्षमता और निर्यात इतिहास — फैक्ट्री के खिलाफ चेक किया गया, न कि किसी बिक्री पृष्ठ के खिलाफ।' },
      { t: 'लाइव वॉकथ्रू', time: 'दिन 3–5', d: 'वर्कशॉप के माध्यम से वीडियो कॉल: वास्तविक लाइन, वास्तविक स्टॉक, वास्तविक नमूना।' },
    ],
    checksLabel: 'हम क्या सत्यापित करते हैं',
    checks: [
      { k: 'लाइसेंस और कानूनी इकाई', v: 'व्यवसाय लाइसेंस उस नाम से मेल खाता है जो आपके इनवॉइस पर दिखाई देगा।' },
      { k: 'पता बनाम कार्यशाला', v: 'पंजीकृत पते की जाँच उस स्थान के विरुद्ध की जाती है जहाँ वास्तव में सामान बनाया जाता है।' },
      { k: 'क्षमता और समय सीमा', v: 'क्या वे आपकी मात्रा, आपकी समय सीमा और आपके पुनःआर्डर को संभाल सकते हैं।' },
      { k: 'निर्यात इतिहास', v: 'पिछली शिपमेंट और मौजूदा ग्राहक — जिन्हें वे पहले से विदेशों में बेचते हैं।' },
      { k: 'लाइव उत्पादन लाइन', v: 'आपके खाते से एक भी डॉलर निकलने से पहले वीडियो पर देखा गया।' },
    ],
    fail: 'यदि कोई फैक्ट्री कागजी जाँच पास नहीं कर सकती या लाइव वॉकथ्रू से इनकार करती है, तो वह आपके उद्धरण तक कभी नहीं पहुँचती। हम खोजते रहते हैं।',
  },
  {
    icon: 'inspection', n: '02', title: 'शिपिंग से पहले QC',
    promise: 'फोटो रिपोर्ट + पास/फेल आपके पैसे हिलने से पहले।',
    img: '/img/g-production.webp', alt: 'शिपमेंट से पहले उत्पादन फ्लोर पर सामानों की जाँच करता निरीक्षक',
    steps: [
      { t: 'निरीक्षण बुक करें', time: 'बैच बंद होने से एक दिन पहले', d: 'उत्पादन समाप्ति तिथि के विरुद्ध निर्धारित — शिप तिथि नहीं, ताकि चीज़ें सुधारने के लिए समय मिले।' },
      { t: 'साइट पर पूरी बैच जाँच', time: 'आधा दिन, सामान्य', d: 'हम फैक्ट्री पर खड़े होते हैं, बैच को स्वयं गिनते, मापते, टेस्ट करते और फोटो खींचते हैं।' },
      { t: 'रिपोर्ट और फैसला', time: 'उसी दिन', d: 'आपको एक स्पष्ट पास/फेल, दोष गणना, और उपयोग किए गए सैंपलिंग मानक के साथ फोटो रिपोर्ट प्राप्त होती है।' },
      { t: 'दोबारा काम या बदलें', time: '३-७ दिन', d: 'एक फेल सीधे आपूर्तिकर्ता को दोबारा काम या प्रतिस्थापन के लिए वापस भेजा जाता है — फिर पैकिंग से पहले हम दोबारा निरीक्षण करते हैं।' },
