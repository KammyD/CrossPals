---
interface Props {
  overline?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { overline, title, subtitle, align = 'center' } = Astro.props;
---
<section class:list={['phero grain', { 'phero--left': align === 'left' }]} style="position:relative;">
  <div class="container phero__inner">
    <span class="phero__rule" aria-hidden="true"></span>
    {overline && <p class="overline overline--light">{overline}</p>}
    <h1 set:html={title} />
    {subtitle && <p class="phero__sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    background: var(--avo-950);
    padding: calc(72px + 72px) 0 var(--s9);
    color: #fff; overflow: hidden; position: relative;
  }
  .phero__inner { position:relative; z-index:1; text-align:center; max-width:880px; margin:0 auto; }
  .phero--left .phero__inner { text-align:left; margin-left:0; }
  .phero__rule { display:block; width:48px; height:2px; background:var(--seal); margin:0 auto var(--s5); }
  .phero--left .phero__rule { margin-left:0; }
  .phero h1 { color:#fff; max-width:820px; margin:var(--s3) auto var(--s5); font-weight:560; }
  .phero--left h1 { margin-left:0; }
  .phero__sub { font-size:18px; color:rgba(255,255,255,.60); max-width:560px; margin:0 auto; line-height:1.65; }
  .phero--left .phero__sub { margin-left:0; }
  .phero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:1px; background:rgba(255,255,255,.1); }
</style>
