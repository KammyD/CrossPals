---
import Logo from './Logo.astro';
import { getLangFromUrl, useTranslations, localePath, languageList, isMultilingual, defaultLang, basePathOf, navPath, baseSlug } from '../i18n/utils';
import { getCollection } from 'astro:content';

const lang    = getLangFromUrl(Astro.url);
const t       = useTranslations(lang);
const path    = Astro.url.pathname;

const nav = [
  { key: 'nav_home',     href: '/'         },
  { key: 'nav_services', href: '/services'  },
  { key: 'nav_about',    href: '/about'     },
  { key: 'nav_blog',     href: '/blog'      },
  { key: 'nav_cases',    href: '/case-studies' },
  { key: 'nav_contact',  href: '/contact'   },
] as const;

function active(href: string) {
  const full = navHref(href);
  if (href === '/') return path === full || path === full + '/';
  return path === full || path.startsWith(full + '/');
}

/* 导航落点：见 i18n/utils.ts → navPath（有语言版才加前缀，否则回落默认语言页） */
const navHref = (href: string) => navPath(lang, href);

/* ── 语言切换器（语言清单 = site.config.json → site.locales，CMS 后台维护）──
   链接策略：能落到「同一页的对应语言版」就落（博客详情有译文、列表有该语言文章），
   没有对应版本的页面落该语言首页——绝不给 404 链接。 */
const showLang = isMultilingual && languageList.length >= 2;
const langTargets: Record<string, string> = {};

if (showLang) {
  const base = basePathOf(path);
  const m = base.match(/^\/blog\/([^/]+)\/?$/);          // 博客详情
  const isList = /^\/blog\/?$/.test(base);               // 博客列表

  if (m || isList) {
    const posts = await getCollection('blog');
    // 当前页语言下的那篇（基准 slug 相同 + 语言匹配）；不是「默认语言那篇」
    const current = m
      ? posts.find(p => baseSlug(p.slug, lang) === m[1] && (p.data.lang || defaultLang) === lang)
      : null;
    const curBase = current ? baseSlug(current.slug, lang) : '';

    for (const l of languageList) {
      if (l.code === lang) { langTargets[l.code] = path; continue; }
      if (l.isDefault)     { langTargets[l.code] = base; continue; }

      if (current) {
        // 同一篇的译文：translationKey 相同，或基准 slug 相同（两边都剥掉 -<语言码> 后缀再比）
        const alt = posts.find(p => p.data.lang === l.code && (
          (p.data.translationKey && p.data.translationKey === current.data.translationKey) ||
          baseSlug(p.slug, l.code) === curBase
        ));
        if (alt) {
          const altSlug = alt.data.translationKey || baseSlug(alt.slug, l.code);
          langTargets[l.code] = localePath(l.code, `/blog/${altSlug}/`);
          continue;
        }
      }
      if (isList && posts.some(p => p.data.lang === l.code)) {
        langTargets[l.code] = localePath(l.code, '/blog/');
        continue;
      }
      langTargets[l.code] = localePath(l.code, '/');
    }
  } else {
    for (const l of languageList) {
      langTargets[l.code] = l.isDefault ? base : localePath(l.code, '/');
    }
  }
}
---

<header class="hdr" id="hdr">
  <div class="hdr__bar container">

    <!-- Logo — left end sits on the light wash, so use the dark original -->
    <Logo layout="horizontal" size="md" />

    <!-- Primary nav -->
    <nav class="hdr__nav" aria-label={t('a11y_primary')}>
      {nav.map(item => (
        <a
          href={navHref(item.href)}
          class:list={['hdr__link', { 'hdr__link--on': active(item.href) }]}
        >
          {t(item.key)}
        </a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="hdr__end">

      {showLang && (
      <!-- Language dropdown（语言清单来自 site.config.json，CMS 后台维护） -->
      <div class="lang" id="langWrap">
        <button class="lang__btn" id="langTrigger" aria-haspopup="listbox" aria-expanded="false">
          <!-- Globe SVG -->
          <svg class="lang__globe" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="10" cy="10" r="8.5"/>
            <path d="M10 1.5C10 1.5 6.5 5 6.5 10s3.5 8.5 3.5 8.5"/>
            <path d="M10 1.5C10 1.5 13.5 5 13.5 10s-3.5 8.5-3.5 8.5"/>
            <path d="M1.5 10h17"/>
            <path d="M2.5 6.5h15M2.5 13.5h15"/>
          </svg>
          <span class="lang__code">{lang.toUpperCase()}</span>
          <!-- Chevron SVG -->
          <svg class="lang__chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6l4 4 4-4"/>
          </svg>
        </button>

        <div class="lang__dropdown" id="langDropdown" role="listbox" aria-label={t('a11y_selectLanguage')}>
          <div class="lang__dropdown-title">Language</div>
          {languageList.map(l => (
            <a
              href={langTargets[l.code] ?? localePath(l.code, '/')}
              class:list={['lang__option', { 'lang__option--on': l.code === lang }]}
              role="option"
              aria-selected={l.code === lang}
            >
              <span class="lang__flag" aria-hidden="true">{l.flag}</span>
              <span class="lang__info">
                <span class="lang__name">{l.label}</span>
                <span class="lang__native">{l.native}</span>
              </span>
              {l.code === lang && (
                <svg class="lang__check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="3 8 6.5 11.5 13 5"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
      )}

      <!-- CTA -->
      <a href={navHref('/contact')} class="hdr__cta">
        {t('nav_cta')}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M3 8h10M8 3l5 5-5 5"/>
        </svg>
      </a>
    </div>

    <!-- Mobile burger -->
    <button class="hdr__burger" id="burgerBtn" aria-label={t('a11y_openMenu')} aria-expanded="false">
      <span class="hdr__burger-line"></span>
      <span class="hdr__burger-line"></span>
      <span class="hdr__burger-line"></span>
    </button>
  </div>
</header>

<!-- Mobile fullscreen drawer (outside header for z-index) -->
<div class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer__inner">
    <nav class="drawer__nav">
      {nav.map((item, i) => (
        <a
          href={navHref(item.href)}
          class:list={['drawer__link', { 'drawer__link--on': active(item.href) }]}
          style={`--i:${i}`}
        >
          <span class="drawer__idx">0{i + 1}</span>
          <span class="drawer__label">{t(item.key)}</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 8h10M8 3l5 5-5 5"/>
          </svg>
        </a>
      ))}
    </nav>

    <div class="drawer__foot">
      {showLang && languageList.length > 1 && (
      <div class="drawer__langs">
        {languageList.map(l => (
          <a
            href={langTargets[l.code] ?? localePath(l.code, '/')}
            class:list={['drawer__lang', { 'drawer__lang--on': l.code === lang }]}
            aria-current={l.code === lang ? 'true' : undefined}
          >
            <span class="lang__flag">{l.flag}</span>
            <span>{l.native}</span>
          </a>
        ))}
      </div>
      )}
      <a href={navHref('/contact')} class="hdr__cta drawer__cta">
        {t('nav_cta')}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M3 8h10M8 3l5 5-5 5"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  const hdr     = document.getElementById('hdr')!;
  const burger  = document.getElementById('burgerBtn')!;
  const drawer  = document.getElementById('drawer')!;
  const trigger = document.getElementById('langTrigger');
  const dropdown= document.getElementById('langDropdown');
  let menuOpen  = false;
  let langOpen  = false;

  // ── 滚动状态：下滚收起 / 上滚滑出 ──
  const TOP_ZONE  = 140;   // 这个位置以内始终显示
  const HIDE_AFTER = 24;   // 下滚累计超过这个位移才收起
  const SHOW_AFTER = 10;   // 上滚累计超过这个位移就滑出
  let lastY = window.scrollY;
  let acc   = 0;           // 同方向累计位移，滤掉橡皮筋式抖动

  const onScroll = () => {
    const y  = Math.max(0, window.scrollY);
    const dy = y - lastY;
    lastY = y;

    hdr.classList.toggle('hdr--solid', y > 24);

    // 菜单/语言面板开着、或者回到顶部附近：始终显示
    if (menuOpen || langOpen || y <= TOP_ZONE) {
      hdr.classList.remove('hdr--hide');
      acc = 0;
      return;
    }

    if (dy > 0) {
      acc = Math.max(0, acc) + dy;
      if (acc > HIDE_AFTER) hdr.classList.add('hdr--hide');
    } else if (dy < 0) {
      acc = Math.min(0, acc) + dy;
      if (acc < -SHOW_AFTER) hdr.classList.remove('hdr--hide');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Mobile drawer ──
  const setMenu = (v: boolean) => {
    menuOpen = v;
    burger.setAttribute('aria-expanded', String(v));
    burger.classList.toggle('hdr__burger--open', v);
    drawer.classList.toggle('drawer--open', v);
    drawer.setAttribute('aria-hidden', String(!v));
    document.body.style.overflow = v ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setMenu(!menuOpen));
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));

  // ── Language dropdown（多语言站才有这组元素）──
  const setLang = (v: boolean) => {
    langOpen = v;
    if (!trigger || !dropdown) return;
    trigger.setAttribute('aria-expanded', String(v));
    dropdown.classList.toggle('lang__dropdown--open', v);
    trigger.classList.toggle('lang__btn--open', v);
  };
  if (trigger && dropdown) {
    trigger.addEventListener('click', (e) => { e.stopPropagation(); setLang(!langOpen); });
    document.addEventListener('click', () => { if (langOpen) setLang(false); });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { setLang(false); setMenu(false); }
  });
</script>

<style>
/* ═══════════════════════════════════════════
   HEADER BASE — transparent, gradient mask
═══════════════════════════════════════════ */
.hdr {
  position: fixed; inset: 0 0 auto; z-index: 1000;

  /* 左白 → 右墨绿（avo-950，页面主色）：一条连续的坡，没有"实心白平台"的硬拐点。
     下面先给一条"两停靠点"的兜底声明（老浏览器 / clamp·calc 不受支持时生效），
     再给带缓动的多停靠点版本——后一条若被判定无效会被整体丢弃，兜底仍在。
     系数来自 f(t) = 1 - smoothstep(t)^0.6（白层，t 从 --hdr-wp 起算）与 smoothstep(u)（墨绿层）：
     起步与收尾斜率都是 0，任何位置都看不出"从这里开始变"的那条线。 */
  background:
    linear-gradient(90deg,
      rgba(255, 255, 255, var(--hdr-w-a)) 0,
      rgba(255, 255, 255, 0) calc(var(--hdr-wp) + var(--hdr-wf))),
    linear-gradient(90deg,
      rgba(28, 33, 20, 0) 0,
      rgba(28, 33, 20, var(--hdr-k-a)) var(--hdr-kz),
      rgba(28, 33, 20, var(--hdr-k-a)) 100%);

  /* 缓动版：11 个停靠点铺出连续曲率，整条栏是一个坡而不是三段拼接 */
  background:
    linear-gradient(90deg,
      rgba(255, 255, 255, var(--hdr-w-a)) 0,
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .883)) calc(var(--hdr-wp) + var(--hdr-wf) * .1),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .743)) calc(var(--hdr-wp) + var(--hdr-wf) * .2),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .601)) calc(var(--hdr-wp) + var(--hdr-wf) * .3),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .466)) calc(var(--hdr-wp) + var(--hdr-wf) * .4),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .340)) calc(var(--hdr-wp) + var(--hdr-wf) * .5),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .229)) calc(var(--hdr-wp) + var(--hdr-wf) * .6),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .136)) calc(var(--hdr-wp) + var(--hdr-wf) * .7),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .064)) calc(var(--hdr-wp) + var(--hdr-wf) * .8),
      rgba(255, 255, 255, calc(var(--hdr-w-a) * .017)) calc(var(--hdr-wp) + var(--hdr-wf) * .9),
      rgba(255, 255, 255, 0) calc(var(--hdr-wp) + var(--hdr-wf))),
    linear-gradient(90deg,
      rgba(28, 33, 20, 0) 0,
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .043)) calc(var(--hdr-kz) * .125),
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .156)) calc(var(--hdr-kz) * .25),
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .316)) calc(var(--hdr-kz) * .375),
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .5))   calc(var(--hdr-kz) * .5),
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .684)) calc(var(--hdr-kz) * .625),
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .844)) calc(var(--hdr-kz) * .75),
      rgba(28, 33, 20, calc(var(--hdr-k-a) * .957)) calc(var(--hdr-kz) * .875),
      rgba(28, 33, 20, var(--hdr-k-a)) var(--hdr-kz),
      rgba(28, 33, 20, var(--hdr-k-a)) 100%);

  border-bottom: 1px solid var(--hdr-line);
  transition: box-shadow .35s ease, border-color .35s ease,
              transform .46s cubic-bezier(.16, 1, .3, 1);
  will-change: transform;
}

/* 滚动后：两层都加重 + 毛玻璃 + 投影，把顶栏和内容分开
   （不用 1.0：留一点透，让底下的内容始终能透出来一丝，栏子才不像一块贴纸） */
.hdr--solid {
  --hdr-w-a: .84;
  --hdr-k-a: .86;
  backdrop-filter: blur(18px) saturate(1.35);
  -webkit-backdrop-filter: blur(18px) saturate(1.35);
  box-shadow: 0 12px 34px rgba(0, 0, 0, .24);
}

/* 下滚隐藏 / 上滚滑出（transform，不占文档流，页面补偿靠 --hdr-h） */
.hdr--hide { transform: translateY(-100%); }

.hdr__bar {
  height: var(--hdr-h);
  display: flex;
  align-items: center;
  gap: 0;
}

/* ═══════════════════════════════════════════
   NAV LINKS — bold, larger, pulled away from CTA
═══════════════════════════════════════════ */
.hdr__nav {
  display: flex;
  align-items: center;
  gap: 42px;                 /* 导航间距 40–46px */
  margin-left: auto;
  margin-right: var(--s7);
}

.hdr__link {
  position: relative;
  display: inline-flex; align-items: center;
  padding: 6px 0;
  border-radius: 0;

  font-family: var(--font-sans);
  font-size: 15.5px;
  font-weight: 500;
  letter-spacing: 0.01em;
  color: var(--hdr-fg);
  text-decoration: none;
  transition: color .18s;
}

.hdr__link:hover  { color: #fff; }

.hdr__link--on   { color: var(--hdr-fg); font-weight: 600; }

/* Active：文字下方 26px 砖红细线（替掉原来的小红点） */
.hdr__link--on::after {
  content: '';
  position: absolute;
  bottom: -7px; left: 50%;
  transform: translateX(-50%);
  width: 26px; height: 2px;
  background: var(--seal);
}

/* ═══════════════════════════════════════════
   RIGHT SECTION
═══════════════════════════════════════════ */
.hdr__end {
  display: flex; align-items: center; gap: var(--s3);
  flex-shrink: 0;
}

/* ═══════════════════════════════════════════
   LANGUAGE DROPDOWN
═══════════════════════════════════════════ */
.lang { position: relative; }

.lang__btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 10px;
  /* 深色体系下不再做独立灰盒子：默认透明，hover 才浮出 */
  background: transparent;
  border: 1px solid transparent;
  border-radius: 0;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 13px; font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--hdr-fg);
  transition: background .18s, border-color .18s, color .18s;
  white-space: nowrap;
}

.lang__btn:hover,
.lang__btn--open {
  background: var(--hdr-hover);
  border-color: var(--hdr-line-2);
  color: #fff;
}

.lang__globe { width: 14px; height: 14px; flex-shrink: 0; opacity: .5; }
.lang__code  { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; }

.lang__chevron {
  width: 11px; height: 11px; flex-shrink: 0; opacity: .45;
  transition: transform .22s var(--ease-out);
}
.lang__btn--open .lang__chevron { transform: rotate(180deg); }

/* Dropdown panel */
.lang__dropdown {
  position: absolute;
  top: calc(100% + 10px); right: 0;
  width: 210px;
  background: #20271b;
  border: 1px solid var(--hdr-line-2);
  border-radius: 0;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0,0,0,.45), 0 4px 16px rgba(0,0,0,.28);

  /* Hidden state */
  opacity: 0;
  transform: translateY(-6px) scale(0.97);
  pointer-events: none;
  transition: opacity .2s var(--ease-out), transform .2s var(--ease-out);
  transform-origin: top right;
}

.lang__dropdown--open {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

.lang__dropdown-title {
  padding: 10px 14px 8px;
  font-family: var(--font-mono);
  font-size: 10px; font-weight: 500;
  letter-spacing: .12em; text-transform: uppercase;
  color: rgba(232,229,218,.45);
  border-bottom: 1px solid var(--hdr-line);
}

.lang__option {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px;
  text-decoration: none;
  transition: background .14s;
  cursor: pointer;
}
.lang__option:hover      { background: var(--hdr-hover); }
.lang__option--on        { background: rgba(255,255,255,.08); }
.lang__option:last-child { border-radius: 0; }

.lang__flag { font-size: 18px; line-height: 1; flex-shrink: 0; }
.lang__info { display: flex; flex-direction: column; flex: 1; }
.lang__name { font-size: 14px; font-weight: 500; color: var(--hdr-fg); }
.lang__native { font-size: 11px; color: rgba(232,229,218,.5); margin-top: 1px; }

.lang__check {
  width: 14px; height: 14px;
  stroke: var(--seal); flex-shrink: 0;
}

/* ═══════════════════════════════════════════
   CTA BUTTON
═══════════════════════════════════════════ */
.hdr__cta {
  display: inline-flex; align-items: center; gap: 8px;
  height: 48px;                 /* CTA 高度 48–50px */
  padding: 0 26px;              /* 左右 padding 24–28px */
  background: var(--seal);
  color: #fff;
  border-radius: 0;
  font-family: var(--font-sans);
  font-size: 14.5px; font-weight: 600;
  letter-spacing: .02em;
  text-decoration: none; border: none; cursor: pointer;
  transition: background .18s, transform .18s;
  white-space: nowrap;
}

.hdr__cta svg { width: 13px; height: 13px; flex-shrink: 0; transition: transform .18s; }
.hdr__cta:hover svg { transform: translateX(3px); }

.hdr__cta:hover {
  background: var(--seal-deep);
  transform: translateY(-1px);
}
.hdr__cta:active { transform: none; }

/* ═══════════════════════════════════════════
   MOBILE BURGER
═══════════════════════════════════════════ */
.hdr__burger {
  display: none; flex-direction: column; justify-content: center; gap: 5px;
  background: transparent;
  border: 1px solid var(--hdr-line-2);
  border-radius: 0;
  cursor: pointer; padding: 9px 10px; margin-left: auto;
  width: 42px; height: 42px;
  transition: background .18s, border-color .18s;
}
.hdr__burger:hover { background: var(--hdr-hover); border-color: rgba(255,255,255,.25); }

.hdr__burger-line {
  display: block; width: 20px; height: 1.5px;
  background: var(--hdr-fg); border-radius: 2px;
  transition: transform .28s var(--ease-out), opacity .2s;
  transform-origin: center;
}
.hdr__burger--open .hdr__burger-line:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.hdr__burger--open .hdr__burger-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
.hdr__burger--open .hdr__burger-line:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* ═══════════════════════════════════════════
   MOBILE DRAWER
═══════════════════════════════════════════ */
.drawer {
  display: none;
  position: fixed; inset: 0; z-index: 999;
  background: var(--hdr-bg);
  padding-top: var(--hdr-h);
  overflow-y: auto;
}

.drawer--open {
  display: flex; flex-direction: column;
  animation: drawerIn .3s var(--ease-out);
}

@keyframes drawerIn {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: none; }
}

.drawer__inner {
  display: flex; flex-direction: column; flex: 1;
  padding: var(--s4) var(--s5) var(--s7);
}

.drawer__nav {
  border-top: 1px solid var(--hdr-line);
  display: flex; flex-direction: column;
}

.drawer__link {
  display: flex; align-items: center; gap: var(--s4);
  padding: 18px var(--s3);
  border-bottom: 1px solid rgba(255,255,255,.07);
  font-family: var(--font-serif);
  font-size: 26px; font-weight: 600;
  color: var(--hdr-fg);
  text-decoration: none;
  transition: color .18s, padding-left .22s;
  animation: linkIn .4s var(--ease-out) both;
  animation-delay: calc(var(--i) * 0.06s);
}

@keyframes linkIn {
  from { opacity: 0; transform: translateX(-14px); }
  to   { opacity: 1; transform: none; }
}

.drawer__link:hover  { color: #fff; padding-left: var(--s5); }
.drawer__link--on    { color: var(--seal); }
.drawer__link svg    { width: 18px; height: 18px; margin-left: auto; opacity: .3; flex-shrink: 0; transition: opacity .18s, transform .18s; }
.drawer__link:hover svg { opacity: .7; transform: translateX(4px); }

.drawer__idx {
  font-family: var(--font-mono); font-size: 11px;
  color: rgba(232,229,218,.35); letter-spacing: .08em;
  width: 24px; flex-shrink: 0;
}

.drawer__label { flex: 1; }

.drawer__foot {
  margin-top: auto; padding-top: var(--s7);
  display: flex; flex-direction: column; gap: var(--s3);
}

.drawer__cta { width: 100%; justify-content: center; padding: 15px; font-size: 16px; border-radius: 0; }

/* 抽屉里的语言行（移动端没有顶部下拉，语言切换落在这里） */
.drawer__langs {
  display: flex; gap: var(--s2);
  margin-bottom: var(--s3);
}

.drawer__lang {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 16px;
  border: 1px solid var(--hdr-line-2);
  border-radius: 0;
  font-family: var(--font-sans);
  font-size: 14px;
  color: var(--hdr-fg);
  text-decoration: none;
  transition: background .18s, border-color .18s;
}
.drawer__lang:hover,
.drawer__lang--on { background: var(--hdr-hover); border-color: rgba(255,255,255,.3); }
.drawer__lang .lang__flag { font-size: 15px; }

/* ═══════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════ */
/* Tablet: 收紧导航间距，保证 6 项 + CTA 仍能一行放下 */
@media (max-width: 1120px) and (min-width: 901px) {
  .hdr__nav   { gap: 26px; margin-right: var(--s5); }
  .hdr__link  { font-size: 15px; }
  .hdr__cta   { font-size: 14px; height: 46px; padding: 0 20px; }
}

@media (max-width: 900px) {
  .hdr__nav, .hdr__end { display: none; }
  .hdr__burger { display: flex; }
  /* 移动端只留 logo + 汉堡：白区盖住 logo 后顺着坡淡出去 */
  .hdr { --hdr-wp: clamp(130px, 34%, 300px); --hdr-wf: clamp(160px, 42%, 420px); --hdr-kz: 190px; }
  .hdr__bar :global(.logo img) { height: 36px; }
}
</style>
