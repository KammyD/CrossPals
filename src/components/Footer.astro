---
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import { getLangFromUrl, useTranslations, navPath } from '../i18n/utils';
import { PHONE, EMAIL, COMPANY, SOCIAL, CONTACT } from '../config/site';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const serviceKeys = ['footer_service_sourcing','footer_service_inspection','footer_service_payment','footer_service_logistics'];

const company = [
  { labelKey: 'nav_about', href: '/about' },
  { labelKey: 'nav_cases', href: '/case-studies' },
  { labelKey: 'nav_blog', href: '/blog' },
  { labelKey: 'nav_contact', href: '/contact' },
];
---

<footer class="footer grain" style="position:relative;">
  <div class="footer__top container">
    <div class="footer__brand">
      <Logo layout="stacked" size="md" />
      <p>{t('footer_tagline')}</p>
      <div class="footer__social">
        <a href={PHONE.wa} aria-label="WhatsApp" class="soc" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        {SOCIAL.map((s) => (
          <a href={s.href} aria-label={s.label} class="soc" target="_blank" rel="noopener">
            <SocialIcon platform={s.key} />
          </a>
        ))}
      </div>
      <p class="footer__entity">{COMPANY.nameEn} · {COMPANY.address.en}</p>
    </div>

    <div class="footer__col">
      <h5>{t('footer_services')}</h5>
      <ul>
        {serviceKeys.map(k => <li><a href={navPath(lang,'/services')}>{t(k)}</a></li>)}
      </ul>
    </div>
    <div class="footer__col">
      <h5>{t('footer_company')}</h5>
      <ul>
        {company.map(c => <li><a href={navPath(lang,c.href)}>{t(c.labelKey)}</a></li>)}
      </ul>
    </div>
    <div class="footer__col">
      <h5>{t('footer_legal')}</h5>
      <ul>
        <li><a href={navPath(lang,'/privacy')}>{t('footer_privacy')}</a></li>
        <li><a href={navPath(lang,'/terms')}>{t('footer_terms')}</a></li>
      </ul>
      <div class="footer__contact">
        <a href={`tel:${PHONE.tel}`}>{PHONE.display}</a>
        <a href={`mailto:${EMAIL.en}`}>{EMAIL.en}</a>
        {CONTACT.wechat && <span class="footer__extra">微信：{CONTACT.wechat}</span>}
        {CONTACT.telegram && <a href={CONTACT.telegram} class="footer__extra" target="_blank" rel="noopener">Telegram</a>}
        {CONTACT.hours && <span class="footer__extra">{CONTACT.hours}</span>}
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bar">
    <div class="container footer__bar-inner">
      <p>© {new Date().getFullYear()} CrossPals — {t('footer_rights')}</p>
      <p class="footer__made">A CrossPals Trade Ledger · Est. MMXXVI</p>
    </div>
  </div>
</footer>

<style>
  .footer { background:var(--warm-100); color:var(--text-body); overflow:hidden; }

  .footer__top {
    display:grid; grid-template-columns:2fr 1fr 1fr 1fr;
    gap:var(--s6); padding:var(--s7) 0 var(--s6);
    border-bottom:1px solid var(--border-light);
  }

  .footer__brand { display:flex; flex-direction:column; gap:var(--s4); }
  .footer__brand p { font-size:13px; color:var(--text-muted); max-width:240px; line-height:1.6; }

  .footer__social { display:flex; gap:var(--s2); margin-top:var(--s2); }
  .soc {
    width:36px; height:36px; border-radius:0;
    background:rgba(28,33,20,.05); color:var(--avo-800);
    display:flex; align-items:center; justify-content:center;
    text-decoration:none; transition:var(--t-fast);
    border:1px solid var(--border-light);
  }
  .soc:hover { background:var(--seal); color:#fff; border-color:var(--seal); transform:translateY(-2px); }

  .footer__col h5 {
    font-family:var(--font-mono); font-size:10px; font-weight:500;
    letter-spacing:0.12em; text-transform:uppercase;
    color:var(--avo-900); margin-bottom:var(--s4);
    display:flex; align-items:center; gap:var(--s2);
  }
  .footer__col h5::after { content:''; flex:1; height:1px; background:rgba(190,58,46,.35); }
  .footer__col ul { list-style:none; display:flex; flex-direction:column; gap:var(--s3); }
  .footer__col a { font-size:13px; color:var(--text-body); text-decoration:none; transition:color var(--t-fast); }
  .footer__col a:hover { color:var(--seal); }

  .footer__entity {
    font-family:var(--font-mono); font-size:10.5px; line-height:1.6;
    letter-spacing:0.03em; color:var(--text-faint); max-width:260px;
  }

  .footer__contact {
    margin-top:var(--s4); padding-top:var(--s3);
    border-top:1px solid rgba(190,58,46,.25);
    display:flex; flex-direction:column; gap:5px;
  }
  .footer__contact a { color:var(--seal); font-family:var(--font-mono); font-size:13px; letter-spacing:0.02em; }
  .footer__contact .footer__extra { color:var(--text-muted); font-family:var(--font-mono); font-size:13px; letter-spacing:0.02em; }

  .footer__bar { padding:var(--s4) 0; border-top:1px solid var(--border-light); }
  .footer__bar-inner { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--s2); }
  .footer__bar p { font-size:12px; color:var(--text-muted); font-family:var(--font-mono); letter-spacing:0.04em; }
  .footer__made { font-style:normal; text-transform:uppercase; }

  @media(max-width:900px) {
    .footer__top { grid-template-columns:1fr 1fr; gap:var(--s7); }
    .footer__brand { grid-column:1/-1; }
  }
  @media(max-width:540px) {
    .footer__top { grid-template-columns:1fr; }
    .footer__bar-inner { flex-direction:column; text-align:center; }
  }
</style>
