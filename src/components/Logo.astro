---
/**
 * CrossPals logo — real artwork.
 *  · layout="horizontal" → /img/logo-horizontal.png (509×208) — header / nav bar
 *  · layout="stacked"    → /img/logo-stacked.png    (954×826) — footer brand block
 *  · variant="light"     → 米白剪影版，仅用于深色底（header / drawer）
 * Sizing is height-driven: the image keeps its own aspect ratio (`width:auto`).
 */
interface Props {
  layout?: 'horizontal' | 'stacked';
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'light';
  href?: string;
}
const { layout = 'horizontal', size = 'md', variant = 'default', href = '/' } = Astro.props;

const isStacked = layout === 'stacked';
const light = variant === 'light' ? '-light' : '';
const src = isStacked ? `/img/logo-stacked${light}.png` : `/img/logo-horizontal${light}.png`;
const nat = isStacked ? { w: 954, h: 826 } : { w: 509, h: 208 };
const heights = isStacked
  ? { sm: 68, md: 88, lg: 112 }
  : { sm: 30, md: 48, lg: 56 };
const h = heights[size];
---
<a href={href} class:list={['logo', `logo--${layout}`]} aria-label="CrossPals — Home">
  <img
    src={src}
    alt="CrossPals"
    width={nat.w}
    height={nat.h}
    decoding="async"
    style={`--logo-h:${h}px;`}
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    transition: opacity .2s var(--ease-in-out);
  }
  .logo:hover { opacity: .82; }
  .logo img {
    height: var(--logo-h);
    width: auto;
    display: block;
  }
</style>
