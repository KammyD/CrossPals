      },
      {
        "code": "settings-missing-navigation",
        "message": "未声明导航菜单文件"
      },
      {
        "code": "settings-missing-seo",
        "message": "未声明 SEO 设置文件"
      },
      {
        "code": "schema-duplicated",
        "message": "zod 与 site.config.json 里的 schema 重复定义"
      },
      {
        "code": "hardcoded-contact",
        "message": "hello@crosspals.com 在 ContactForm.astro 与 404.astro 各写一遍，未引用 site.ts"
      }
    ]
  }
}
