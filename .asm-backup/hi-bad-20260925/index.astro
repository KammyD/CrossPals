---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImgPlaceholder from '../../components/ImgPlaceholder.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { PHONE } from '../../config/site';
import { getCollection } from 'astro:content';
import { defaultLang, entriesForLang, baseSlug, contentLink } from '../../i18n/utils';

/* 本页语言 —— 由 CMS 脚手架写入（源页是 defaultLang）。取数/链接/日期全读它。 */
const PAGE_LANG = 'hi';

/* ── 服务（每项带一条独立定价说明） ── */
const services: Array<{ icon: IconName; n: string; title: string; body: string; price: string; seed: number; hint: string; delay: number; featured?: boolean }> = [
  { icon: 'sourcing',    n: '01', title: 'उत्पाद खोज',     body: 'हम हजारों चीनी आपूर्तिकर्ताओं — 1688, Alibaba और सीधे कारखानों के नेटवर्क — को आपके बजट और मानकों के अनुरूप सही मिलान ढूंढने के लिए खंगालते हैं।', price: '<b>$1,000</b> ऑर्डर → <b>$80</b> खोज शुल्क (8%)। हम यूनिट कीमत कम करते हैं और उसमें कोई अतिरिक्त चार्ज नहीं जोड़ते।', seed: 10, hint: '义乌商品城/供应商展会场景', delay: 0 },
  { icon: 'inspection',  n: '02', title: 'गुणवत्ता जांच',   body: 'माल के जहाज पर चढ़ने से पहले कारखाने में भौतिक जांच। विस्तृत फोटो रिपोर्ट, दोषों की गिनती और स्पष्ट पास/फेल जिससे आप अंधाधुंध शिपिंग से बचें।', price: '<b>$1,000</b> ऑर्डर → <b>$150</b> स्थिर जांच शुल्क (आधा दिन)। पूरी फोटो रिपोर्ट शामिल।', seed: 20, hint: '质检员工作照/工厂内部', delay: 1, featured: true },
  { icon: 'payment',     n: '03', title: 'खरीदारी और भुगतान', body: 'हम चीनी में बातचीत करते हैं और सत्यापित आपूर्तिकर्ताओं को सभी भुगतान संभालते हैं। आपका पैसा हर कदम पर सुरक्षित — अजनबियों को कोई वायर ट्रांसफर नहीं।', price: '<b>$1,000</b> ऑर्डर → 30% अग्रिम / QC के बाद 70%। <b>5–8%</b> हैंडलिंग, कोई छिपे हुए मार्कअप नहीं।', seed: 30, hint: '签约/握手/合同场景', delay: 2 },
  { icon: 'shipping',    n: '04', title: 'शिपिंग और लॉजिस्टिक्स', body: 'दुनिया भर में डोर-टू-डोर। हम हवाई, समुद्री और एक्सप्रेस विकल्पों की तुलना करते हैं, फिर कस्टम दस्तावेज़ संभालते हैं और आपको रीयल-टाइम ट्रैकिंग देते हैं।', price: '<b>$1,000</b> ऑर्डर → वाहक के लाइव कोट पर माल भाड़ा। <b>$0</b> अतिरिक्त।', seed: 40, hint: '集装箱港口/货运飞机', delay: 3 },
];

/* ── 三个真实 FBA 卖家场景（Facebook 群组每天都在发的帖） ── */
const scenarios: Array<{ quote: string; tag: string; title: string; body: string; cta: string }> = [
  { quote: 'मैंने 500 यूनिट ऑर्डर किए थे और 30% दोषपूर्ण मिले।', tag: 'शिपिंग से पहले जांचा गया', title: 'गुणवत्ता जांच',
    body: 'हम पूरी खेप को कारखाने में जांचते हैं — मापन, परीक्षण और कैमरे पर दोषों की गिनती। यदि पास दर कम है, तो आपूर्तिकर्ता चीन से एक भी बॉक्स निकलने से पहले पुनर्निर्माण या प्रतिस्थापन करता है।',
    cta: 'देखें जांच कैसे काम करती है' },
  { quote: 'मैंने भुगतान किया और मेरा आपूर्तिकर्ता गायब हो गया।', tag: 'भुगतान से पहले सत्यापित', title: 'आपूर्तिकर्ता सत्यापन',
    body: 'हम कभी भी किसी ऐसे आपूर्तिकर्ता को पैसे नहीं भेजते जिसे हमने सत्यापित नहीं किया हो। व्यवसाय लाइसेंस, फैक्ट्री पता, निर्यात इतिहास, और लाइव वीडियो वॉकथ्रू - जमा राशि जारी करने से पहले जांचा जाता है, बाद में नहीं।',
    cta: 'देखें कि हम आपूर्तिकर्ताओं की जांच कैसे करते हैं' },
  { quote: 'मुझे नहीं पता कि मेरा उत्पाद FBA आवश्यकताओं को पूरा करता है या नहीं।', tag: 'FBA के लिए तैयार होने के बाद ही भेजा जाता है', title: 'FBA तैयारी',
    body: 'हम अमेज़ॅन के सटीक विनिर्देशों के अनुसार लेबल लगाते हैं, पॉली-बैग में रखते हैं, बंडल करते हैं, वजन और माप लेते हैं - फिर आपको कार्टन लेबल और पैकिंग सूची प्रदान करते हैं जो पहली बार में ही स्वीकृत हो जाती है।',
    cta: 'FBA तैयारी देखें' },
];

/* ── 独立质检模块：5 项质检标准 ── */
const inspectionStandards: Array<{ n: string; title: string; body: string }> = [
  { n: '01', title: 'उपस्थिति',      body: 'सतह, रंग, प्रिंट और फिनिश आपके स्वीकृत नमूने के अनुसार जांचे जाते हैं।' },
  { n: '02', title: 'आयाम',      body: 'लंबाई, चौड़ाई, वजन और सहनशीलता कैलीपर्स और स्केल से मापी जाती है।' },
  { n: '03', title: 'कार्य परीक्षण',   body: 'हर नमूना यूनिट को चालू किया जाता है, असेंबल किया जाता है या आपके ग्राहक द्वारा उपयोग किए जाने वाले तरीके से जांचा जाता है।' },
  { n: '04', title: 'पैकेजिंग',       body: 'रिटेल बॉक्स, इन्सर्ट्स और पॉली-बैग की अखंडता - साथ ही ट्रांजिट-ड्रॉप के लिए तैयारी।' },
  { n: '05', title: 'FBA लेबल जांच', body: 'FNSKU, कार्टन लेबल, दम घुटने की चेतावनी, और अमेज़ॅन बारकोड स्कैनेबिलिटी।' },
];

const steps: Array<{ day: string; title: string; body: string }> = [
  { day: 'दिन 1',    title: 'अपना उत्पाद जमा करें',      body: 'हमारे सरल फॉर्म के माध्यम से हमें उत्पाद, मात्रा, गुणवत्ता मानक और बजट बताएं।' },
  { day: 'दिन 2',    title: 'सत्यापित आपूर्तिकर्ता विकल्प',  body: '48 घंटों के भीतर आपके इनबॉक्स में 3-5 सत्यापित आपूर्तिकर्ता, मूल्य और प्रोफाइल के साथ।' },
  { day: 'दिन 7-20', title: 'हम खरीदते हैं और निरीक्षण करते हैं',         body: 'हम आपूर्तिकर्ता को भुगतान करते हैं, उत्पादन की निगरानी करते हैं, और शिपिंग से पहले एक पूर्ण QC फोटो रिपोर्ट भेजते हैं।' },
  { day: 'दिन 21+',  title: 'FBA-तैयार, वितरित',     body: 'माल चीन से Amazon विनिर्देश के अनुसार लेबल और पैक किया गया, सीमा शुल्क निपटाया गया, ट्रैकिंग के साथ छोड़ता है।' },
];

/* ── 证言：FBA 卖家格式（品类 / 订单 / 问题 / 结果） ── */
const testiFeatured = {
  quote: 'मैं Amazon US पर रसोई गैजेट्स बेचता हूँ। CrossPals ने मेरे मुख्य उत्पाद की सोर्सिंग की, शिपिंग से पहले 15 दोषपूर्ण इकाइयों को पकड़ा, और 18 दिनों में सब कुछ FBA-तैयार कर दिया। तब से दोबारा ऑर्डर किया है।',
  name: 'मार्कस टी.', meta: 'Amazon विक्रेता · संयुक्त राज्य अमेरिका · रसोई और भोजन',
  result: 'शिपिंग पूर्व 15 दोष पकड़े गए · 18 दिनों में FBA-तैयार', avatar: '/img/avatar-nigeria.webp',
};
const testiSmall = [
  { quote: 'पहला निजी-लेबल ऑर्डर - पालतू आपूर्ति की 800 इकाइयाँ। उन्होंने फैक्ट्री को सत्यापित किया, पैकेजिंग समस्या को पकड़ा, और यह बिना किसी अस्वीकृति के FBA पर पहुँच गया।',
    name: 'एना आर.', meta: 'Amazon FBA · स्पेन · पालतू आपूर्ति', result: '0 FBA अस्वीकृतियाँ', avatar: '/img/avatar-mexico.webp' },
  { quote: 'मेरे पिछले आपूर्तिकर्ता ने जमा राशि के बाद मुझे छोड़ दिया। CrossPals ने एक नए की जाँच की, स्वयं QC चलाया, और मैंने फिर कभी किसी अजनबी को पैसा नहीं भेजा।',
    name: 'डेविड ओ.', meta: 'Amazon & Shopify · यूनाइटेड किंगडम · घर और उद्यान', result: '2 पुनः ऑर्डर', avatar: '/img/avatar-uk.webp' },
];

const whyItems: Array<{ icon: IconName; n: string; title: string; body: string }> = [
  { icon: 'global',       n: '01', title: 'कोई भाषा की बाधा नहीं',  body: 'हम सीधे चीनी भाषा में वार्ता करते हैं — आपको फैक्ट्री कीमतें मिलती हैं, पर्यटक कीमतें नहीं।' },
  { icon: 'trust',        n: '02', title: 'वास्तविक जवाबदेही',   body: 'एक समर्पित एजेंट आपके ऑर्डर का प्रबंधन करता है। आपको एक व्यक्ति मिलता है, टिकट कतार नहीं।' },
  { icon: 'handshake',    n: '03', title: 'FBA विक्रेताओं के लिए बनाया गया', body: 'हम जो कुछ भी करते हैं वह अमेज़ॅन-तैयार कार्टन में समाप्त होता है: सोर्सिंग, निरीक्षण, लेबलिंग, पैकिंग।' },
  { icon: 'transparent',  n: '04', title: 'पारदर्शी लागत',     body: 'सप्लायर कीमत + मालभाड़ा + हमारी फीस। प्रतिबद्ध होने से पहले आप हर नंबर देखते हैं।' },
];

/* 首页只给承诺（结果），不说过程；过程全部放到 Services 页的展开模块 */
const guarantees: Array<{ icon: IconName; title: string; body: string }> = [
  { icon: 'trust',      title: 'केवल सत्यापित आपूर्तिकर्ता', body: 'आप एक सेंट भुगतान करने से पहले हम हर आपूर्तिकर्ता की जांच करते हैं।' },
  { icon: 'inspection', title: 'शिपिंग से पहले QC',      body: 'फोटो रिपोर्ट + पास/फेल इससे पहले कि आपका पैसा ट्रांसफर हो।' },
  { icon: 'payment',    title: 'भुगतान सुरक्षा',      body: 'हम धनराशि तब तक रोकते हैं जब तक माइलस्टोन्स क्लीयर ना हो जाएँ। अजनबियों को वायर नहीं।' },
  { icon: 'shipping',   title: 'DDP दरवाजा वितरण',       body: 'ट्रैकिंग और सामान — कागजी कार्यवाही नहीं।' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'एजेंट फीस',     value: 'ऑर्डर मूल्य का 5–8%', note: '$10,000 ऑर्डर = $600 एजेंट फीस' },
  { label: 'निरीक्षण',    value: '$150 / दिन',          note: 'अधिकांश ऑर्डर आधे दिन में पूरे हो जाते हैं' },
  { label: 'एफबीए प्रीप',      value: 'प्रति यूनिट',            note: 'आपके कोटेशन पर आइटमाइज्ड लाइन-बाई-लाइन' },
  { label: 'माल ढुलाई',       value: 'कैरियर कोटेशन पर',    note: 'कैरियर कीमत के ऊपर कुछ भी नहीं जोड़ा गया' },
];

/* Resources：自动取最新 3 篇文章（来自 src/content/blog/*.md —— 加文章即自动出现在首页） */
const blogPosts = entriesForLang((await getCollection('blog')).filter(p => !p.data.draft), PAGE_LANG)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map(p => ({ slug: p.slug, cat: p.data.category, title: p.data.title, time: p.data.readTime, cover: p.data.cover }));

const svcImg: Record<number,string> = {10:'sourcing-1688',20:'inspection',30:'payment',40:'shipping'};
const guarImg: Record<string,string> = {trust:'factory',inspection:'inspection',payment:'payment',shipping:'shipping'};
const tickerItems = ['एफबीए प्रीप', 'प्री-शिपमेंट क्यूसी', '1688 सोर्सिंग', 'आपूर्तिकर्ता सत्यापन', 'डीडीपी शिपिंग', 'प्राइवेट लेबल', 'उत्पाद फोटोग्राफी', 'अमेज़न एफबीए', 'हेबेई · बाओडिंग → विश्व', 'क्यूसी ���ोटो रिपोर्ट्स', 'कोई छुपे हुए शुल्क नहीं'];
const categories = ['किचन और डाइनिंग', 'होम और गार्डन', 'पालतू जानवरों का सामान', 'खिलौने और गेम्स', 'स्पोर्ट्स और आउटडोर', 'ब्यूटी और पर्सनल केयर', 'इलेक्ट्रॉनिक्स एक्सेसरीज', 'ऑफिस प्रोडक्ट्स'];
---
<BaseLayout
  title="अमेज़ॅन विक्रेताओं द्वारा विश्वसनीय सोर्सिंग पार्टनर"
  description="क्रॉसपाल्स FBA के लिए उत्पादों की सोर्सिंग, जांच और तैयारी करता है - आपूर्तिकर्ता सत्यापन, शिपमेंट पूर्व गुणवत्ता नियंत्रण और FBA तैयारी, ताकि आप आपूर्तिकर्ताओं की बजाय बिक्री पर ध्यान दे सकें।"
 lang="hi">

<!-- ═══ 顶部深色带：公告条 + 刊头信息行 ═══ -->
<div class="topband">
  <a href="/hi/contact" class="announce announce--dark">
    <span class="announce__dot" aria-hidden="true"></span>
    <span><strong>नया:</strong>पहली बार आयात करने वालों के लिए मुफ्त सोर्सिंग परामर्श — 48 घंटे में आपूर्तिकर्ता शॉर्टलिस्ट</span>
    <span class="announce__arrow" aria-hidden="true">→</span>
  </a>

  <div class="masthead">
    <div class="container masthead__inner">
      <span>CrossPals · चीन सोर्सिंग मैनुअल</span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span>अंक Nº01 — MMXXVI</span>
    </div>
  </div>
</div>

<!-- ═══ HERO — 面向 Amazon 卖家 ═══ -->
<section class="hero grain" style="position:relative;overflow:hidden;">
  <div class="hero__grid">
    <div class="hero__left">
      <div class="hero__left-inner">
        <p class="overline overline--light">FBA विक्रेताओं के लिए चीन से सोर्सिंग</p>
        <h1 class="hero__title">Amazon विक्रेताओं का विश्वसनीय सोर्सिंग पार्टनर — <em>गुणवत्ता जांच शामिल</em></h1>
        <p class="hero__lead">हम FBA के लिए आपके उत्पादों को सोर्स, जांच और तैयार करते हैं — ताकि आप आपूर्तिकर्ताओं की बजाय बिक्री पर ध्यान दे सकें</p>

        <p class="hero__sidenote">चित्र. 00 — अधिकांश FBA विक्रेता भाषा अंतर, नकली आपूर्तिकर्ताओं और अंधे शिपमेंट से पैसा खो देते हैं। हम तीनों को समाप्त कर देते हैं</p>

        <div class="hero__actions">
          <a href="/hi/contact" class="btn btn-primary">
            मुफ्त कोटेशन प्राप्त करें
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
          <a href="/hi/services" class="btn btn-ghost">यह कैसे काम करता है देखें</a>
        </div>

        <ul class="hero__index">
          <li><span>01</span> Source</li>
          <li><span>02</span> Inspect</li>
          <li><span>03</span> FBA के लिए तैयार करें</li>
          <li><span>04</span> Deliver</li>
        </ul>
