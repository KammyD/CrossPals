    problem: '1688 पर सबसे कम कीमतें हैं - लेकिन साइट केवल चीनी में है और विदेशों में शिप नहीं करेगी।',
    process: 'एक उत्पाद लिंक या फोटो भेजें। हम 1688 विक्रेता से खरीदते हैं, जांचते हैं, समेकित करते हैं और आपको भेजते हैं।',
    pricing: 'ऑर्डर मूल्य का एक छोटा न्यूनतम साथ एक प्रतिशत। चीनी की आवश्यकता नहीं।' },
  { icon: 'shipping', title: 'वेयरहाउसिंग और ट्रांसशिपमेंट', seed: 74,
    problem: 'कई आपूर्तिकर्ताओं से खरीदारी का अर्थ है कई अंतरराष्ट्रीय माल भाड़ा बिल — और कोई भी सामान की जांच नहीं कर रहा है।',
    process: 'हम प्राप्त करते हैं, जांचते हैं, दोबारा पैक करते हैं और अपने गोदाम से एकल शिपमेंट में कई ऑर्डर समेकित करते हैं।',
    pricing: 'प्रति घन मीटर प्रतिदिन भंडारण, प्रति ऑर्डर एक समेकन शुल्क के साथ।' },
