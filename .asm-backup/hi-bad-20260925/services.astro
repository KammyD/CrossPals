  { n: '04', title: 'FBA प्रीप',            body: 'FNSKU लेबलिंग, पॉलीबैगिंग, बंडलिंग, वजन और माप Amazon के सटीक विनिर्देशों के अनुसार।' },
  { n: '05', title: 'माल ढुलाई समन्वय', body: 'वायु, समुद्र या एक्सप्रेस की तुलना; सीमा शुल्क कागजात संभाला; लाइव ट्रैकिंग के साथ दरवाजा-से-दरवाजा DDP।' },
];

/* ── 附加服务：单独可选 ── */
