    img: '/img/payment-escrow.webp', alt: 'सीलबंद कार्टन के विरुद्ध धनराशि तब तक रोकी जाती है जब तक प्रत्येक माइलस्टोन पूरा नहीं हो जाता',
    steps: [
      { t: 'PO माइलस्टोन के साथ लिखा गया', time: 'दिन 1', d: 'कुछ भी शुरू होने से पहले जमा राशि, उत्पादन, निरीक्षण और शिपमेंट को अलग-अलग रिलीज पॉइंट्स के रूप में तय किया जाता है।' },
      { t: 'जमा राशि जारी', time: 'दिन 1–2', d: 'केवल सहमत जमा राशि निकलती है, और तब जब आप PO को लिखित रूप में मंजूरी देते हैं।' },
      { t: 'निरीक्षण गेट', time: 'QC पर', d: 'उत्पादन शेष राशि तब तक जारी नहीं होती जब तक निरीक्षण रिपोर्ट पास के रूप में वापस नहीं आ जाती।' },
      { t: 'अंतिम निपटान', time: 'आपके साइन-ऑफ पर', d: 'शेष राशि आपकी मंजूरी के बाद निपटती है, आपके इनवॉइस पर लिखित रसीद के साथ।' },
    ],
    checksLabel: 'आपके पैसे कैसे रखे जाते हैं',
    checks: [
      { k: 'आप हर रिलीज को मंजूरी देते हैं', v: 'उस माइलस्टोन पर आपकी लिखित अनुमति के बिना कोई भुगतान नहीं होता।' },
      { k: 'हमारे द्वारा आपूर्तिकर्ता को भुगतान', v: 'हम फैक्ट्री को सीधे भुगतान करते हैं — आप कभी भी किसी अज्ञात खाते में पैसे नहीं भेजते।' },
      { k: 'कोई व्यक्तिगत खाते नहीं', v: 'धन कभी भी किसी व्यक्तिगत बैंक खाते या तीसरे पक्ष के वॉलेट में नहीं जाता।' },
      { k: 'कोई पूर्ण प्रीपेमेंट नहीं', v: 'कोई भी 100% अग्रिम भुगतान नहीं प्राप्त करता — न ��पूर्तिकर्ता, न हम।' },
      { k: 'हर ट्रांसफर पर रसीद', v: 'हर रिलीज़ को आपके ऑर्डर के मुताबिक दस्तावेज़ और आइटमाइज़ किया जाता है।' },
    ],
    fail: 'अगर कोई माइलस्टोन क्लियर नहीं होता, तो हम ऑर्डर रोक देते हैं और पैसा आपके पास ही रहता है — जो काम नहीं हुआ, उसके लिए किसी को भुगतान नहीं होता।',
  },
  {
    icon: 'shipping', n: '04', title: 'डीडीपी दरवाज़ा डिलीवरी',
    promise: 'ट्रैकिंग और माल — कागज़ी कार्रवाई नहीं।',
    img: '/img/g-packing.webp', alt: 'डिब्बे सील किए गए, लेबल लगे और दरवाज़ा डिलीवरी के लिए तैयार',
    steps: [
      { t: 'बुक और कंसोलिडेट करें', time: 'दिन 1–2', d: 'हम कैरियर चुनते हैं, जगह बुक करते हैं और आपके डिब्बों को एक ही शिपमेंट में कंसोलिडेट करते हैं।' },
      { t: 'एक्सपोर्ट और दस्तावेज़', time: '2–3 दिन', d: 'एक्सपोर्ट डिक्लेरेशन, पैकिंग लिस्ट और कमर्शियल इनवॉइस — हमारी तरफ से तैयार और फाइल किया जाता है।' },
      { t: 'फ्रेट और इम्पोर्ट', time: 'एयर 5–8 दिन · सी 25–35 दिन', d: 'एयर या समुद्री माल परिवहन, डीडीपी के तहत ड्यूटी और कस्टम क्लीयर होता है ताकि आप पर कोई बोझ न पड़े।' },
      { t: 'दरवाज़ा डिलीवरी', time: '1–3 दिन', d: 'आपके पते तक आखिरी मील या सीधे Amazon तक, एंड-टू-एंड ट्रैक किया गया।' },
    ],
    checksLabel: 'क्या शामिल है',
    checks: [
      { k: 'दरवाज़े-से-दरवाज़ा डीडीपी', v: 'एक मूल्य फैक्टरी गेट से आपके दरवाज़े तक — कोई अप्रत्याशित कस्टम्स चालान नहीं।' },
      { k: 'शुल्क और कर', v: 'कोटेशन में शामिल, अलग-अलग वस्तुवार दिखाया गया ताकि आप देख सकें।' },
      { k: 'लाइव ट्रैकिंग', v: 'एक ट्रैकिंग नंबर जो प्रस्थान से डिलीवरी तक काम करता है।' },
      { k: 'पैकिंग सूची और चालान', v: 'वह कागजी कार्यवाही जो Amazon और आपका फॉरवर्डर मांगेगा।' },
      { k: 'FBA या आपका पता', v: 'Amazon वेयरहाउस या आप तक डिलीवरी — बुकिंग के समय आपकी पसंद।' },
    ],
    fail: 'अगर कोई शिपमेंट देरी से पहुँचे, रोक दिया जाए, या खो जाए, तो हम कैरियर का पीछा करते हैं और दावा दर्ज करते हैं। कागजी कार्यवाही को लड़ने की जिम्मेदारी हमारी है, आपकी नहीं।',
  },
];
---
<BaseLayout title="Services" description="FBA सोर्सिंग और निरीक्षण - आपूर्तिकर्ता खोज, नमूना पुष्टि, पूरी खेप का निरीक्षण, FBA तैयारी, और माल ढुलाई समन्वय, साथ ही प्राइवेट लेबल, फोटोग्राफी, 1688 और वेयरहाउसिंग ऐड-ऑन। पारदर्शी मूल्य निर्धारण।" ogImage="/img/case-relabel.webp" lang="hi">

  <PageHero
    overline="हम क्या करते हैं"
    title="FBA सोर्सिंग<br/><em style='font-style:italic;color:var(--avo-300)'>&amp; निरीक्षण</em>"
    subtitle="एक पैकेज - आपूर्तिकर्ता खोज से लेकर Amazon-तैयार कार्टन तक। आवश्यकतानुसार प्राइवेट लेबल, फोटोग्राफी, 1688 खरीदारी, या वेयरहाउसिंग जोड़ें।"
  />

  <!-- ═══ 核心服务包 ═══ -->
  <section class="section">
    <div class="container">
      <div class="core reveal">
        <div class="core__aside">
          <span class="tag tag-seal">कोर पैकेज</span>
          <h2>FBA सोर्सिंग<br/><em>और निरीक्षण</em></h2>
          <p class="core__lead">वह सिंगल पैकेज जिसकी हम हर FBA विक्रेता को सलाह देते हैं। "मैं यह बेचना चाहता हूँ" से लेबल लगा, निरीक्षित, Amazon-तैयार कार्टन तक का सफर — एक एजेंट द्वारा संभाला जाता है।</p>
          <div class="core__price">
            <span class="core__price-label">इसकी कीमत कैसे तय होती है</span>
            <p>एजेंट फीस 5–8% · निरीक्षण $150/दिन · FBA प्रीप प्रति यूनिट — सभी एक कोटेशन पर अलग-अलग दिखाए गए।</p>
          </div>
          <a href="/hi/contact" class="btn btn-primary">
            मुफ़्त कोटेशन प्राप्त करें
            <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
          </a>
        </div>

        <ol class="core__list">
          {coreIncludes.map((c, i) => (
            <li class:list={['core-step reveal', `reveal-delay-${i}`]}>
              <span class="core-step__n">{c.n}</span>
              <div>
                <h4>{c.title}</h4>
                <p>{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- $1,000 订单说明 -->
      <div class="price-example price-example--inline reveal">
        <p class="price-example__title">कार्य उदाहरण — $1,000 का ऑर्डर</p>
        <div class="price-example__rows">
          <div class="price-example__row"><span>सप्लायर कीमत (माल)</span><span>$1,000</span></div>
          <div class="price-example__row"><span>एजेंट फीस (8%)</span><span>$80</span></div>
          <div class="price-example__row"><span>Freight</span><span>वास्तविक कोट पर</span></div>
          <div class="price-example__row price-example__row--total"><span>आपकी कुल लागत</span><span>कोई छिपे हुए शुल्क नहीं</span></div>
        </div>
        <p class="price-example__foot">आपूर्तिकर्ता मूल्य + एजेंट शुल्क + माल भाड़ा = आप जो कुछ भी भुगतान करते हैं। और कुछ नहीं।</p>
      </div>
    </div>
  </section>

  <!-- ═══ 附加服务 ═══ -->
  <section class="section bg-parchment">
    <div class="container">
      <div class="add-head reveal">
        <p class="overline">अतिरिक्त सेवाएं</p>
        <h2>वैकल्पिक ऐड-ऑन<br/><em>जब आपको उनकी आवश्यकता हो</em></h2>
        <p class="add-lead">प्रत्येक ऐड-ऑन एक विशिष्ट समस्या का समाधान करता है। उन्हें à la carte लें, या उन्हें अपने मुख्य पैकेज में बंडल करें।</p>
      </div>

      <div class="addons">
        {addOns.map((a, i) => (
          <article class:list={['addon reveal', `reveal-delay-${i}`]}>
            <div class="addon__media">
              <ImgPlaceholder src={'/img/'+svcImg[a.seed]+'.webp'} seed={a.seed} width={520} height={390} ratio="4/3" alt={a.title} />
            </div>
            <div class="addon__body">
              <span class="addon__icon"><Icon name={a.icon} size={24} color="var(--seal)" /></span>
              <h3>{a.title}</h3>
              <dl class="addon__rows">
                <div><dt>यह किस समस्या का समाधान करता है</dt><dd>{a.problem}</dd></div>
                <div><dt>हम क्या करते हैं</dt><dd>{a.process}</dd></div>
                <div><dt>इसकी कीमत कैसे तय की जाती है</dt><dd>{a.pricing}</dd></div>
              </dl>
              <a href="/hi/contact" class="addon__link">इसके बारे में पूछें<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Process — ledger 时间线 ═══ -->
  <section class="section">
    <div class="container">
      <div class="tl-head reveal">
        <p class="overline">हमारी प्रक्रिया</p>
        <h2>एक विशिष्ट आदेश कैसा होता है<br/><em>Flows</em></h2>
      </div>
      <ol class="ledger-list">
        {steps.map((step, i) => (
          <li class:list={['ledger-item reveal', `reveal-delay-${Math.min(i, 3)}`]}>
            <span class="ledger-item__day">{step.day}</span>
            <span class="ledger-item__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="ledger-item__body">
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 独立定价区块 ═══ -->
  <section class="section bg-parchment">
    <div class="container pricing__wrap">
      <div class="pricing__intro reveal">
        <p class="overline">पारदर्शी मूल्य निर्धारण</p>
        <h2>"हमसे संपर्क करें" नहीं<br/><em>मूल्य निर्धारण के लिए</em></h2>
        <p class="pricing__lead">हर आदेश का एक डॉलर प्रतिबद्ध करने से पहले लाइन दर लाइन उद्धृत किया जाता है। यहां शुल्क संरचना खुले तौर पर दी गई है।</p>
      </div>

      <div class="pricing__right">
        <ul class="pricetable reveal reveal-delay-1">
          {pricingFees.map(f => (
            <li>
              <span class="pricetable__label">{f.label}</span>
              <span class="pricetable__value">{f.value}</span>
              <span class="pricetable__note">{f.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ Our Guarantees, in full —— 四个承诺各自展开（流程 / 标准 / 失败兜底） ═══ -->
  <section class="section--tight" id="guarantees">
    <div class="container">
      <div class="guar-head reveal">
        <p class="overline">हमारी गारंटी, पूर्ण रूप से</p>
        <h2>प्रत्येक वादा क्या है<br/><em>वास्तव में इसका मतलब है</em></h2>
        <p class="guar-lead">वादा होमपेज पर है। यहां इसके पीछे की मशीनरी है - कितने चरण, प्रत्येक में कितना समय लगता है, हमारे मानक क्या हैं, और गलत होने पर क्या होता है।</p>
      </div>

      <div class="gmods">
        {guaranteeModules.map((m, i) => (
          <article class:list={['gmod reveal', i % 2 === 1 && 'gmod--flip']}>
            <div class="gmod__media">
              <ImgPlaceholder class="gmod__img" src={m.img} seed={700 + i} width={640} height={800} ratio="4/5" alt={m.alt} />
              <span class="gmod__n">{m.n}</span>
            </div>

            <div class="gmod__body">
              <span class="gmod__icon"><Icon name={m.icon} size={24} color="var(--seal)" /></span>
              <h3>{m.title}</h3>
              <p class="gmod__promise">{m.promise}</p>

              <div class="gmod__cols">
                <div class="gmod__col">
                  <h4 class="gmod__label">यह कैसे काम करता है</h4>
                  <ol class="gmod__steps">
                    {m.steps.map((s, j) => (
                      <li>
                        <span class="gmod__step-n">{String(j + 1).padStart(2, '0')}</span>
                        <div>
                          <span class="gmod__step-t">{s.t}</span>
                          <span class="gmod__step-time">{s.time}</span>
                          <p>{s.d}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="gmod__col">
                  <h4 class="gmod__label">{m.checksLabel}</h4>
                  <ul class="gmod__checks">
                    {m.checks.map(c => (
                      <li>
                        <span class="gmod__check-k">{c.k}</span>
                        <span class="gmod__check-v">{c.v}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <p class="gmod__fail"><span class="gmod__fail-tag">अगर यह विफल हो जाता है</span>{m.fail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="faq-head reveal">
        <p class="overline">FAQ</p>
        <h2>Common<br/><em>Questions</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class:list={['faq-item reveal', `reveal-delay-${i % 3}`]}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section grain" style="background:var(--avo-950);position:relative;text-align:center;">
    <div class="container">
      <span class="seal cta-seal" aria-hidden="true"><span>Start</span><span>Now</span></span>
      <p class="overline overline--light reveal">शुरू करें</p>
      <h2 style="color:#fff;margin-bottom:var(--s4);" class="reveal reveal-delay-1">
        ऑर्डर देने के लिए तैयार<br/><em style="color:var(--avo-300)">आपका पहला ऑर्डर?</em>
      </h2>
      <p style="color:rgba(255,255,255,.6);max-width:420px;margin:0 auto var(--s6);" class="reveal reveal-delay-2">
        हमें अपना उत्पाद भेजें और हम 48 घंटों के भीतर पूरी कीमत सहित सत्यापित आपूर्तिकर्ता विकल्प प्रदान करेंगे।
      </p>
      <a href="/hi/contact" class="btn btn-primary reveal reveal-delay-3">
        मुफ्त कोटेशन प्राप्त करें
        <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M8 3l5 5-5 5"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  h2 em { font-style:italic; color:var(--avo-600); }

  /* ── 核心服务包 ── */
  .core{display:grid;grid-template-columns:0.9fr 1.1fr;gap:var(--s7);align-items:start;padding-bottom:var(--s6);border-bottom:1px solid var(--border-light);}
  .core__aside{position:sticky;top:100px;}
  .core__aside h2{font-size:clamp(28px,3.6vw,42px);line-height:1.1;margin:var(--s4) 0;}
  .core__lead{font-size:15.5px;line-height:1.72;color:var(--text-body);max-width:440px;}
  .core__price{margin:var(--s5) 0;padding:var(--s4) var(--s5);background:var(--bg-page);border-left:2px solid var(--seal);}
  .core__price-label{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--seal);}
  .core__price p{font-size:14px;line-height:1.6;color:var(--text-body);margin-top:6px;}
  .core__list{list-style:none;display:flex;flex-direction:column;border-top:1px solid var(--border-mid);}
  .core-step{display:grid;grid-template-columns:56px 1fr;gap:var(--s4);padding:var(--s4) 0;border-bottom:1px solid var(--border-light);}
  .core-step__n{font-family:var(--font-mono);font-size:13px;font-weight:600;letter-spacing:.08em;color:var(--seal);padding-top:3px;}
  .core-step h4{font-size:17px;margin-bottom:5px;}
