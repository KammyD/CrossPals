  { day: 'दिन 2',    title: 'हम आपूर्तिकर्ता विकल्प भेजते हैं',   body: '3–5 सत्यापित आपूर्तिकर्ता उद्धरण और प्रोफाइल के साथ, आपकी समीक्षा के लिए तैयार।' },
  { day: 'दिन 3–5',  title: 'नमूना और बातचीत',       body: 'हम नमूने की पुष्टि करते हैं, चीनी में शर्तों पर सहमत होते हैं, PO जारी करते हैं और जमा राशि को सुरक्षित रूप से जारी करते हैं।' },
  { day: 'दिन 7–20', title: 'उत्पादन और निरीक्षण',    body: 'माल बनाया जाता है। हम पूरी बैच की जांच करते हैं और शिपमेंट से पहले एक QC फोटो रिपोर्ट भेजते हैं।' },
  { day: 'दिन 21+',  title: 'FBA-तैयार, वितरित',       body: 'माल चीन से छोड़ता है अमेज़न स्पेक के अनुसार लेबल्ड और पैक्ड, कस्टम्स क्लियर, लाइव ट्रैकिंग के साथ।' },
];

const pricingFees: Array<{ label: string; value: string; note: string }> = [
  { label: 'एजेंट शुल्क',  value: 'ऑर्डर मूल्य का 5-8%', note: '$10,000 ऑर्डर = $600 एजेंट शुल्क' },
  { label: 'इंस्पेक्शन', value: '$150 / दिन',          note: 'अधिकांश ऑर्डर आधे दिन में पूरे हो जाते हैं' },
  { label: 'एफबीए प्रीप',   value: 'प्रति यूनिट',            note: 'आपके कोट पर आइटमाइज्ड लाइन-बाय-लाइन' },
  { label: 'फ्रेट',    value: 'कैरियर कोट पर',    note: 'कैरियर कीमत के ऊपर कुछ नहीं जोड़ा गया' },
];

const faqs = [
  { q: 'एफबीए सोर्सिंग और इंस्पेक्शन पैकेज में क्या शामिल है?', a: 'सप्लायर सोर्सिंग, सैंपल कन्फर्मेशन, फुल-बैच इंस्पेक्शन, एफबीए प्रीप (लेबलिंग, बैगिंग, वेटिंग, मेजरिंग), और फ्रेट कोऑर्डिनेशन — एक जवाबदेह एजेंट, एक कोट।' },
  { q: 'आपका सर्विस शुल्क कितना है?',                            a: 'एजेंट शुल्क ऑर्डर मूल्य का 5-8% है। इंस्पेक्शन $150/दिन है (अधिकांश ऑर्डर आधे दिन में पूरे होते हैं)। एफबीए प्रीप प्रति यूनिट चार्ज किया जाता है। कमिट करने से पहले आपके कोट पर सब कुछ आइटमाइज्ड होता है।' },
  { q: 'आपका न्यूनतम ऑर्डर साइज क्या है?',                         a: 'कोई सख्त न्यूनतम नहीं, लेकिन हम $300 यूएसडी या अधिक के ऑर्डर के साथ सबसे अच्छा काम करते हैं। छोटे ऑर्डर में सप्लायर विकल्प कम हो सकते हैं।' },
  { q: 'अगर माल इंस्पेक्शन में फेल हो जाए तो क्या होगा?',                           a: 'हम आपूर्तिकर्ता के साथ मिलकर समाधान निकालते हैं — पुनर्निर्माण, प्रतिस्थापन, या धनवापसी — शिपमेंट से पहले। आपकी मंजूरी के बिना हम अंतिम भुगतान कभी नहीं जारी करते।' },
  { q: 'क्या आप FBA प्रीप और लेबलिंग संभालते हैं?',                    a: 'हाँ। FNSKU लेबल्स, पॉली-बैगिंग, बंडलिंग, कार्टन लेबल्स, वज़न और आयाम Amazon के स्पेक के अनुसार — ताकि आपका शिपमेंट पहली बार में ही स्वीकृति पा सके।' },
  { q: 'क्या मुझे अपने लोगो के साथ कस्टम पैकेजिंग मिल सकती है?',                 a: 'हाँ — यह हमारा प्राइवेट लेबल और पैकेजिंग ऐड-ऑन है। बॉक्स, बैग, लेबल्स और हँग टैग। न्यूनतम आर्डर मात्रा आपूर्तिकर्ता के अनुसार अलग-अलग होती है, आमतौर पर 300–1,000 टुकड़े।' },
